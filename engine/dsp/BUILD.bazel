load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "gain",
    hdrs = ["gain.h"],
    srcs = ["gain.cc"],
    deps = ["//graph:audio_buffer"],
)

cc_library(
    name = "pink_noise",
    hdrs = ["pink_noise.h"],
)

cc_library(
    name = "resampler",
    hdrs = ["resampler.h"],
    srcs = ["resampler.cc"],
    deps = [
        "//graph:audio_buffer",
        "@libsamplerate//:samplerate",
    ],
)

cc_library(
    name = "sh_decode",
    hdrs = ["sh_decode.h"],
    srcs = ["sh_decode.cc"],
    deps = [
        # The old fork-wide @oar//:obr_lib glob target is gone with the
        # move to upstream's native Bazel build; obr is its own module
        # now. This public target carries //obr/common (ambisonic_utils.h)
        # transitively.
        "@obr//obr/ambisonic_encoder:associated_legendre_polynomials_generator",
        "@eigen",
    ],
    alwayslink = True,
)

cc_library(
    name = "dsp",
    deps = [
        ":gain",
    ],
)

# FFI-surface files consumed by //test:ffi_exports_lint_test.
exports_files(["sh_decode.h"])
