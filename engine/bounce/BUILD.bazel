load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "element_stream",
    hdrs = ["element_stream.h"],
    srcs = ["element_stream.cc"],
    deps = [
        "//:engine_log",
        "//dsp:resampler",
        "//graph:audio_buffer",
        "//io:wav_reader",
    ],
)

cc_library(
    name = "element_bouncer",
    hdrs = ["element_bouncer.h"],
    srcs = ["element_bouncer.cc"],
    deps = [
        ":element_stream",
        "//:engine_log",
        "//graph:audio_buffer",
        "//io:wav_writer",
        "//wav",
    ],
)
