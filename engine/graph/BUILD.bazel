load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "audio_buffer",
    hdrs = ["audio_buffer.h"],
)

cc_library(
    name = "audio_node",
    hdrs = ["audio_node.h"],
    deps = [":audio_buffer"],
)

# Pure, header-only routing/noise scatter helpers (no OAR dependency) so the
# engine tests can exercise the matrix maths in isolation.
cc_library(
    name = "routing_scatter",
    hdrs = ["routing_scatter.h"],
)

cc_library(
    name = "audio_graph",
    hdrs = ["audio_graph.h"],
    srcs = ["audio_graph.cc"],
    deps = [
        ":audio_buffer",
        ":audio_node",
        ":routing_scatter",
        "//dsp:gain",
        "//dsp:pink_noise",
        "//dsp:resampler",
        "//:engine_log",
        "//iamf:iamf_playback_session",
        "//iamf:iamf_ring_source",
        "//io:wav_stream",
        "//meters:channel_stats",
        "//meters:peak_meter",
        "//meters:rms_meter",
        "//meters:live_loudness_meter",
        "//meters:meter_state",
        "//renderer:channel_order",
        "//renderer:oar_renderer",
    ],
)
