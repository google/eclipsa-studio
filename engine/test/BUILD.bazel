    name = "oar_limiter_delay_test",
    size = "small",
    srcs = ["oar_limiter_delay_test.cc"],
    deps = [
        "//renderer:oar_renderer",
        "@googletest//:gtest_main",
    ],
)

# THD characterization of the limiter through the production render
