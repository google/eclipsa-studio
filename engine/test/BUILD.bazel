# Equivalence canary for the cartesian->polar conversion (ES-567): the one
# deliberate user of cartesian-typed oar metadata in the repo. Pins that
# in-renderer layout-mode conversion == the public helper + polar metadata,
# bit for bit — the drift-killer for oar pin bumps on the conversion path.
cc_test(
    name = "oar_cart_conversion_canary_test",
    size = "small",
    srcs = ["oar_cart_conversion_canary_test.cc"],
    deps = [
        "@googletest//:gtest_main",
        "@oar//:oar",
    ],
)

# Pins OAR's output channel order and speaker geometry (ES-592): renders one
# object at each speaker's nominal angles on every target layout and checks
# it comes out of that speaker's channel alone. The expectations live in
# renderer/oar_output_channels.txt, which the app's Dart pin reads too, so
# an oar bump that reorders a layout fails here rather than silently
# relabelling the meters.
cc_test(
    name = "oar_output_channels_test",
    size = "small",
    srcs = ["oar_output_channels_test.cc"],
    data = ["//renderer:oar_output_channels.txt"],
    deps = [
        "//adm_import/scene:layouts",
        "@googletest//:gtest_main",
        "@oar//:oar",
    ],
)

