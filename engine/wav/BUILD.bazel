    srcs = ["reader_malformed_test.cc"],
    deps = [
        ":fixture",
        ":wav",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "writer_roundtrip_test",
    size = "small",
    srcs = ["writer_roundtrip_test.cc"],
    deps = [
        ":fixture",
        ":wav",
        "@googletest//:gtest_main",
