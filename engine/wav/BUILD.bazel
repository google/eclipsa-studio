load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# In-house WAV library: reader/writer for RIFF/RF64/BW64. Serves the
# engine in place of dr_wav; the io/ WavReader/WavWriter adapters sit on
# top. Self-contained (zero dependencies) and UI/engine-agnostic so it
# can be reused outside the engine.

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "wav",
    srcs = [
        "internal.h",
        "reader.cc",
        "writer.cc",
    ],
    hdrs = [
        "convert.h",
        "reader.h",
        "result.h",
        "types.h",
        "writer.h",
    ],
)

cc_library(
    name = "fixture",
    testonly = True,
    hdrs = ["testing/fixture.h"],
    deps = [":wav"],
)

cc_test(
    name = "convert_test",
    size = "small",
    srcs = ["convert_test.cc"],
    deps = [
        ":wav",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "reader_matrix_test",
    size = "small",
    srcs = ["reader_matrix_test.cc"],
    deps = [
        ":fixture",
        ":wav",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "reader_rt_alloc_test",
    size = "small",
    srcs = ["reader_rt_alloc_test.cc"],
    deps = [
        ":fixture",
        ":wav",
