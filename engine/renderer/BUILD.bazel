load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# The transcription of OAR's own layout table that both //test:
# oar_output_channels_test and app/test/renderer/oar_output_channels_test
# .dart pin against. Exported so the C++ test can carry it as data.
exports_files(["oar_output_channels.txt"])

cc_library(
    name = "oar_renderer",
    hdrs = ["oar_renderer.h"],
    srcs = ["oar_renderer.cc"],
    deps = [
        "//:engine_log",
        "@oar//:oar",
    ],
)

cc_library(
    name = "oar_capability",
    hdrs = ["oar_capability.h"],
    srcs = ["oar_capability.cc"],
    deps = [
        "@oar//:oar",
    ],
)
