load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//:__subpackages__"])

cc_library(
    name = "bw64_reader",
    srcs = ["bw64_reader.cc"],
    hdrs = ["bw64_reader.h"],
    # Public: adm-lab's audit CLI reads BW64 files through this reader.
    visibility = ["//visibility:public"],
    deps = [
        "//wav",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
    ],
)

cc_library(
    name = "wav_writer",
    srcs = ["wav_writer.cc"],
    hdrs = ["wav_writer.h"],
    deps = [
        "//wav",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
    ],
)

cc_library(
    name = "bwf_fixture",
    testonly = True,
    srcs = ["bwf_fixture.cc"],
    hdrs = ["bwf_fixture.h"],
    deps = [
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
    ],
)

cc_test(
    name = "wav_roundtrip_test",
    srcs = ["wav_roundtrip_test.cc"],
    deps = [
        ":bw64_reader",
        ":wav_writer",
        "//wav",
        "@abseil-cpp//absl/status:statusor",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "bw64_reader_test",
    srcs = ["bw64_reader_test.cc"],
    deps = [
        ":bw64_reader",
        "//wav",
        "//wav:fixture",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest_main",
    ],
)
