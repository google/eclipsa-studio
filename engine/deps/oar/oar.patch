+  cartesian_t position;
+} position_anchor_t;
+
+typedef struct PositionAnchorRing {
+  int num_anchors; /* 0 = ring absent */
+  position_anchor_t anchors[def_pos_conv_max_anchors];
+} position_anchor_ring_t;
+
+typedef struct PositionConversionAnchors {
+  int valid;   /* derivation succeeded; layout mode usable */
+  int balloon; /* binaural/mono: radial conversion, Chebyshev distance */
+  position_anchor_ring_t mid;
+  position_anchor_ring_t top;
+  position_anchor_ring_t bottom;
+} position_conversion_anchors_t;
+
+/* The oar_t-owned position-conversion state: the runtime mode plus the
+ * anchor set derived once from the target layout at creation (the anchors
+ * depend only on the output layout, so all renderers share one set). */
+typedef struct PositionConversion {
+  oar_position_conversion_t mode;
+  position_conversion_anchors_t anchors;
+} position_conversion_t;
+
+/*
+ * Derive the anchor rings for an output layout from the OLR speaker
+ * tables. Speakers are clustered by elevation into mid/top/bottom
+ * rings (zenith/nadir and LFE excluded), each speaker's azimuth is
+ * mapped to its room-cube wall point, and incomplete rings are
+ * completed with phantom rear (and front-centre) anchors so every ring
+ * closes around the listener. Returns ck_oar_ok and sets
+ * anchors->valid on success; on failure anchors->valid stays 0 and the
+ * caller should fall back to the fixed sector map.
+ */
+int position_conversion_anchors_derive(rid_t out,
+                                       position_conversion_anchors_t *anchors);
+
+/*
+ * Convert a room-cube cartesian position to polar using derived anchor
+ * rings (or the balloon conversion when anchors->balloon is set).
+ * With a ring equal to the fixed five-anchor table and no top/bottom
+ * rings, the result is bit-identical to
+ * cartesian_to_polar_sector_float32().
+ */
+polar_t cartesian_to_polar_anchored(
+    const position_conversion_anchors_t *anchors, cartesian_t cartesian);
+
+/*
+ * position_conversion_anchors_derive() for a public target layout: maps
+ * the layout to its OLR output id and derives. The single derivation
+ * recipe shared by oar_create() and the public
+ * oar_position_anchors_create(), so a standalone handle can never drift
+ * from what an oar_t of the same target layout derives. Returns
+ * ck_oar_error_notsup for layouts that are not target layouts.
+ */
+int position_conversion_anchors_derive_layout(
+    oar_layout_t layout, position_conversion_anchors_t *anchors);
+
+/*
+ * The single mode dispatcher shared by the renderer base and the public
+ * oar_cartesian_to_polar(): layout mode with a valid anchor set converts
+ * anchored (balloon included); everything else — sector mode, a missing
+ * or invalid anchor set — converts through the fixed section 10 map,
+ * mirroring the in-renderer derivation-failure fallback.
+ */
+polar_t position_conversion_convert(
+    const position_conversion_anchors_t *anchors,
+    oar_position_conversion_t mode, cartesian_t cartesian);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // __POSITION_CONVERSION_H__
