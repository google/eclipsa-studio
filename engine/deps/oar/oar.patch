+/* ---- 2. degenerate layouts: bit-identical to the fixed sector map ------ */
+
+static int check_degenerate_bit_exact(void) {
+  static const oar_layout_t layouts[] = {ck_oar_layout_stereo,
+                                         ck_oar_layout_51};
+  int failures = 0;
+
+  for (int li = 0; li < 2; ++li) {
+    position_conversion_anchors_t anchors;
+    if (derive_for_layout(layouts[li], &anchors) != 0) {
+      fprintf(stderr, "FAIL: derivation failed for degenerate layout %d\n",
+              li);
+      failures++;
+      continue;
+    }
+    int mismatches = 0;
+    for (int zi = 0; zi < GRID_POINTS; ++zi)
+      for (int yi = 0; yi < GRID_POINTS; ++yi)
+        for (int xi = 0; xi < GRID_POINTS; ++xi) {
+          cartesian_t c = grid_cart(xi, yi, zi);
+          polar_t a = cartesian_to_polar_anchored(&anchors, c);
+          polar_t b = cartesian_to_polar_sector_float32(c);
+          if (memcmp(&a, &b, sizeof(a)) != 0) {
+            if (mismatches == 0)
+              fprintf(stderr,
+                      "FAIL: layout %d (%g,%g,%g): anchored (%g,%g,%g) != "
+                      "sector (%g,%g,%g)\n",
+                      li, c.x, c.y, c.z, a.azimuth, a.elevation, a.distance,
+                      b.azimuth, b.elevation, b.distance);
+            mismatches++;
+          }
+        }
+    if (mismatches) {
+      fprintf(stderr, "FAIL: %d bit mismatches on degenerate layout %d\n",
+              mismatches, li);
+      failures++;
+    } else {
+      printf("PASS: degenerate layout %d is bit-identical to the fixed map\n",
+             li);
+    }
+  }
+  return failures;
+}
+
+/* ---- 3. tolerance cross-check against the panlab reference dump -------- */
+
+static float circular_diff_deg(float a, float b) {
+  float d = fabsf(a - b);
+  while (d > 360.f) d -= 360.f;
+  if (d > 180.f) d = 360.f - d;
+  return d;
+}
+
+static int check_reference_dump(void) {
+  int failures = 0;
+  int rows = (int)(sizeof(g_reference) / sizeof(g_reference[0]));
+  int checked = 0;
+  float max_az = 0.f, max_el = 0.f, max_d = 0.f;
+
+  for (int li = 0; li < NUM_STUDY_LAYOUTS; ++li) {
+    position_conversion_anchors_t anchors;
+    if (derive_for_layout(kStudyLayouts[li].layout, &anchors) != 0) {
+      fprintf(stderr, "FAIL: derivation failed for %s\n", kStudyLayouts[li].id);
+      failures++;
+      continue;
+    }
+    for (int r = 0; r < rows; ++r) {
+      const reference_conversion_t *ref = &g_reference[r];
+      if (strcmp(ref->layout, kStudyLayouts[li].id) != 0) continue;
+
+      cartesian_t c = {ref->x, ref->y, ref->z};
+      polar_t p = cartesian_to_polar_anchored(&anchors, c);
+
+      float daz = circular_diff_deg(p.azimuth, ref->az);
+      float del = fabsf(p.elevation - ref->el);
+      float dd = fabsf(p.distance - ref->d);
+      if (daz > max_az) max_az = daz;
+      if (del > max_el) max_el = del;
+      if (dd > max_d) max_d = dd;
+
+      if (daz > 0.05f || del > 0.02f || dd > 1e-4f) {
+        fprintf(stderr,
+                "FAIL: %s (%g,%g,%g): got (%.4f,%.4f,%.5f), reference "
+                "(%.4f,%.4f,%.5f)\n",
+                ref->layout, ref->x, ref->y, ref->z, p.azimuth, p.elevation,
+                p.distance, ref->az, ref->el, ref->d);
+        failures++;
+      }
+      checked++;
+    }
+  }
+
+  if (!failures)
+    printf(
+        "PASS: %d reference conversions matched (max daz %.4g deg, del %.4g "
+        "deg, dd %.4g)\n",
+        checked, max_az, max_el, max_d);
+  return failures;
+}
+
+/* ---- 4 & 5. public API: regression, mode handling, corner pinning ------ */
+
+/* Renders one 440 Hz object at a constant position — cartesian (x, y, z)
+ * or, with position_type ck_polar, polar (azimuth, elevation, distance) in
+ * a/b/c. mode < 0 leaves the conversion mode untouched; toggle exercises a
+ * set-and-revert before rendering. Returns 0 on success; the caller owns
+ * out->data. */
+static int render_object(oar_layout_t layout, int mode, int toggle,
+                         coordinate_type_t position_type, float a, float b,
+                         float c, oar_audio_block_t *out) {
+  oar_config_t cfg;
+  cfg.target_layout = layout;
+  cfg.samples_per_channel = SAMPLES_PER_CHANNEL;
+  cfg.sampling_rate = SAMPLE_RATE;
+
+  oar_t *oar = oar_create(&cfg);
+  if (!oar) return -1;
+
+  if (mode >= 0 &&
+      oar_set_position_conversion(oar, (oar_position_conversion_t)mode) != 0) {
+    fprintf(stderr, "oar_set_position_conversion(%d) failed\n", mode);
+    oar_destroy(oar);
+    return -1;
+  }
+  if (toggle) {
+    if (oar_set_position_conversion(oar, ck_oar_pos_conv_layout) != 0 ||
+        oar_set_position_conversion(oar, ck_oar_pos_conv_sector) != 0) {
+      oar_destroy(oar);
+      return -1;
+    }
+  }
+
+  int group_id = oar_add_audio_group(oar);
+  if (group_id < 0) {
+    oar_destroy(oar);
+    return -1;
+  }
+
+  oar_audio_element_config_t element_cfg;
+  memset(&element_cfg, 0, sizeof(element_cfg));
+  element_cfg.type = ck_object_based;
+  element_cfg.obc.num_objects = 1;
+  if (oar_add_audio_element(oar, group_id, 1, &element_cfg) != 0) {
+    oar_destroy(oar);
+    return -1;
+  }
+
+  float input[SAMPLES_PER_CHANNEL];
+  for (int i = 0; i < SAMPLES_PER_CHANNEL; ++i)
+    input[i] = (float)sin(2.0 * M_PI * 440.0 * i / SAMPLE_RATE);
+
+  oar_audio_block_t input_block;
+  input_block.channels = 1;
+  input_block.samples_per_channel = SAMPLES_PER_CHANNEL;
+  input_block.data = input;
+  if (oar_update_audio_element_data(oar, 1, &input_block) != 0) {
+    oar_destroy(oar);
+    return -1;
+  }
+
+  oar_metadata_t metadata;
+  memset(&metadata, 0, sizeof(metadata));
+  metadata.type = ck_metadata_object_positions;
+  metadata.duration = SAMPLES_PER_CHANNEL;
+  metadata.object_positions.param_type = ck_param_constant;
+  metadata.object_positions.position_type = position_type;
+  metadata.object_positions.num_objects = 1;
+  if (position_type == ck_polar) {
+    metadata.object_positions.polar_positions[0] = def_polar_instance(a, b, c);
+  } else {
+    metadata.object_positions.cartesian_positions[0] =
+        def_cartesian_instance(a, b, c);
+  }
+  if (oar_update_audio_element_metadata(oar, 1, &metadata) != 0) {
+    oar_destroy(oar);
+    return -1;
+  }
+
+  out->channels = oar_get_number_of_output_channels(oar);
+  out->samples_per_channel = oar_get_samples_per_channel(oar);
+  out->data =
+      (float *)calloc(out->channels * out->samples_per_channel, sizeof(float));
+  if (!out->data) {
+    oar_destroy(oar);
+    return -1;
+  }
+
+  int ret = oar_render(oar, out);
+  oar_destroy(oar);
+  if (ret != 0) {
+    free(out->data);
+    out->data = NULL;
+    return -1;
+  }
+  return 0;
+}
+
+static double channel_energy(const oar_audio_block_t *block, uint32_t channel) {
+  double energy = 0.0;
+  const float *p = block->data + channel * block->samples_per_channel;
+  for (uint32_t i = 0; i < block->samples_per_channel; ++i)
+    energy += (double)p[i] * p[i];
+  return energy;
+}
+
+static int check_mode_api(void) {
+  oar_config_t cfg;
+  cfg.target_layout = ck_oar_layout_714;
+  cfg.samples_per_channel = SAMPLES_PER_CHANNEL;
+  cfg.sampling_rate = SAMPLE_RATE;
+  int failed = 0;
+
+  oar_t *oar = oar_create(&cfg);
+  if (!oar) return 1;
+
+  if (oar_get_position_conversion(oar) != ck_oar_pos_conv_sector) {
+    fprintf(stderr, "FAIL: default mode is not ck_oar_pos_conv_sector\n");
+    failed = 1;
+  }
+  if (oar_set_position_conversion(oar, (oar_position_conversion_t)99) == 0) {
+    fprintf(stderr, "FAIL: invalid mode was accepted\n");
+    failed = 1;
+  }
+  if (oar_set_position_conversion(oar, ck_oar_pos_conv_layout) != 0 ||
+      oar_get_position_conversion(oar) != ck_oar_pos_conv_layout) {
+    fprintf(stderr, "FAIL: layout mode set/get roundtrip failed\n");
+    failed = 1;
+  }
+  if (oar_set_position_conversion(NULL, ck_oar_pos_conv_sector) == 0) {
+    fprintf(stderr, "FAIL: NULL oar was accepted\n");
+    failed = 1;
+  }
+  oar_destroy(oar);
+  if (!failed) printf("PASS: mode setter/getter behave\n");
+  return failed;
+}
+
+static int check_default_mode_regression(void) {
+  static const float positions[][3] = {
+      {0.f, 1.f, 0.f}, {1.f, 1.f, 0.f}, {1.f, -1.f, 1.f},
+      {-0.3f, 0.4f, 0.7f}, {0.f, 0.f, 0.f}};
+  int failures = 0;
+
+  for (int i = 0; i < 5; ++i) {
+    oar_audio_block_t untouched = {0}, toggled = {0};
+    if (render_object(ck_oar_layout_714, -1, 0, ck_cartesian, positions[i][0],
+                      positions[i][1], positions[i][2], &untouched) != 0 ||
+        render_object(ck_oar_layout_714, -1, 1, ck_cartesian, positions[i][0],
+                      positions[i][1], positions[i][2], &toggled) != 0) {
+      fprintf(stderr, "FAIL: rendering failed for regression position %d\n", i);
+      free(untouched.data);
+      free(toggled.data);
+      failures++;
+      continue;
+    }
+    if (memcmp(untouched.data, toggled.data,
+               untouched.channels * untouched.samples_per_channel *
+                   sizeof(float)) != 0) {
+      fprintf(stderr,
+              "FAIL: default-mode output changed after a mode toggle "
+              "(position %d)\n",
+              i);
+      failures++;
+    }
+    free(untouched.data);
+    free(toggled.data);
+  }
+  if (!failures)
+    printf("PASS: default mode output is unchanged by the mode API\n");
+  return failures;
+}
+
+static int check_corner_pinning(void) {
+  /* 7.1.4 output channel order follows the OLR speaker table:
+   * L R C LFE Lss Rss Lrs Rrs Ltf Rtf Ltb Rtb. */
+  static const struct {
+    float x, y, z;
+    uint32_t channel;
+    const char *name;
+  } corners[] = {
+      {1.f, -1.f, 0.f, 7, "Rrs"},  {-1.f, -1.f, 0.f, 6, "Lrs"},
+      {1.f, 1.f, 1.f, 9, "Rtf"},   {-1.f, -1.f, 1.f, 10, "Ltb"},
+      {0.f, 1.f, 0.f, 2, "C"},
+  };
+  int failures = 0;
+
+  for (int i = 0; i < 5; ++i) {
+    oar_audio_block_t out = {0};
+    if (render_object(ck_oar_layout_714, ck_oar_pos_conv_layout, 0,
+                      ck_cartesian, corners[i].x, corners[i].y, corners[i].z,
+                      &out) != 0) {
+      fprintf(stderr, "FAIL: rendering failed for corner %s\n",
+              corners[i].name);
+      failures++;
+      continue;
+    }
+    double total = 0.0, target = channel_energy(&out, corners[i].channel);
+    for (uint32_t ch = 0; ch < out.channels; ++ch)
+      total += channel_energy(&out, ch);
+    free(out.data);
+
+    if (total < 1e-9 || target / total < 0.99) {
+      fprintf(stderr,
+              "FAIL: corner (%g,%g,%g) puts %.1f%% of the energy on %s\n",
+              corners[i].x, corners[i].y, corners[i].z,
+              total > 0 ? 100.0 * target / total : 0.0, corners[i].name);
+      failures++;
+    } else {
+      printf("PASS: corner (%g,%g,%g) pins to %s (%.2f%% of energy)\n",
+             corners[i].x, corners[i].y, corners[i].z, corners[i].name,
+             100.0 * target / total);
+    }
+  }
+  return failures;
+}
+
+/* ---- 6. public standalone conversion API ------------------------------- */
+
+/* In layout mode, the public conversion must be bit-identical to the
+ * internal one on every target layout: the study and extended tables
+ * above plus the balloon targets binaural and mono (whose derived
+ * anchor sets dispatch the balloon conversion internally too). */
+static int check_public_bit_identity(void) {
+  struct {
+    const char *id;
+    oar_layout_t layout;
+  } targets[NUM_STUDY_LAYOUTS + NUM_EXTENDED_LAYOUTS + 2];
+  int num_targets = 0;
+  int failures = 0;
+
+  for (int i = 0; i < NUM_STUDY_LAYOUTS; ++i) {
+    targets[num_targets].id = kStudyLayouts[i].id;
+    targets[num_targets++].layout = kStudyLayouts[i].layout;
+  }
+  for (int i = 0; i < NUM_EXTENDED_LAYOUTS; ++i) {
+    targets[num_targets].id = kExtendedLayouts[i].id;
+    targets[num_targets++].layout = kExtendedLayouts[i].layout;
+  }
+  targets[num_targets].id = "binaural";
+  targets[num_targets++].layout = ck_oar_layout_binaural;
+  targets[num_targets].id = "mono";
+  targets[num_targets++].layout = ck_oar_layout_mono;
+
+  for (int li = 0; li < num_targets; ++li) {
+    position_conversion_anchors_t internal;
+    oar_position_anchors_t *handle =
+        oar_position_anchors_create(targets[li].layout);
+    if (!handle || derive_for_layout(targets[li].layout, &internal)) {
+      fprintf(stderr, "FAIL: %s: %s anchor derivation failed\n",
+              targets[li].id, handle ? "internal" : "public");
+      oar_position_anchors_destroy(handle);
+      failures++;
+      continue;
+    }
+    int mismatches = 0;
+    for (int zi = 0; zi < GRID_POINTS; ++zi)
+      for (int yi = 0; yi < GRID_POINTS; ++yi)
+        for (int xi = 0; xi < GRID_POINTS; ++xi) {
+          cartesian_t c = grid_cart(xi, yi, zi);
+          polar_t pub =
+              oar_cartesian_to_polar(handle, ck_oar_pos_conv_layout, c);
+          polar_t internal_p = cartesian_to_polar_anchored(&internal, c);
+          if (memcmp(&pub, &internal_p, sizeof(pub)) != 0) mismatches++;
+        }
+    oar_position_anchors_destroy(handle);
+    if (mismatches) {
+      fprintf(stderr, "FAIL: %s: %d public-vs-internal bit mismatches\n",
+              targets[li].id, mismatches);
+      failures++;
+    } else {
+      printf("PASS: %s public conversion is bit-identical to internal\n",
+             targets[li].id);
+    }
+  }
+  return failures;
+}
+
+/* Sector mode is layout-invariant and must ignore the anchors entirely
+ * (the header allows NULL there); and a NULL handle in layout mode
+ * selects the balloon conversion, i.e. exactly what a binaural handle
+ * applies. */
+static int check_public_sector_and_null(void) {
+  oar_position_anchors_t *speaker =
+      oar_position_anchors_create(ck_oar_layout_714);
+  oar_position_anchors_t *balloon =
+      oar_position_anchors_create(ck_oar_layout_binaural);
+  int sector_mismatches = 0, null_mismatches = 0, failed = 0;
+
+  if (!speaker || !balloon) {
+    fprintf(stderr, "FAIL: anchor creation failed for 714 or binaural\n");
+    oar_position_anchors_destroy(speaker);
+    oar_position_anchors_destroy(balloon);
+    return 1;
+  }
+
+  for (int zi = 0; zi < GRID_POINTS; ++zi)
+    for (int yi = 0; yi < GRID_POINTS; ++yi)
+      for (int xi = 0; xi < GRID_POINTS; ++xi) {
+        cartesian_t c = grid_cart(xi, yi, zi);
+        polar_t sector_ref = cartesian_to_polar_sector_float32(c);
+        polar_t with_handle =
+            oar_cartesian_to_polar(speaker, ck_oar_pos_conv_sector, c);
+        polar_t with_null =
+            oar_cartesian_to_polar(NULL, ck_oar_pos_conv_sector, c);
+        if (memcmp(&with_handle, &sector_ref, sizeof(sector_ref)) != 0 ||
+            memcmp(&with_null, &sector_ref, sizeof(sector_ref)) != 0)
+          sector_mismatches++;
+
+        polar_t null_layout =
+            oar_cartesian_to_polar(NULL, ck_oar_pos_conv_layout, c);
+        polar_t balloon_ref =
+            oar_cartesian_to_polar(balloon, ck_oar_pos_conv_layout, c);
+        if (memcmp(&null_layout, &balloon_ref, sizeof(balloon_ref)) != 0)
+          null_mismatches++;
+      }
+  oar_position_anchors_destroy(speaker);
+  oar_position_anchors_destroy(balloon);
+
+  if (sector_mismatches) {
+    fprintf(stderr, "FAIL: %d sector-mode bit mismatches\n",
+            sector_mismatches);
+    failed++;
+  } else {
+    printf("PASS: sector mode ignores anchors (handle and NULL alike)\n");
+  }
+  if (null_mismatches) {
+    fprintf(stderr, "FAIL: %d NULL-handle balloon bit mismatches\n",
+            null_mismatches);
+    failed++;
+  } else {
+    printf("PASS: a NULL handle in layout mode selects the balloon "
+           "conversion\n");
+  }
+  return failed;
+}
+
+static int check_public_api_errors(void) {
+  int failed = 0;
+
+  /* Element-subset layouts are not target layouts and derive no anchors. */
+  if (oar_position_anchors_create(ck_oar_layout_lfe) != NULL) {
+    fprintf(stderr, "FAIL: subset layout was accepted\n");
+    failed = 1;
+  }
+  if (oar_position_anchors_create(ck_oar_layout_none) != NULL) {
+    fprintf(stderr, "FAIL: ck_oar_layout_none was accepted\n");
+    failed = 1;
+  }
+  oar_position_anchors_destroy(NULL);
+
+  if (!failed) printf("PASS: public API rejects non-target layouts\n");
+  return failed;
+}
+
+/* The issue-19 use case: converting a position with the public API and
+ * feeding the polar result back as polar metadata must render
+ * bit-identically to handing the renderer the cartesian position. */
+static int check_public_end_to_end(void) {
+  static const float positions[][3] = {{0.7f, 0.3f, 0.5f},
+                                       {1.f, -1.f, 0.f},
+                                       {-0.2f, 0.9f, 1.f},
+                                       {0.f, 0.f, 0.f}};
+  static const int modes[] = {ck_oar_pos_conv_layout, ck_oar_pos_conv_sector};
+  int failures = 0;
+
+  oar_position_anchors_t *anchors =
+      oar_position_anchors_create(ck_oar_layout_714);
+  if (!anchors) {
+    fprintf(stderr, "FAIL: anchor creation failed for 714\n");
+    return 1;
+  }
+
+  for (int mi = 0; mi < 2; ++mi) {
+    for (int i = 0; i < 4; ++i) {
+      cartesian_t c = {positions[i][0], positions[i][1], positions[i][2]};
+      polar_t p = oar_cartesian_to_polar(
+          anchors, (oar_position_conversion_t)modes[mi], c);
+
+      oar_audio_block_t direct = {0}, baked = {0};
+      if (render_object(ck_oar_layout_714, modes[mi], 0, ck_cartesian, c.x,
+                        c.y, c.z, &direct) != 0 ||
+          render_object(ck_oar_layout_714, modes[mi], 0, ck_polar, p.azimuth,
+                        p.elevation, p.distance, &baked) != 0) {
+        fprintf(stderr, "FAIL: rendering failed (mode %d, position %d)\n",
+                modes[mi], i);
+        free(direct.data);
+        free(baked.data);
+        failures++;
+        continue;
+      }
+      if (memcmp(direct.data, baked.data,
+                 direct.channels * direct.samples_per_channel *
+                     sizeof(float)) != 0) {
+        fprintf(stderr,
+                "FAIL: baked polar render differs from cartesian render "
+                "(mode %d, position %d)\n",
+                modes[mi], i);
+        failures++;
+      }
+      free(direct.data);
+      free(baked.data);
+    }
+  }
+  oar_position_anchors_destroy(anchors);
+
+  if (!failures)
+    printf("PASS: baked public-API conversions render bit-identically\n");
+  return failures;
+}
+
+int main(void) {
+  int failures = 0;
+
+  printf("Position conversion test\n\n");
+
+  failures += check_derived_rings();
+  failures += check_extended_layouts();
+  failures += check_degenerate_bit_exact();
+  failures += check_reference_dump();
+  failures += check_mode_api();
+  failures += check_default_mode_regression();
+  failures += check_corner_pinning();
+  failures += check_public_bit_identity();
+  failures += check_public_sector_and_null();
+  failures += check_public_api_errors();
+  failures += check_public_end_to_end();
+
+  if (failures) {
+    fprintf(stderr, "\n%d position conversion check(s) FAILED\n", failures);
+    return 1;
+  }
+  printf("\nAll position conversion checks passed.\n");
+  return 0;
+}
