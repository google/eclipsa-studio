+static int check_ring(const char *id, const char *ring_name,
+                      const position_anchor_ring_t *ring,
+                      const expected_anchor_t *expected, int n_expected) {
+  int failed = 0;
+
+  if (ring->num_anchors != n_expected) {
+    fprintf(stderr, "FAIL: %s %s ring has %d anchors, expected %d\n", id,
+            ring_name, ring->num_anchors, n_expected);
+    return 1;
+  }
+
+  for (int i = 0; i < n_expected; ++i) {
+    int found = 0;
+    for (int j = 0; j < ring->num_anchors; ++j) {
+      if (fabsf(ring->anchors[j].azimuth - expected[i].az) < 0.01f) {
+        found = 1;
+        if (ring->anchors[j].position.x != expected[i].x ||
+            ring->anchors[j].position.y != expected[i].y) {
+          fprintf(stderr,
+                  "FAIL: %s %s anchor az %.0f at (%g, %g), expected (%g, %g)\n",
+                  id, ring_name, expected[i].az, ring->anchors[j].position.x,
+                  ring->anchors[j].position.y, expected[i].x, expected[i].y);
+          failed = 1;
+        }
+        break;
+      }
+    }
+    if (!found) {
+      fprintf(stderr, "FAIL: %s %s ring is missing anchor az %.0f\n", id,
+              ring_name, expected[i].az);
+      failed = 1;
+    }
+  }
+  return failed;
+}
+
+static int derive_for_layout(oar_layout_t layout,
+                             position_conversion_anchors_t *anchors) {
+  return position_conversion_anchors_derive_layout(layout, anchors) ==
+                 ck_oar_ok
+             ? 0
+             : -1;
+}
+
+/* The 9x9x9 room-cube grid every bit-identity sweep in this file runs
+ * over. */
+#define GRID_POINTS 9
+static cartesian_t grid_cart(int xi, int yi, int zi) {
+  return def_cartesian_instance(-1.f + xi * 0.25f, -1.f + yi * 0.25f,
+                                -1.f + zi * 0.25f);
+}
+
+static int check_derived_rings(void) {
+  int failures = 0;
+
+  for (int i = 0; i < NUM_STUDY_LAYOUTS; ++i) {
+    position_conversion_anchors_t anchors;
+    if (derive_for_layout(kStudyLayouts[i].layout, &anchors) != 0) {
+      fprintf(stderr, "FAIL: derivation failed for %s\n", kStudyLayouts[i].id);
+      failures++;
+      continue;
+    }
+    int failed = 0;
+    if (anchors.balloon) {
+      fprintf(stderr, "FAIL: %s unexpectedly derived as balloon\n",
+              kStudyLayouts[i].id);
+      failed = 1;
+    }
+    failed |= check_ring(kStudyLayouts[i].id, "mid", &anchors.mid,
+                         kStudyLayouts[i].mid, kStudyLayouts[i].n_mid);
+    failed |= check_ring(kStudyLayouts[i].id, "top", &anchors.top,
+                         kStudyLayouts[i].top, kStudyLayouts[i].n_top);
+    if (anchors.bottom.num_anchors != 0) {
+      fprintf(stderr, "FAIL: %s has an unexpected bottom ring (%d anchors)\n",
+              kStudyLayouts[i].id, anchors.bottom.num_anchors);
+      failed = 1;
+    }
+    if (!failed)
+      printf("PASS: %s derived rings match the study constants\n",
+             kStudyLayouts[i].id);
+    failures += failed;
+  }
+
+  /* Binaural and mono outputs must select the balloon conversion. */
+  position_conversion_anchors_t anchors;
+  if (derive_for_layout(ck_oar_layout_binaural, &anchors) != 0 ||
+      !anchors.balloon) {
+    fprintf(stderr, "FAIL: binaural did not derive as balloon\n");
+    failures++;
+  } else if (derive_for_layout(ck_oar_layout_mono, &anchors) != 0 ||
+             !anchors.balloon) {
+    fprintf(stderr, "FAIL: mono did not derive as balloon\n");
+    failures++;
+  } else {
+    printf("PASS: binaural and mono derive as balloon conversions\n");
+  }
+
+  return failures;
+}
