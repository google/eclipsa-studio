+#include "position_conversion.h"
+
+#include <math.h>
+#include <string.h>
+
+#include "definitions.h"
+#include "oar.h"
+#include "oar_utils.h"
+#include "renderer/olr/object_audio_renderer/layout.h"
+#include "renderer/olr/olr.h"
+
+#define def_eps 1e-10
+
+/* BS.2127 allocentric y of a +-60 degree speaker on the side wall. */
+#define def_pos_conv_wide_y 0.414214f
+
+/* ---- anchor derivation ------------------------------------------------- */
+
+/*
+ * Generic azimuth -> wall point for azimuths outside the snap table
+ * (e.g. the +-25 degree screen speakers): the inverse of the section 10
+ * sector map at el = 0, d = 1, i.e. BS.2127's own rule for placing a
+ * screen speaker on the room-cube boundary. All sectors of the fixed
+ * table lie along walls, so the result lands on the boundary.
+ */
+static const struct {
+  float azimuth;
+  float x, y;
+} _g_polar_mapping[5] = {{0.f, 0.f, 1.f},
+                         {-30.f, 1.f, 1.f},
+                         {-110.f, 1.f, -1.f},
+                         {110.f, -1.f, -1.f},
+                         {30.f, -1.f, 1.f}};
+
+static float _map_az_to_linear(float left_az, float right_az, float az) {
+  float mid_az = (left_az + right_az) / 2.0f;
+  float az_range = right_az - mid_az;
+  float rel_az = az - mid_az;
+  float gain_r = 0.5f + 0.5f * tanf(def_degrees_to_radians(rel_az)) /
+                            tanf(def_degrees_to_radians(az_range));
+  return atan2f(gain_r, 1.0f - gain_r) * (2.0f / (float)M_PI);
+}
+
+static void _az_to_wall_point(float az, float *x, float *y) {
+  int left = 0, right = 1;
+  for (int i = 0; i < 5; i++) {
+    int j = (i + 1) % 5;
+    if (_inside_angle_range(az, _g_polar_mapping[j].azimuth,
+                            _g_polar_mapping[i].azimuth, 0.0f)) {
+      left = i;
+      right = j;
+      break;
+    }
+  }
+  float right_az = _g_polar_mapping[right].azimuth;
+  float rel_az = _relative_angle(right_az, az);
+  float rel_left_az = _relative_angle(right_az, _g_polar_mapping[left].azimuth);
+  float p = _map_az_to_linear(rel_left_az, right_az, rel_az);
+  *x = _g_polar_mapping[left].x +
+       (_g_polar_mapping[right].x - _g_polar_mapping[left].x) * p;
+  *y = _g_polar_mapping[left].y +
+       (_g_polar_mapping[right].y - _g_polar_mapping[left].y) * p;
+}
+
+static int _ring_add(position_anchor_ring_t *ring, float az, float x, float y) {
+  for (int i = 0; i < ring->num_anchors; i++) {
+    /* Circular difference, so aliases (e.g. -180 vs +180) dedupe too and
+     * cannot produce two anchors on the same wall point. */
+    float diff = fabsf(ring->anchors[i].azimuth - az);
+    while (diff >= 360.0f) diff -= 360.0f;
+    if (diff > 180.0f) diff = 360.0f - diff;
+    if (diff < 0.5f) return ck_oar_ok;
+  }
+  if (ring->num_anchors >= def_pos_conv_max_anchors) return ck_oar_error_inval;
+  ring->anchors[ring->num_anchors].azimuth = az;
+  ring->anchors[ring->num_anchors].position =
+      def_cartesian_instance(x, y, 0.0f);
+  ring->num_anchors++;
+  return ck_oar_ok;
