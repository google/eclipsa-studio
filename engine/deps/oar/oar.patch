diff --git a/tests/examples/test_limiter_env.c b/tests/examples/test_limiter_env.c
new file mode 100644
index 0000000..7a191b4
--- /dev/null
+++ b/tests/examples/test_limiter_env.c
@@ -0,0 +1,178 @@
+/*
+ * Copyright (c) 2026, Alliance for Open Media. All rights reserved
+ *
+ * This source code is subject to the terms of the BSD 3-Clause Clear License
+ * and the Alliance for Open Media Patent License 1.0. If the BSD 3-Clause Clear
+ * License was not distributed with this source code in the LICENSE file, you
+ * can obtain it at www.aomedia.org/license/software-license/bsd-3-c-c. If the
+ * Alliance for Open Media Patent License 1.0 was not distributed with this
+ * source code in the PATENTS file, you can obtain it at
+ * www.aomedia.org/license/patent.
+ */
+
+/*
+ * Tests for oar_get_limiter_env(): the limiter gain applied to the last
+ * sample of the most recent oar_render() call, published for metering.
+ *
+ * A stereo channel-based element rendered to a stereo layout passes audio
+ * through unchanged, so the limiter input equals the generated signal.
+ */
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+#include "oar.h"
+
+#define SAMPLE_RATE 48000
+#define BLOCK 256
+#define TONE_HZ 440.0
+
+typedef struct {
+  oar_t* oar;
+  float input[2 * BLOCK];
+  float output[2 * BLOCK];
+  double phase;
+} fixture_t;
+
+static int fixture_open(fixture_t* fx, int enable_limiter) {
+  oar_config_t cfg;
+  cfg.target_layout = ck_oar_layout_stereo;
+  cfg.samples_per_channel = BLOCK;
+  cfg.sampling_rate = SAMPLE_RATE;
+  memset(fx, 0, sizeof(*fx));
+
+  fx->oar = oar_create(&cfg);
+  if (!fx->oar) {
+    fprintf(stderr, "oar_create failed\n");
+    return -1;
+  }
+  int group_id = oar_add_audio_group(fx->oar);
+  oar_audio_element_config_t element_cfg;
+  memset(&element_cfg, 0, sizeof(element_cfg));
+  element_cfg.type = ck_channel_based;
+  element_cfg.cbc.layout = ck_oar_layout_stereo;
+  if (group_id < 0 ||
+      oar_add_audio_element(fx->oar, group_id, 1, &element_cfg) != 0 ||
+      oar_enable_limiter(fx->oar, enable_limiter) != 0) {
+    fprintf(stderr, "fixture setup failed\n");
+    oar_destroy(fx->oar);
+    fx->oar = 0;
+    return -1;
+  }
+  return 0;
+}
+
+static void fixture_close(fixture_t* fx) {
+  oar_destroy(fx->oar);
+  fx->oar = 0;
+}
+
+/* Renders `num_blocks` blocks of a phase-continuous sine at `amplitude`
+ * (0 renders silence). Returns 0 on success. */
+static int render(fixture_t* fx, float amplitude, int num_blocks) {
+  oar_audio_block_t input_block = {fx->input, 2, BLOCK};
+  oar_audio_block_t output_block = {fx->output, 2, BLOCK};
+  const double phase_inc = 2.0 * M_PI * TONE_HZ / SAMPLE_RATE;
+
+  for (int b = 0; b < num_blocks; ++b) {
+    for (int i = 0; i < BLOCK; ++i) {
+      float s = amplitude * (float)sin(fx->phase);
+      fx->input[i] = s;
+      fx->input[BLOCK + i] = s;
+      fx->phase += phase_inc;
+    }
+    output_block.samples_per_channel = BLOCK;
+    if (oar_update_audio_element_data(fx->oar, 1, &input_block) != 0 ||
+        oar_render(fx->oar, &output_block) != 0) {
+      fprintf(stderr, "render failed at block %d\n", b);
+      return -1;
+    }
+  }
+  return 0;
+}
+
+static int check(int cond, const char* what, double env) {
+  if (cond) {
+    printf("PASS: %s (env %.4f)\n", what, env);
+    return 0;
+  }
+  fprintf(stderr, "FAIL: %s (env %.4f)\n", what, env);
+  return 1;
+}
+
+int main(void) {
+  int failures = 0;
+  fixture_t fx;
+  double env;
+
+  printf("Limiter envelope test\n");
+
+  failures += check(oar_get_limiter_env(0) == 1.0, "NULL oar reports unity",
+                    oar_get_limiter_env(0));
+
+  /* Disabled limiter: unity regardless of level. */
+  if (fixture_open(&fx, 0) != 0) return 1;
+  if (render(&fx, 1.3f, 20) != 0) return 1;
+  env = oar_get_limiter_env(fx.oar);
+  failures += check(env == 1.0, "disabled limiter reports unity", env);
+  fixture_close(&fx);
+
+  if (fixture_open(&fx, 1) != 0) return 1;
+
+  /* Fresh instance, then sub-ceiling audio: nothing to limit. */
+  env = oar_get_limiter_env(fx.oar);
+  failures += check(env == 1.0, "unity before the first render", env);
+  if (render(&fx, 0.5f, 20) != 0) return 1;
+  env = oar_get_limiter_env(fx.oar);
+  failures += check(env == 1.0, "unity on sub-ceiling audio", env);
+
+  /* Over-ceiling tone: the published gain is below unity and matches the
+   * output/input ratio the limiter settled on. -1 dBFS ceiling on a 1.3
+   * peak needs a gain of about 0.6856. */
+  if (render(&fx, 1.3f, 60) != 0) return 1;
+  env = oar_get_limiter_env(fx.oar);
+  failures += check(env < 1.0 && env > 0.0, "below unity while limiting", env);
+  failures += check(fabs(env - 0.891250938 / 1.3) < 0.02,
+                    "matches the required gain within 2 %", env);
+
+  /* Silence longer than the 200 ms release: the reference limiter's
+   * release ends at exactly unity. */
+  if (render(&fx, 0.0f, 60) != 0) return 1;
+  env = oar_get_limiter_env(fx.oar);
+  failures += check(env == 1.0, "unity after the release completes", env);
+
+  /* Flush resets the limiter, so the published value returns to unity. */
+  if (render(&fx, 1.3f, 20) != 0) return 1;
+  env = oar_get_limiter_env(fx.oar);
+  failures += check(env < 1.0, "below unity again before flush", env);
+  static float tail[2 * BLOCK];
+  oar_audio_block_t tail_block = {tail, 2, BLOCK};
+  if (oar_flush(fx.oar, &tail_block) != 0) {
+    fprintf(stderr, "oar_flush failed\n");
+    return 1;
+  }
+  env = oar_get_limiter_env(fx.oar);
+  failures += check(env == 1.0, "unity after flush", env);
+
+  /* Re-enabling after a bypass also starts from unity. */
+  if (render(&fx, 1.3f, 20) != 0) return 1;
+  if (oar_enable_limiter(fx.oar, 0) != 0 || oar_enable_limiter(fx.oar, 1) != 0)
+    return 1;
+  env = oar_get_limiter_env(fx.oar);
+  failures += check(env == 1.0, "unity after re-enable", env);
+
+  fixture_close(&fx);
+
+  if (failures) {
+    fprintf(stderr, "\n%d limiter envelope check(s) FAILED\n", failures);
+    return 1;
+  }
+  printf("\nAll limiter envelope checks passed.\n");
+  return 0;
+}
diff --git a/tests/examples/test_object_azimuth_wrapping.c b/tests/examples/test_object_azimuth_wrapping.c
new file mode 100644
index 0000000..be5ca39
--- /dev/null
+++ b/tests/examples/test_object_azimuth_wrapping.c
@@ -0,0 +1,232 @@
+/*
+ * Copyright (c) 2026, Alliance for Open Media. All rights reserved
+ *
+ * This source code is subject to the terms of the BSD 3-Clause Clear License
+ * and the Alliance for Open Media Patent License 1.0. If the BSD 3-Clause Clear
+ * License was not distributed with this source code in the LICENSE file, you
+ * can obtain it at www.aomedia.org/license/software-license/bsd-3-c-c. If the
+ * Alliance for Open Media Patent License 1.0 was not distributed with this
+ * source code in the PATENTS file, you can obtain it at
+ * www.aomedia.org/license/patent.
+ */
+
+/*
+ * Regression test for out-of-range object azimuths in the OLR.
+ *
+ * An azimuth outside (-180, 180] is an alias of a canonical angle (+270 is
+ * -90). The renderer used to pass such angles through unfolded, and the
+ * closest-speaker fallback compared angles linearly, so on a stereo layout a
+ * source at +270 collapsed onto the LEFT speaker even though -90 is on the
+ * right. This test renders a sine at aliased azimuth pairs and requires
+ * bit-identical output, plus checks that lateral sources land on opposite
+ * output channels.
+ */
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+#include "oar.h"
+
+#define SAMPLES_PER_CHANNEL 256
+#define SAMPLE_RATE 48000
+
+// Renders one 440 Hz object at the given azimuth to a stereo output block.
+// Returns 0 on success; the caller owns out->data.
+static int render_object_at_azimuth(float azimuth, oar_audio_block_t* out) {
+  oar_config_t cfg;
+  cfg.target_layout = ck_oar_layout_stereo;
+  cfg.samples_per_channel = SAMPLES_PER_CHANNEL;
+  cfg.sampling_rate = SAMPLE_RATE;
+
+  oar_t* oar = oar_create(&cfg);
+  if (!oar) {
+    fprintf(stderr, "oar_create failed\n");
+    return -1;
+  }
+
+  int group_id = oar_add_audio_group(oar);
+  if (group_id < 0) {
+    fprintf(stderr, "oar_add_audio_group failed: %d\n", group_id);
+    oar_destroy(oar);
+    return -1;
+  }
+
+  oar_audio_element_config_t element_cfg;
+  memset(&element_cfg, 0, sizeof(element_cfg));
+  element_cfg.type = ck_object_based;
+  element_cfg.obc.num_objects = 1;
+
+  int ret = oar_add_audio_element(oar, group_id, 1, &element_cfg);
+  if (ret != 0) {
+    fprintf(stderr, "oar_add_audio_element failed: %d\n", ret);
+    oar_destroy(oar);
+    return -1;
+  }
+
+  float input[SAMPLES_PER_CHANNEL];
+  for (int i = 0; i < SAMPLES_PER_CHANNEL; ++i) {
+    input[i] = (float)sin(2.0 * M_PI * 440.0 * i / SAMPLE_RATE);
+  }
+
+  oar_audio_block_t input_block;
+  input_block.channels = 1;
+  input_block.samples_per_channel = SAMPLES_PER_CHANNEL;
+  input_block.data = input;
+  ret = oar_update_audio_element_data(oar, 1, &input_block);
+  if (ret != 0) {
+    fprintf(stderr, "oar_update_audio_element_data failed: %d\n", ret);
+    oar_destroy(oar);
+    return -1;
+  }
+
+  oar_metadata_t metadata;
+  memset(&metadata, 0, sizeof(metadata));
+  metadata.type = ck_metadata_object_positions;
+  metadata.duration = SAMPLES_PER_CHANNEL;
+  metadata.object_positions.param_type = ck_param_constant;
+  metadata.object_positions.position_type = ck_polar;
+  metadata.object_positions.num_objects = 1;
+  metadata.object_positions.polar_positions[0].azimuth = azimuth;
+  metadata.object_positions.polar_positions[0].elevation = 0.f;
+  metadata.object_positions.polar_positions[0].distance = 1.f;
+  ret = oar_update_audio_element_metadata(oar, 1, &metadata);
+  if (ret != 0) {
+    fprintf(stderr, "oar_update_audio_element_metadata failed: %d\n", ret);
+    oar_destroy(oar);
+    return -1;
+  }
+
+  out->channels = oar_get_number_of_output_channels(oar);
+  out->samples_per_channel = oar_get_samples_per_channel(oar);
+  out->data = (float*)calloc(out->channels * out->samples_per_channel,
+                             sizeof(float));
+  if (!out->data) {
+    oar_destroy(oar);
+    return -1;
+  }
+
+  ret = oar_render(oar, out);
+  oar_destroy(oar);
+  if (ret != 0) {
+    fprintf(stderr, "oar_render failed: %d\n", ret);
+    free(out->data);
+    out->data = NULL;
+    return -1;
+  }
+  return 0;
+}
+
+static double channel_energy(const oar_audio_block_t* block, uint32_t channel) {
+  double energy = 0.0;
+  const float* p = block->data + channel * block->samples_per_channel;
+  for (uint32_t i = 0; i < block->samples_per_channel; ++i) {
+    energy += (double)p[i] * p[i];
+  }
+  return energy;
+}
+
+static double max_abs_difference(const oar_audio_block_t* a,
+                                 const oar_audio_block_t* b) {
+  double max_diff = 0.0;
+  uint32_t n = a->channels * a->samples_per_channel;
+  for (uint32_t i = 0; i < n; ++i) {
+    double diff = fabs((double)a->data[i] - b->data[i]);
+    if (diff > max_diff) max_diff = diff;
+  }
+  return max_diff;
+}
+
+// Renders `azimuth` and its alias `azimuth + turns*360` and requires the two
+// outputs to be identical. Returns 0 on pass.
+static int check_alias_pair(float azimuth, int turns) {
+  float alias = azimuth + 360.f * turns;
+  oar_audio_block_t ref = {0}, aliased = {0};
+  int failed = 0;
+
+  if (render_object_at_azimuth(azimuth, &ref) != 0 ||
+      render_object_at_azimuth(alias, &aliased) != 0) {
+    free(ref.data);
+    free(aliased.data);
+    return 1;
+  }
+
+  if (channel_energy(&ref, 0) + channel_energy(&ref, 1) < 1e-6) {
+    fprintf(stderr, "FAIL: azimuth %.1f rendered silence\n", azimuth);
+    failed = 1;
+  }
+
+  double diff = max_abs_difference(&ref, &aliased);
+  if (diff > 1e-6) {
+    fprintf(stderr,
+            "FAIL: azimuth %.1f and alias %.1f differ (max abs diff %g)\n",
+            azimuth, alias, diff);
+    failed = 1;
+  } else {
+    printf("PASS: azimuth %.1f == alias %.1f (max abs diff %g)\n", azimuth,
+           alias, diff);
+  }
+
+  free(ref.data);
+  free(aliased.data);
+  return failed;
+}
+
+// Renders two laterally opposed azimuths and requires their dominant output
+// channels to be opposite (each side collapses onto its closest speaker).
+static int check_opposite_sides(float azimuth_a, float azimuth_b) {
+  oar_audio_block_t a = {0}, b = {0};
+  int failed = 0;
+
+  if (render_object_at_azimuth(azimuth_a, &a) != 0 ||
+      render_object_at_azimuth(azimuth_b, &b) != 0) {
+    free(a.data);
+    free(b.data);
+    return 1;
+  }
+
+  int dominant_a = channel_energy(&a, 0) > channel_energy(&a, 1) ? 0 : 1;
+  int dominant_b = channel_energy(&b, 0) > channel_energy(&b, 1) ? 0 : 1;
+  if (dominant_a == dominant_b) {
+    fprintf(stderr,
+            "FAIL: azimuths %.1f and %.1f both favor output channel %d\n",
+            azimuth_a, azimuth_b, dominant_a);
+    failed = 1;
+  } else {
+    printf("PASS: azimuth %.1f favors channel %d, azimuth %.1f favors %d\n",
+           azimuth_a, dominant_a, azimuth_b, dominant_b);
+  }
+
+  free(a.data);
+  free(b.data);
+  return failed;
+}
+
+int main(void) {
+  int failures = 0;
+
+  printf("Object azimuth wrapping test\n");
+
+  // Aliased angles must render identically to their canonical forms.
+  failures += check_alias_pair(-90.f, 1);   // +270 == -90
+  failures += check_alias_pair(90.f, 1);    // +450 == +90
+  failures += check_alias_pair(-170.f, 1);  // +190 == -170
+  failures += check_alias_pair(30.f, -2);   // -690 == +30
+
+  // Lateral sources must collapse onto opposite stereo speakers; before the
+  // fix, +270 landed on the same (left) speaker as +90.
+  failures += check_opposite_sides(90.f, -90.f);
+  failures += check_opposite_sides(90.f, 270.f);
+
+  if (failures) {
+    fprintf(stderr, "\n%d azimuth wrapping check(s) FAILED\n", failures);
+    return 1;
+  }
+  printf("\nAll azimuth wrapping checks passed.\n");
+  return 0;
+}
diff --git a/tests/examples/test_olr_interp_gains.c b/tests/examples/test_olr_interp_gains.c
new file mode 100644
index 0000000..59f170f
--- /dev/null
+++ b/tests/examples/test_olr_interp_gains.c
@@ -0,0 +1,245 @@
+/*
+ * Copyright (c) 2026, Alliance for Open Media. All rights reserved
+ *
+ * This source code is subject to the terms of the BSD 3-Clause Clear License
+ * and the Alliance for Open Media Patent License 1.0. If the BSD 3-Clause Clear
+ * License was not distributed with this source code in the LICENSE file, you
+ * can obtain it at www.aomedia.org/license/software-license/bsd-3-c-c. If the
+ * Alliance for Open Media Patent License 1.0 was not distributed with this
+ * source code in the PATENTS file, you can obtain it at
+ * www.aomedia.org/license/patent.
+ */
+
+/**
+ * @file test_olr_interp_gains.c
+ * @brief Test the OLR interpolated-gain processing block.
+ *
+ * Over a metadata block, OLR crossfades each output channel from the gain of
+ * the previous object position to the gain of the new one. oar_render()
+ * always processes a block in one window that covers it exactly, so these
+ * tests call the block directly to also reach windows that cover part of it,
+ * start before it or end after it.
+ *
+ * Test matrix:
+ *   TC1: A window covering the block produces the linear crossfade
+ *        gain_start * (1 - m / len) + gain_end * (m / len), summed over the
+ *        input channels.
+ *   TC2: Processing a sample range in one window, or split into windows of
+ *        1 to 300 samples, gives bit-identical output (random blocks and
+ *        splits, 1 to 3 input channels).
+ *   TC3: A window that does not overlap the block, and a zero-length block,
+ *        leave the output unchanged; a NULL start or end gain set leaves out
+ *        that half of the crossfade.
+ */
+
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "src/renderer/olr/object_audio_renderer/block_processor/processing_block.h"
+#include "test_framework.h"
+
+#define NUM_GAINS 3
+
+static uint64_t g_rng = 0x2545F4914F6CDD1DULL;
+
+static uint32_t rand_u32(void) {
+  g_rng = g_rng * 6364136223846793005ULL + 1442695040888963407ULL;
+  return (uint32_t)(g_rng >> 33);
+}
+
+/* Uniform in [-1, 1). */
+static float rand_float(void) {
+  return (float)rand_u32() / 1073741824.0f - 1.0f;
+}
+
+/* TC1: crossfade values over a window that covers the block. */
+static int test_crossfade_values(void) {
+  TEST_START("TC1: crossfade values");
+
+  const uint64_t start = 1000;
+  const int len = 480;
+  const int channels = 2;
+  auto_float_t gains_start[NUM_GAINS] = {1.0f, 0.0f, 0.5f};
+  auto_float_t gains_end[NUM_GAINS] = {0.0f, 1.0f, -0.25f};
+  float in[2 * 480];
+  float out[NUM_GAINS * 480];
+
+  /* Channel 0 is 1.0 and channel 1 is 0.5, so each output sample is 1.5
+   * times the crossfade gain. */
+  for (int m = 0; m < len; m++) {
+    in[m] = 1.0f;
+    in[len + m] = 0.5f;
+  }
+  memset(out, 0, sizeof(out));
+
+  processing_block_t *block = interp_gains_create(
+      start, start + (uint64_t)len, gains_start, gains_end, NUM_GAINS);
+  TEST_ASSERT(block != NULL, "interp_gains_create failed");
+  block->process(block, start, in, len, channels, out);
+  block->destroy(block);
+
+  for (int i = 0; i < NUM_GAINS; i++) {
+    for (int m = 0; m < len; m++) {
+      const double t = (double)m / len;
+      const double expected =
+          1.5 * (gains_start[i] * (1.0 - t) + gains_end[i] * t);
+      if (fabs(out[i * len + m] - expected) > 1e-6) {
+        fprintf(stderr, "gain set %d, sample %d: got %.9g, expected %.9g\n",
+                i, m, out[i * len + m], expected);
+        TEST_ASSERT(0, "crossfade value mismatch");
+      }
+    }
+  }
+  return TEST_PASS;
+}
+
+/* Runs one random block through a single window and through a random split,
+ * and compares the outputs bit for bit. The sample range starts up to 64
+ * samples before the block and ends up to 64 samples after it. Output
+ * samples are prefilled with the same random values in both runs, because
+ * the block adds into its output. */
+static int split_matches_single_window(void) {
+  const int len = 1 + (int)(rand_u32() % 2000);
+  const int channels = 1 + (int)(rand_u32() % 3);
+  const int pre = (int)(rand_u32() % 65);
+  const int post = (int)(rand_u32() % 65);
+  const uint64_t block_start = 100000 + rand_u32() % 100000;
+  const uint64_t range_start = block_start - (uint64_t)pre;
+  const int range = pre + len + post;
+  auto_float_t gains_start[NUM_GAINS], gains_end[NUM_GAINS];
+  int ok = 0;
+
+  for (int i = 0; i < NUM_GAINS; i++) {
+    gains_start[i] = rand_float();
+    gains_end[i] = rand_float();
+  }
+
+  float *in = malloc(sizeof(float) * channels * range);
+  float *prefill = malloc(sizeof(float) * NUM_GAINS * range);
+  float *whole = malloc(sizeof(float) * NUM_GAINS * range);
+  float *split = malloc(sizeof(float) * NUM_GAINS * range);
+  float *win_in = malloc(sizeof(float) * channels * 300);
+  float *win_out = malloc(sizeof(float) * NUM_GAINS * 300);
+  processing_block_t *block =
+      interp_gains_create(block_start, block_start + (uint64_t)len,
+                          gains_start, gains_end, NUM_GAINS);
+  if (!in || !prefill || !whole || !split || !win_in || !win_out || !block)
+    goto done;
+
+  for (int s = 0; s < channels * range; s++) in[s] = rand_float();
+  for (int s = 0; s < NUM_GAINS * range; s++) prefill[s] = rand_float();
+
+  memcpy(whole, prefill, sizeof(float) * NUM_GAINS * range);
+  block->process(block, range_start, in, range, channels, whole);
+
+  for (int w = 0; w < range;) {
+    int n = 1 + (int)(rand_u32() % 300);
+    if (n > range - w) n = range - w;
+    for (int k = 0; k < channels; k++)
+      memcpy(win_in + k * n, in + k * range + w, sizeof(float) * n);
+    for (int i = 0; i < NUM_GAINS; i++)
+      memcpy(win_out + i * n, prefill + i * range + w, sizeof(float) * n);
+    block->process(block, range_start + (uint64_t)w, win_in, n, channels,
+                   win_out);
+    for (int i = 0; i < NUM_GAINS; i++)
+      memcpy(split + i * range + w, win_out + i * n, sizeof(float) * n);
+    w += n;
+  }
+
+  ok = memcmp(whole, split, sizeof(float) * NUM_GAINS * range) == 0;
+  if (!ok)
+    fprintf(stderr,
+            "block of %d samples, %d before, %d after, %d channel(s): "
+            "split output differs\n",
+            len, pre, post, channels);
+
+done:
+  if (block) block->destroy(block);
+  free(in);
+  free(prefill);
+  free(whole);
+  free(split);
+  free(win_in);
+  free(win_out);
+  return ok;
+}
+
+/* TC2: one window and a random split give bit-identical output. */
+static int test_split_windows(void) {
+  TEST_START("TC2: split windows match one window");
+
+  for (int trial = 0; trial < 200; trial++)
+    TEST_ASSERT(split_matches_single_window(),
+                "split windows differ from one window");
+  return TEST_PASS;
+}
+
+/* TC3: no overlap, zero-length block, and NULL gain sets. */
+static int test_edges(void) {
+  TEST_START("TC3: no overlap, zero-length block, NULL gain sets");
+
+  const uint64_t start = 5000;
+  const int len = 64;
+  auto_float_t gains_start[NUM_GAINS] = {0.8f, -0.3f, 0.1f};
+  auto_float_t gains_end[NUM_GAINS] = {-0.2f, 0.6f, 1.0f};
+  float in[64];
+  float out[NUM_GAINS * 64], before[NUM_GAINS * 64];
+
+  for (int m = 0; m < len; m++) in[m] = 1.0f;
+  for (int s = 0; s < NUM_GAINS * len; s++) before[s] = rand_float();
+
+  /* Windows that end at the block start or start at the block end. */
+  processing_block_t *block = interp_gains_create(
+      start, start + (uint64_t)len, gains_start, gains_end, NUM_GAINS);
+  TEST_ASSERT(block != NULL, "interp_gains_create failed");
+  memcpy(out, before, sizeof(out));
+  block->process(block, start - (uint64_t)len, in, len, 1, out);
+  block->process(block, start + (uint64_t)len, in, len, 1, out);
+  block->destroy(block);
+  TEST_ASSERT(memcmp(out, before, sizeof(out)) == 0,
+              "a window outside the block changed the output");
+
+  /* A zero-length block has no interpolation table and adds nothing. */
+  block = interp_gains_create(start, start, gains_start, gains_end, NUM_GAINS);
+  TEST_ASSERT(block != NULL, "interp_gains_create failed");
+  memcpy(out, before, sizeof(out));
+  block->process(block, start, in, len, 1, out);
+  block->destroy(block);
+  TEST_ASSERT(memcmp(out, before, sizeof(out)) == 0,
+              "a zero-length block changed the output");
+
+  /* NULL start gains: fade in from silence. NULL end gains: fade out. */
+  for (int null_start = 0; null_start < 2; null_start++) {
+    block = interp_gains_create(start, start + (uint64_t)len,
+                                null_start ? NULL : gains_start,
+                                null_start ? gains_end : NULL, NUM_GAINS);
+    TEST_ASSERT(block != NULL, "interp_gains_create failed");
+    memset(out, 0, sizeof(out));
+    block->process(block, start, in, len, 1, out);
+    block->destroy(block);
+    for (int i = 0; i < NUM_GAINS; i++) {
+      for (int m = 0; m < len; m++) {
+        const double t = (double)m / len;
+        const double expected =
+            null_start ? gains_end[i] * t : gains_start[i] * (1.0 - t);
+        TEST_ASSERT(fabs(out[i * len + m] - expected) <= 1e-6,
+                    "single-sided crossfade value mismatch");
+      }
+    }
+  }
+  return TEST_PASS;
+}
+
+static test_entry_t g_tests[] = {
+    TEST_ENTRY("TC1", "crossfade values", test_crossfade_values),
+    TEST_ENTRY("TC2", "split windows match one window", test_split_windows),
+    TEST_ENTRY("TC3", "no overlap, zero-length block, NULL gain sets",
+               test_edges),
+};
+
+int main(int argc, char *argv[]) {
+  return run_all_tests(g_tests, NUM_TESTS(g_tests), argc, argv);
+}
diff --git a/tests/examples/test_position_conversion.c b/tests/examples/test_position_conversion.c
new file mode 100644
index 0000000..c3fa46a
--- /dev/null
+++ b/tests/examples/test_position_conversion.c
@@ -0,0 +1,787 @@
+/*
+ * Copyright (c) 2026, Alliance for Open Media. All rights reserved
+ *
+ * This source code is subject to the terms of the BSD 3-Clause Clear License
+ * and the Alliance for Open Media Patent License 1.0. If the BSD 3-Clause Clear
+ * License was not distributed with this source code in the LICENSE file, you
+ * can obtain it at www.aomedia.org/license/software-license/bsd-3-c-c. If the
+ * Alliance for Open Media Patent License 1.0 was not distributed with this
+ * source code in the PATENTS file, you can obtain it at
+ * www.aomedia.org/license/patent.
+ */
+
+/*
+ * Tests for the layout-anchored cartesian->polar position conversion
+ * (ck_oar_pos_conv_layout).
+ *
+ * 1. The anchor rings derived from the OLR speaker tables must equal the
+ *    constants validated by the pan-law study (panlab) for all nine study
+ *    layouts — this pins the derivation rules (snap table, ring clustering,
+ *    completion) to the study's ground truth.
+ * 2. On layouts whose derived rings equal the fixed BS.2127 section 10
+ *    table and which have no top ring (stereo, 5.1), the anchored
+ *    conversion must be BIT-identical to cartesian_to_polar_sector_float32.
+ * 3. Against a reference dump generated from panlab-core.js (double
+ *    precision) the float32 port must agree within tolerance on a room-cube
+ *    grid for all nine study layouts.
+ * 4. The default mode must be bit-identical to never touching the mode API
+ *    (rendered output compared), and the mode setter/getter must behave.
+ * 5. In layout mode on 7.1.4, room-cube corners must pin to the real
+ *    corner speakers (the point of the whole exercise).
+ * 6. The standalone public conversion API (oar_position_anchors_create /
+ *    oar_cartesian_to_polar) must be bit-identical
+ *    to the internal conversion in every mode, and feeding its polar
+ *    output back as polar metadata must render bit-identically to
+ *    letting the renderer convert the cartesian position itself.
+ */
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+#include "oar.h"
+#include "oar_utils.h"
+#include "position_conversion.h"
+#include "test_position_conversion_reference.h"
+
+#define SAMPLES_PER_CHANNEL 256
+#define SAMPLE_RATE 48000
+
+/* ---- 1. derived rings vs panlab constants ------------------------------ */
+
+typedef struct {
+  float az, x, y;
+} expected_anchor_t;
+
+#define WIDE_Y 0.414214f
+
+static const expected_anchor_t kAnchorsStd[] = {
