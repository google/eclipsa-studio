+/*
+ * Room-cube convention with corner snapping: canonical speaker
+ * azimuths map to the cube walls and corners the way every validated
+ * layout places them (fronts and 45-degree tops to the front corners,
+ * wides to the side wall at y = 0.414, sides mid-wall, surrounds and
+ * rears to the rear corners); anything else falls back to the generic
+ * mapping above.
+ */
+static int _ring_add_speaker(position_anchor_ring_t *ring, float az) {
+  float a = fabsf(az);
+  float x, y;
+
+  if (a < 0.5f) {
+    x = 0.f;
+    y = 1.f;
+  } else if (fabsf(a - 180.f) < 0.5f) {
+    x = 0.f;
+    y = -1.f;
+  } else if (fabsf(a - 30.f) < 0.5f || fabsf(a - 45.f) < 0.5f) {
+    x = 1.f;
+    y = 1.f;
+  } else if (fabsf(a - 60.f) < 0.5f) {
+    x = 1.f;
+    y = def_pos_conv_wide_y;
+  } else if (fabsf(a - 90.f) < 0.5f) {
+    x = 1.f;
+    y = 0.f;
+  } else if (fabsf(a - 110.f) < 0.5f || fabsf(a - 135.f) < 0.5f) {
+    x = 1.f;
+    y = -1.f;
+  } else {
+    _az_to_wall_point(az, &x, &y);
+    return _ring_add(ring, az, x, y);
+  }
+
+  /* The table above is right-side (negative azimuth); mirror for left. */
+  if (az > 0.f) x = -x;
+  return _ring_add(ring, az, x, y);
+}
+
+/*
+ * Ring completion: a ring that does not close behind the listener gets
+ * phantom rear-corner anchors keyed off its front-pair azimuth (fronts
+ * at +-45 pair with +-135 rears, fronts at +-30 with the standard
+ * +-110 surround corners, which is also the fallback). The mid ring
+ * additionally gets a front-centre anchor when the layout has no
+ * centre speaker (stereo), reproducing the fixed table exactly.
+ */
+static void _ring_complete(position_anchor_ring_t *ring, int is_mid) {
+  int has_rear = 0, has_center = 0;
+  float front_az = 0.f;
+
+  if (!ring->num_anchors) return;
+
+  for (int i = 0; i < ring->num_anchors; i++) {
+    float az = ring->anchors[i].azimuth;
+    if (fabsf(az) > 90.5f) has_rear = 1;
+    if (fabsf(az) < 0.5f) has_center = 1;
+    if (az > 0.5f && az < 89.5f && (front_az == 0.f || az < front_az))
+      front_az = az;
+  }
+
+  if (is_mid && !has_center) _ring_add(ring, 0.f, 0.f, 1.f);
+
+  if (!has_rear) {
+    float rear_az = front_az >= 37.5f ? 135.f : 110.f;
+    _ring_add(ring, rear_az, -1.f, -1.f);
+    _ring_add(ring, -rear_az, 1.f, -1.f);
+  }
+}
+
+/*
+ * Order anchors clockwise (descending azimuth), rotated to start at
+ * the smallest-magnitude azimuth. For a ring equal to the fixed table
+ * this reproduces its exact anchor order, so positions lying exactly
+ * on an anchor direction resolve through the same sector as in
+ * cartesian_to_polar_sector_float32() (the sector ranges are inclusive
+ * at both ends, so the first match wins).
+ */
+static void _ring_sort(position_anchor_ring_t *ring) {
+  int n = ring->num_anchors;
+  position_anchor_t tmp[def_pos_conv_max_anchors];
+  int start = 0;
+
+  for (int i = 1; i < n; i++) {
+    position_anchor_t key = ring->anchors[i];
+    int j = i - 1;
+    while (j >= 0 && ring->anchors[j].azimuth < key.azimuth) {
+      ring->anchors[j + 1] = ring->anchors[j];
+      j--;
+    }
+    ring->anchors[j + 1] = key;
+  }
+
+  for (int i = 1; i < n; i++)
+    if (fabsf(ring->anchors[i].azimuth) < fabsf(ring->anchors[start].azimuth))
+      start = i;
+
+  memcpy(tmp, ring->anchors, n * sizeof(tmp[0]));
+  for (int i = 0; i < n; i++) ring->anchors[i] = tmp[(start + i) % n];
+}
+
+int position_conversion_anchors_derive(
+    rid_t out, position_conversion_anchors_t *anchors) {
+  memset(anchors, 0, sizeof(*anchors));
+
+  if (out == ck_rio_id_binaural || out == ck_rio_id_mono) {
+    anchors->balloon = 1;
+    anchors->valid = 1;
+    return ck_oar_ok;
+  }
+
+  olr_layout_t olr_layout = olr_layout_from_rid(out);
+  if (olr_layout == ck_olr_layout_none) return ck_oar_error_notsup;
+
+  const speaker_layout_t *layout = get_layout(olr_layout);
+  if (!layout) return ck_oar_error_notsup;
+
+  for (int i = 0; i < layout->num_speakers; i++) {
+    speaker_position_t *sp = layout->speakers[i];
+    float az = (float)sp->azimuth;
+    float el = (float)sp->elevation;
+    position_anchor_ring_t *ring;
+
+    if (sp->is_lfe) continue;
+    if (fabsf(el) > 85.f) continue; /* zenith/nadir carry no azimuth */
+
+    ring = fabsf(el) <= 5.f ? &anchors->mid
+           : el > 0.f      ? &anchors->top
+                           : &anchors->bottom;
+    if (_ring_add_speaker(ring, az) != ck_oar_ok) return ck_oar_error_inval;
+  }
+
+  _ring_complete(&anchors->mid, 1);
+  _ring_complete(&anchors->top, 0);
+  _ring_complete(&anchors->bottom, 0);
+  _ring_sort(&anchors->mid);
+  _ring_sort(&anchors->top);
+  _ring_sort(&anchors->bottom);
+
+  /* A ring needs to close around the listener to define sectors. */
+  if (anchors->top.num_anchors < 3) anchors->top.num_anchors = 0;
+  if (anchors->bottom.num_anchors < 3) anchors->bottom.num_anchors = 0;
+  if (anchors->mid.num_anchors < 3) return ck_oar_error_inval;
+
+  anchors->valid = 1;
+  return ck_oar_ok;
+}
+
+/* ---- conversion -------------------------------------------------------- */
+
+static int _ring_find_sector(const position_anchor_ring_t *ring, float az,
+                             int *left_idx, int *right_idx) {
+  for (int i = 0; i < ring->num_anchors; i++) {
+    int j = (i + 1) % ring->num_anchors;
+    if (_inside_angle_range(az, _azimuth(ring->anchors[j].position),
+                            _azimuth(ring->anchors[i].position), 0.0f)) {
+      *left_idx = i;
+      *right_idx = j;
+      return 0;
+    }
+  }
+  return ck_oar_error_inval;
+}
+
+/*
+ * Sector azimuth solve for one ring; mirrors the corresponding steps
+ * of cartesian_to_polar_sector_float32() exactly. Returns nonzero when
+ * the position projects to (or through) the listener in this ring's
+ * plane, in which case *out_az / *out_r_xy are unset.
+ */
+static int _ring_sector_azimuth(const position_anchor_ring_t *ring,
+                                cartesian_t pos, float *out_az,
+                                float *out_r_xy) {
+  float az_val;
+  int left_idx = 0, right_idx = 1;
+  float _2x2[4], _2x2_inv[4];
+  float g_lr[2];
+  float _xy[2];
+
+  az_val = _azimuth(pos);
+
+  _ring_find_sector(ring, az_val, &left_idx, &right_idx);
+
+  float left_az = ring->anchors[left_idx].azimuth;
+  float right_az = ring->anchors[right_idx].azimuth;
+  const cartesian_t *left_pos = &ring->anchors[left_idx].position;
+  const cartesian_t *right_pos = &ring->anchors[right_idx].position;
+
+  _2x2[0] = left_pos->x;
+  _2x2[1] = left_pos->y;
+  _2x2[2] = right_pos->x;
+  _2x2[3] = right_pos->y;
+
+  _xy[0] = pos.x;
+  _xy[1] = pos.y;
+
+  /* Derived rings are data-driven; a degenerate sector (two anchors on
+   * the same wall point) must fail the solve, not read uninitialized
+   * memory. Cannot happen with the fixed table, so this adds no float
+   * operations to the bit-exact path. */
+  if (_linalg_inv_2x2(_2x2, _2x2_inv) != 0) return ck_oar_error_inval;
+  _dot_n_nxn(_xy, _2x2_inv, 2, g_lr);
+
+  float r_xy = g_lr[0] + g_lr[1];
+  if (fabs(r_xy) < def_eps) return ck_oar_error_inval;
+
+  float rel_left_az = _relative_angle(right_az, left_az);
+  float az = _map_linear_to_az(rel_left_az, right_az, g_lr[1] / r_xy);
+  *out_az = _relative_angle(-180.0f, az);
+  *out_r_xy = r_xy;
+  return 0;
+}
+
+static polar_t _cartesian_to_polar_balloon(cartesian_t cartesian) {
+  float d = fmaxf(fabsf(cartesian.x),
+                  fmaxf(fabsf(cartesian.y), fabsf(cartesian.z)));
+  float az = fabsf(cartesian.x) < def_eps && fabsf(cartesian.y) < def_eps
+                 ? 0.0f
+                 : -def_radians_to_degrees(atan2f(cartesian.x, cartesian.y));
+  float el = def_radians_to_degrees(
+      atan2f(cartesian.z, hypotf(cartesian.x, cartesian.y)));
+  return def_polar_instance(az, el, d);
+}
+
+#define def_elevation_top 30.f
+#define def_elevation_top_tilde 45.f
+
+polar_t cartesian_to_polar_anchored(
+    const position_conversion_anchors_t *anchors, cartesian_t cartesian) {
+  cartesian_t pos = def_cartesian_instance(cartesian.x, cartesian.y, 0.0f);
+  float az, r_xy;
+
+  if (anchors->balloon) return _cartesian_to_polar_balloon(cartesian);
+
+  if (fabsf(cartesian.x) < def_eps && fabsf(cartesian.y) < def_eps) {
+    if (fabsf(cartesian.z) < 1e-10)
+      return def_polar_instance(0.0, 0.0, 0.0);
+    else
+      return def_polar_instance(0.0, _sign(cartesian.z) * 90.0,
+                                fabsf(cartesian.z));
+  }
+
+  if (_ring_sector_azimuth(&anchors->mid, pos, &az, &r_xy) != 0)
+    return def_polar_instance(
+        0.f, 0.f,
+        sqrtf(cartesian.x * cartesian.x + cartesian.y * cartesian.y +
+              cartesian.z * cartesian.z));
+
+  /*
+   * Per-ring height blend: above ear level the azimuth glides from the
+   * mid-ring map to the top ring's own anchor map (and mirrored below
+   * for layouts that have bottom speakers), along the shortest circular
+   * path, so cube features pin to the real speakers of each ring.
+   * Layouts without the relevant ring keep the mid map, like the fixed
+   * table does.
+   */
+  const position_anchor_ring_t *blend_ring =
+      cartesian.z > 0.f ? &anchors->top
+      : cartesian.z < 0.f ? &anchors->bottom
+                          : 0;
+  if (blend_ring && blend_ring->num_anchors) {
+    float az_ring, r_ring;
+    if (_ring_sector_azimuth(blend_ring, pos, &az_ring, &r_ring) == 0) {
+      float t = fabsf(cartesian.z);
+      if (t > 1.f) t = 1.f;
+      float d_az = _relative_angle(-180.0f, az_ring - az);
+      az = _relative_angle(-180.0f, az + t * d_az);
+    }
+  }
+
+  float el_tilde = def_radians_to_degrees(atanf(cartesian.z / r_xy));
+
+  float el, d;
+  if (fabsf(el_tilde) > def_elevation_top_tilde) {
+    float abs_el =
+        def_elevation_top + (90.0f - def_elevation_top) *
+                                (fabsf(el_tilde) - def_elevation_top_tilde) /
+                                (90.0f - def_elevation_top_tilde);
+    el = _sign(el_tilde) * abs_el;
+    d = fabsf(cartesian.z);
+  } else {
+    el = def_elevation_top * el_tilde / def_elevation_top_tilde;
+    d = r_xy;
+  }
+
+  return def_polar_instance(az, el, d);
+}
+
+/* ---- shared dispatch --------------------------------------------------- */
+
+int position_conversion_anchors_derive_layout(
+    oar_layout_t layout, position_conversion_anchors_t *anchors) {
+  ro_id_t out = layout_to_ro_id(layout);
+  if (out == ck_rid_none) {
+    memset(anchors, 0, sizeof(*anchors));
+    return ck_oar_error_notsup;
+  }
+  return position_conversion_anchors_derive(out, anchors);
+}
+
+polar_t position_conversion_convert(
+    const position_conversion_anchors_t *anchors,
+    oar_position_conversion_t mode, cartesian_t cartesian) {
+  if (mode != ck_oar_pos_conv_layout || !anchors || !anchors->valid)
+    return cartesian_to_polar_sector_float32(cartesian);
+  return cartesian_to_polar_anchored(anchors, cartesian);
+}
+
+/* ---- public standalone conversion (include/oar.h) ---------------------- */
+
+struct OarPositionAnchors {
+  position_conversion_anchors_t anchors;
+};
+
+oar_position_anchors_t *oar_position_anchors_create(oar_layout_t layout) {
+  oar_position_anchors_t *handle = def_mallocz(oar_position_anchors_t, 1);
+  if (!handle) return NULL;
+
+  if (position_conversion_anchors_derive_layout(layout, &handle->anchors) !=
+      ck_oar_ok) {
+    def_free(handle);
+    return NULL;
+  }
+  return handle;
+}
+
+void oar_position_anchors_destroy(oar_position_anchors_t *anchors) {
+  def_free(anchors);
+}
+
+polar_t oar_cartesian_to_polar(const oar_position_anchors_t *anchors,
+                               oar_position_conversion_t mode,
+                               cartesian_t position) {
+  /* NULL in layout mode deliberately selects the balloon conversion, for
+   * hosts converting outside a render loop; every other combination goes
+   * through the dispatcher shared with the renderer base. */
+  if (mode == ck_oar_pos_conv_layout && !anchors)
+    return _cartesian_to_polar_balloon(position);
+  return position_conversion_convert(anchors ? &anchors->anchors : NULL, mode,
+                                     position);
+}
