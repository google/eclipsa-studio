load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")

package(default_visibility = ["//visibility:public"])

# Prebuilt libgpac (GPAC, LGPL-2.1-or-later), linked DYNAMICALLY. The
# .dylib/.dll and the gpac/ headers under include/ are NOT checked in —
# they are produced by build_gpac.sh (macOS) / build_gpac.ps1 (Windows), a
# clean `--static-bin --use-curl=no` build so the library carries no
# FFmpeg/curl/OpenSSL dependency, and land in lib/ and include/. See
# README.md for the recipe and the licensing rationale (dynamic link mirrors
# the app's existing media_kit LGPL posture; the engine's static link stays
# permissive-only).
#
# Windows needs BOTH the .dll (shared_library, loaded at runtime) and an
# MSVC import .lib (interface_library, linked against) — a Unix .dylib/.so
# is self-describing and needs neither. Split into per-OS cc_import targets
# because interface_library only applies on Windows; the wrapper below
# selects the right one.
cc_import(
    name = "gpac_imported_unix",
    shared_library = select({
        "@platforms//os:osx": "lib/libgpac.dylib",
        "//conditions:default": "lib/libgpac.so",
    }),
)

cc_import(
    name = "gpac_imported_windows",
    interface_library = "lib/gpac.lib",
    shared_library = "lib/libgpac.dll",
)

# Wrapper carrying the public headers + include path (cc_import does not
# propagate `includes` to dependents; cc_library does).
#
# GPAC's setup.h gates its entire Windows platform block on `WIN32` (not the
# compiler's `_WIN32`) and never normalizes one to the other, so under MSVC
# it falls through to the POSIX path and pulls in <unistd.h>. GPAC expects
# the consumer's build system to define WIN32 on Windows; `defines` here
# propagates it to dependents that include the headers (the muxer).
cc_library(
    name = "libgpac",
    hdrs = glob(["include/gpac/**/*.h"]),
    defines = select({
        "@platforms//os:windows": ["WIN32"],
        "//conditions:default": [],
    }),
    includes = ["include"],
    deps = select({
        "@platforms//os:windows": [":gpac_imported_windows"],
        "//conditions:default": [":gpac_imported_unix"],
    }),
)
