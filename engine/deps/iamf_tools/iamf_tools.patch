+std::string AnimationTypeName(pb::AnimationType t) {
+  switch (t) {
+    case pb::ANIMATE_STEP:
+      return "step";
+    case pb::ANIMATE_LINEAR:
+      return "linear";
+    case pb::ANIMATE_BEZIER:
+      return "bezier";
+    default:
+      return "invalid";
+  }
+}
+
+std::string DMixPModeName(pb::DMixPMode m) {
+  switch (m) {
+    case pb::DMIXP_MODE_1:
+      return "mode1";
+    case pb::DMIXP_MODE_2:
+      return "mode2";
+    case pb::DMIXP_MODE_3:
+      return "mode3";
+    case pb::DMIXP_MODE_1_N:
+      return "mode1_n";
+    case pb::DMIXP_MODE_2_N:
+      return "mode2_n";
+    case pb::DMIXP_MODE_3_N:
+      return "mode3_n";
+    case pb::DMIXP_MODE_RESERVED_A:
+      return "reserved_1";
+    case pb::DMIXP_MODE_RESERVED_B:
+      return "reserved_2";
+    default:
+      return "invalid";
+  }
+}
+
+// Compares the `parameter_block_metadata` entries in `ref` against the scan's
+// `parameter_blocks`. The encoder partitions a single textproto entry into
+// many physical parameter blocks to align with audio frames, so we cannot
+// compare 1:1 by index. Instead:
+//   - Assert every `parameter_id` present in the textproto is also present in
+//     the scan (and vice versa).
+//   - Per `parameter_id`, assert the set of animation types / demixing modes /
+//     recon-gain layer counts observed in the scan is a subset of what the
+//     textproto specified.
+void CompareParameterBlocks(const pb::UserMetadata& ref,
+                            const iamf_tools::TemporalUnitScanReport& scan,
+                            std::vector<Mismatch>* m) {
+  // ref signatures per parameter_id:
+  //   mix-gain -> set of animation type names
+  //   demixing -> set of dmixp mode names
+  //   recon-gain -> set of "present layer counts" (int -> string)
+  std::map<uint32_t, std::set<std::string>> ref_mix_gain_types;
+  std::map<uint32_t, std::set<std::string>> ref_dmixp_modes;
+  std::map<uint32_t, std::set<std::string>> ref_recon_layer_counts;
+  for (int i = 0; i < ref.parameter_block_metadata_size(); ++i) {
+    const auto& rpb = ref.parameter_block_metadata(i);
+    for (int j = 0; j < rpb.subblocks_size(); ++j) {
+      const auto& rsb = rpb.subblocks(j);
+      if (rsb.has_mix_gain_parameter_data()) {
+        ref_mix_gain_types[rpb.parameter_id()].insert(
+            AnimationTypeName(rsb.mix_gain_parameter_data().animation_type()));
+      } else if (rsb.has_demixing_info_parameter_data()) {
+        ref_dmixp_modes[rpb.parameter_id()].insert(
+            DMixPModeName(rsb.demixing_info_parameter_data().dmixp_mode()));
+      } else if (rsb.has_recon_gain_info_parameter_data()) {
+        int present = 0;
+        for (int li = 0;
+             li <
+             rsb.recon_gain_info_parameter_data().recon_gains_for_layer_size();
+             ++li) {
+          if (!rsb.recon_gain_info_parameter_data()
+                   .recon_gains_for_layer(li)
+                   .recon_gain()
+                   .empty()) {
+            ++present;
+          }
+        }
+        ref_recon_layer_counts[rpb.parameter_id()].insert(
+            absl::StrCat(present));
+      }
+    }
+  }
+
+  // scan signatures per parameter_id.
+  std::map<uint32_t, std::set<std::string>> scan_mix_gain_types;
+  std::map<uint32_t, std::set<std::string>> scan_dmixp_modes;
+  std::map<uint32_t, std::set<std::string>> scan_recon_layer_counts;
+  for (const auto& b : scan.parameter_blocks) {
+    for (const auto& sub : b.subblocks) {
+      if (sub.mix_gain.has_value()) {
+        scan_mix_gain_types[b.parameter_id].insert(
+            sub.mix_gain->animation_type);
+      }
+      if (sub.demixing.has_value()) {
+        scan_dmixp_modes[b.parameter_id].insert(sub.demixing->dmixp_mode);
+      }
+      if (sub.recon_gain.has_value()) {
+        scan_recon_layer_counts[b.parameter_id].insert(
+            absl::StrCat(sub.recon_gain->layers.size()));
+      }
+    }
+  }
+
+  auto compare_sets = [&](const char* kind,
+                          const std::map<uint32_t, std::set<std::string>>& r,
+                          const std::map<uint32_t, std::set<std::string>>& g) {
+    for (const auto& [pid, types] : r) {
+      auto it = g.find(pid);
+      if (it == g.end()) {
+        m->push_back({absl::StrCat("parameter_block[id=", pid, "].", kind),
+                      "<present>", "<missing>"});
+        continue;
+      }
+      const std::string expected = absl::StrJoin(types, ",");
+      const std::string actual = absl::StrJoin(it->second, ",");
+      Check<std::string>(absl::StrCat("parameter_block[id=", pid, "].", kind),
+                         expected, actual, m);
+    }
+  };
+  compare_sets("mix_gain.animation_types", ref_mix_gain_types,
+               scan_mix_gain_types);
+  compare_sets("demixing.dmixp_modes", ref_dmixp_modes, scan_dmixp_modes);
+  compare_sets("recon_gain.layer_counts", ref_recon_layer_counts,
+               scan_recon_layer_counts);
+}
+
+void CompareMixPresentations(const pb::UserMetadata& ref,
+                             const iamf_tools::ProbeReport& got,
+                             std::vector<Mismatch>* m) {
+  if (ref.mix_presentation_metadata_size() !=
+      static_cast<int>(got.mix_presentations.size())) {
+    m->push_back({"mix_presentations.size",
+                  absl::StrCat(ref.mix_presentation_metadata_size()),
+                  absl::StrCat(got.mix_presentations.size())});
+    return;
+  }
+  for (int i = 0; i < ref.mix_presentation_metadata_size(); ++i) {
+    const auto& r = ref.mix_presentation_metadata(i);
+    const iamf_tools::MixPresentationReport* actual = nullptr;
+    for (const auto& mp : got.mix_presentations) {
+      if (mp.id == r.mix_presentation_id()) {
+        actual = &mp;
+        break;
+      }
+    }
+    if (actual == nullptr) {
+      m->push_back(
+          {absl::StrCat("mix_presentation[", r.mix_presentation_id(), "]"),
+           "<present>", "<missing>"});
+      continue;
+    }
+    const std::string prefix =
+        absl::StrCat("mix_presentation[", r.mix_presentation_id(), "].");
+    Check<int>(prefix + "sub_mixes.size", r.sub_mixes_size(),
+               actual->num_sub_mixes, m);
+    Check<int>(prefix + "annotations_language.size",
+               r.annotations_language_size(),
+               static_cast<int>(actual->count_label), m);
+  }
+}
+
+absl::Status Verify(const std::string& textproto_path,
+                    const iamf_tools::ProbeReport& r) {
+  std::ifstream in(textproto_path);
+  if (!in) {
+    return absl::NotFoundError(
+        absl::StrCat("Unable to open reference textproto: ", textproto_path,
+                     ": ", std::strerror(errno)));
+  }
+  std::stringstream buf;
+  buf << in.rdbuf();
+  if (in.bad()) {
+    return absl::DataLossError(
+        absl::StrCat("Read of reference textproto failed: ", textproto_path,
+                     ": ", std::strerror(errno)));
+  }
+  pb::UserMetadata ref;
+  if (!google::protobuf::TextFormat::ParseFromString(buf.str(), &ref)) {
+    return absl::InvalidArgumentError(
+        absl::StrCat("Failed to parse textproto: ", textproto_path));
+  }
+
+  std::vector<Mismatch> mismatches;
+  if (ref.ia_sequence_header_metadata_size() > 0) {
+    const auto& ia = ref.ia_sequence_header_metadata(0);
+    Check<std::string>(
+        "ia_sequence_header.primary_profile",
+        pb::ProfileVersion_Name(ia.primary_profile()),
+        pb::ProfileVersion_Name(ToProfileVersion(r.primary_profile)),
+        &mismatches);
+    Check<std::string>(
+        "ia_sequence_header.additional_profile",
+        pb::ProfileVersion_Name(ia.additional_profile()),
+        pb::ProfileVersion_Name(ToProfileVersion(r.additional_profile)),
+        &mismatches);
+  }
+  CompareCodecConfigs(ref, r, &mismatches);
+  CompareAudioElements(ref, r, &mismatches);
+  CompareMixPresentations(ref, r, &mismatches);
+  if (r.temporal_unit_scan.has_value() &&
+      ref.parameter_block_metadata_size() > 0) {
+    CompareParameterBlocks(ref, *r.temporal_unit_scan, &mismatches);
+  }
+
+  if (mismatches.empty()) {
+    std::fputs("OK: probe matches reference textproto (0 mismatches).\n",
+               stdout);
+    return absl::OkStatus();
+  }
+  std::fprintf(stdout, "FAIL: %zu mismatch(es):\n", mismatches.size());
+  for (const auto& mm : mismatches) {
+    std::fprintf(stdout, "  - %s: expected=%s actual=%s\n", mm.field.c_str(),
+                 mm.expected.c_str(), mm.actual.c_str());
+  }
+  return absl::FailedPreconditionError(
+      absl::StrCat(mismatches.size(), " field mismatch(es)"));
+}
