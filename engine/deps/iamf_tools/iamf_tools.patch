+ *
+ * This source code is subject to the terms of the BSD 3-Clause Clear License
+ * and the Alliance for Open Media Patent License 1.0. If the BSD 3-Clause Clear
+ * License was not distributed with this source code in the LICENSE file, you
+ * can obtain it at www.aomedia.org/license/software-license/bsd-3-c-c. If the
+ * Alliance for Open Media Patent License 1.0 was not distributed with this
+ * source code in the PATENTS file, you can obtain it at
+ * www.aomedia.org/license/patent.
+ */
+
+#ifndef INCLUDE_IAMF_TOOLS_IAMF_STREAM_FACTORY_H_
+#define INCLUDE_IAMF_TOOLS_IAMF_STREAM_FACTORY_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+
+#include "iamf_stream_interface.h"
+#include "iamf_stream_settings.h"
+#include "iamf_tools_api_types.h"
+
+namespace iamf_tools {
+namespace api {
+
+/*!\brief Factory functions for creating `IamfStreamInterface` instances. */
+class IamfStreamFactory {
+ public:
+  // Settings live in their own header (`iamf_stream_settings.h`) so the
+  // `IamfStream` impl can read them without forming a Bazel cycle through
+  // this factory header. Exposed here under the original
+  // `IamfStreamFactory::Settings` name for backwards compatibility.
+  using Settings = IamfStreamSettings;
+
+  /*!\brief Opens a raw IAMF byte buffer for per-AE streaming pull.
+   *
+   * The caller must keep `bytes` valid and unmodified for the lifetime of
+   * the returned stream — the implementation reads from it on every
+   * `NextTemporalUnit` / `Seek` call and never copies the full buffer.
+   * `mmap` is the intended usage.
+   *
+   * On success returns a non-null `std::unique_ptr` and writes
+   * `IamfStatus::OkStatus()` to `out_status`.
+   *
+   * On failure returns `nullptr` and writes a non-ok `IamfStatus` to
+   * `out_status` with one of these message prefixes:
+   *   - "malformed:"       — bytes are not a valid IAMF stream.
+   *   - "io:"              — bytes are truncated in the descriptor region.
+   *   - "unsupported:"     — the stream is valid but uses a profile, codec,
+   *                           or layout this build cannot decode.
+   *   - "invalid_argument:" — `bytes == nullptr` or `len == 0`.
+   *
+   * If the stream parses but contains individual Audio Elements that this
+   * build cannot decode, `OpenFromBytes` **succeeds**; the unsupported AEs
+   * are exposed via `GetAudioElement` with `supported = false`. The stream
+   * only refuses pumping in that case when `NextTemporalUnit` is called
+   * (see `IamfStreamInterface::NextTemporalUnit`). This lets the caller
+   * inspect descriptors and surface a clear error before pumping.
+   *
+   * \param bytes Pointer to the IAMF byte buffer. Must remain valid for
+   *        the lifetime of the returned stream.
+   * \param len Size in bytes of the buffer.
+   * \param settings Open-time options (`iamf_stream_settings.h`). Pass `{}`
+   *        for the eager defaults; set `lazy_temporal_unit_scan` to run the
+   *        temporal-unit scan on a worker thread instead of blocking here.
+   * \param out_stream Receives the opened stream on success, or is reset to
+   *        nullptr on failure.
+   * \return `IamfStatus::OkStatus()` on success, else a non-ok status with
+   *         one of the prefixes described above.
+   */
+  static IamfStatus OpenFromBytes(
+      const uint8_t* bytes, size_t len, const Settings& settings,
+      std::unique_ptr<IamfStreamInterface>& out_stream);
+};
+
+}  // namespace api
+}  // namespace iamf_tools
+
+#endif  // INCLUDE_IAMF_TOOLS_IAMF_STREAM_FACTORY_H_
