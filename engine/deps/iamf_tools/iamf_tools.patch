+#include "iamf/cli/channel_label.h"
+#include "iamf/cli/demixing_manager.h"
+#include "iamf/cli/obu_processor.h"
+#include "iamf/cli/probe.h"
+#include "iamf/common/read_bit_buffer.h"
+#include "iamf/include/iamf_tools/iamf_stream_interface.h"
+#include "iamf/include/iamf_tools/iamf_stream_settings.h"
+#include "iamf/include/iamf_tools/iamf_tools_api_types.h"
+#include "iamf/obu/types.h"
+
+namespace iamf_tools {
+namespace api {
+
+/*!\brief Internal implementation of `IamfStreamInterface`.
+ *
+ * !WARNING! Do not depend on this class directly. Consumers should use
+ * `IamfStreamFactory::OpenFromBytes` which returns a
+ * `std::unique_ptr<IamfStreamInterface>`.
+ */
+class IamfStream : public IamfStreamInterface {
+ public:
+  // Creates an `IamfStream` from a raw byte buffer. On success returns
+  // `IamfStatus::OkStatus()` and writes the opened stream to `out_stream`.
+  // On failure returns a non-ok status and resets `out_stream` to nullptr.
+  //
+  // `bytes` must remain valid for the lifetime of the returned stream.
+  // `settings.lazy_temporal_unit_scan` controls whether the temporal-unit
+  // scan runs synchronously or on a background thread (see
+  // `IamfStreamFactory::Settings`).
+  static IamfStatus OpenFromBytes(const uint8_t* bytes, size_t len,
+                                  const IamfStreamSettings& settings,
+                                  std::unique_ptr<IamfStream>& out_stream);
+
+  // Backwards-compatible overload that opens with default settings (eager
+  // scan). Used by direct (non-factory) tests under `iamf/api/stream/tests`.
+  static IamfStatus OpenFromBytes(const uint8_t* bytes, size_t len,
+                                  std::unique_ptr<IamfStream>& out_stream) {
+    return OpenFromBytes(bytes, len, IamfStreamSettings{}, out_stream);
+  }
+
+  ~IamfStream() override;
+  IamfStream(const IamfStream&) = delete;
+  IamfStream& operator=(const IamfStream&) = delete;
+
+  // IamfStreamInterface overrides.
+  uint32_t GetSampleRate() const override;
+  uint32_t GetFrameSize() const override;
+  uint64_t GetTotalSamples() const override;
+  bool IsTotalSamplesReady() const override;
+  bool IsScanComplete() const override;
+  IamfStatus WaitForScanComplete(absl::Duration timeout) const override;
+  uint32_t GetNumAudioElements() const override;
+  AudioElementDescriptor GetAudioElement(uint32_t index) const override;
+  IamfStatus NextTemporalUnit(TemporalUnitOutput& out) override;
+  IamfStatus Seek(uint64_t sample_pos) override;
+  const char* GetLastError() const override;
+
+ private:
+  // Lifecycle of the temporal-unit scan. Eager mode flips straight to
+  // `kComplete` inside `OpenFromBytes`; lazy mode publishes `kRunning` after
+  // spawning the worker, then `kComplete` (or `kFailed`) when the worker
+  // finishes.
+  enum class ScanState : uint8_t { kPending, kRunning, kComplete, kFailed };
+
+  IamfStream() = default;
+
+  // Populates the descriptor-derived fields (`sample_rate_`, `frame_size_`,
+  // `audio_elements_`) from `probe_report_`. Cheap; runs synchronously in
+  // every open path. Does NOT touch `total_samples_` or
+  // `trimmed_start_timestamps_` — those depend on the temporal-unit scan and
+  // are populated by `ApplyTemporalUnitScan`.
+  IamfStatus InitDescriptorView();
+
+  // Consumes `temporal_unit_scan` from `probe_report_` to build
+  // `trimmed_start_timestamps_` and `total_samples_`. Called on the
+  // foreground thread in eager mode and from the background worker in lazy
+  // mode (after the worker has installed the full probe report under `mu_`).
+  IamfStatus ApplyTemporalUnitScan();
+
+  // Body of the background scan worker: re-runs `Probe` with
+  // `ScanMode::kScanFull`, then under `mu_` swaps in the resulting
+  // `temporal_unit_scan`, runs `ApplyTemporalUnitScan`, and publishes the
+  // final `scan_state_` (and `scan_status_` on failure).
+  void RunBackgroundScan();
+
+  // Stores `msg` as the last error on this stream and returns an equivalent
+  // non-ok `IamfStatus`.
+  IamfStatus Fail(std::string msg);
+
+  // Builds `obu_processor_`, `audio_frame_decoder_`, `demixing_manager_`,
+  // and the per-AE channel-order cache from the cached probe bytes. Called
+  // from `OpenFromBytes` after Probe succeeds. Returns a non-ok status with
+  // a message-prefixed reason on failure.
+  IamfStatus InitDecodePipeline();
+
+  // Rebuilds `read_bit_buffer_`, `obu_processor_`, `audio_frame_decoder_`,
+  // and `demixing_manager_` from `bytes_`/`len_`. Leaves the read cursor at
+  // the first byte after the descriptor OBUs. Called on every open and every
+  // successful `Seek`. Returns a non-ok status with a message-prefixed reason
+  // on failure.
+  IamfStatus BuildProcessorPipeline();
+
+  // Backing bytes. Owned by the caller; we keep a pointer+length only.
+  const uint8_t* bytes_ = nullptr;
+  size_t len_ = 0;
+
+  // Structured descriptor summary produced at open time. `temporal_unit_scan`
+  // is always populated (we open with `ScanMode::kScanFull`).
+  ProbeReport probe_report_;
+
+  // Derived descriptor view handed back via `GetAudioElement`. Parallel index
+  // to `probe_report_.audio_elements`.
+  std::vector<AudioElementDescriptor> audio_elements_;
+
+  // Deterministic per-AE channel order used to pack the demixed samples into
+  // `TemporalUnitOutput::samples_per_ae`. Parallel index to
+  // `audio_elements_`. For ambisonics-mono scene AEs the vector is the full
+  // ACN grid — slot i holds label A{i}, or nullopt when `channel_mapping`
+  // marks the ACN inactive (mixed-order ambisonics); nullopt slots are
+  // zero-filled at pack time so the packed width always matches the
+  // descriptor's `num_channels`. Other AEs list their labels by iterating
+  // `AudioElementWithData::substream_id_to_labels` in ascending substream-id
+  // order (every slot populated).
+  std::vector<std::vector<std::optional<ChannelLabel::Label>>>
+      ae_channel_order_;
+
+  // Per-AE element-mix-gain parameter ID from the selected mix presentation.
+  // Parallel index to `audio_elements_`. Zero when the AE does not appear in
+  // any sub-mix of the selected mix presentation (shouldn't happen in
+  // well-formed streams; falls back to `ae_default_mix_gain_db_`).
+  std::vector<uint32_t> ae_mix_gain_parameter_id_;
+
+  // Per-AE fallback element-mix-gain (dB) used when no parameter block
+  // animates the gain in the current TU. Parallel index to `audio_elements_`.
+  std::vector<float> ae_default_mix_gain_db_;
+
+  // True iff every audio element has `supported = true`. If false, the first
+  // `NextTemporalUnit` call fails with an `unsupported:` prefix and poisons
+  // the stream.
+  bool all_aes_supported_ = false;
+
+  // True once a `decode:` / `io:` / `unsupported:` error has occurred during
+  // pumping. Subsequent `NextTemporalUnit` calls short-circuit until `Seek`.
+  bool poisoned_ = false;
+
+  // Top-level getters.
+  uint32_t sample_rate_ = 0;
+  uint32_t frame_size_ = 0;
+  uint64_t total_samples_ = 0;
+
+  // Trimmed-timeline TU start positions, parallel to
+  // `probe_report_.temporal_unit_scan->temporal_units`. Entry i is the
+  // cumulative sum of `(num_samples - trim_at_start - trim_at_end)` over
+  // TUs 0..i-1; entry 0 is always 0. `Seek` binary-searches this vector so
+  // `Seek(0)` lands at the first post-pre-skip sample.
+  std::vector<uint64_t> trimmed_start_timestamps_;
+
+  // Descriptor + per-TU parsing pipeline. The buffer is memory-backed (not
+  // stream-backed) — `OpenFromBytes`'s contract is that the source bytes are
+  // already fully resident, and `StreamBasedReadBitBuffer` hard-caps its
+  // source size at 4 MB which real-world exports routinely exceed.
+  std::unique_ptr<MemoryBasedReadBitBuffer> read_bit_buffer_;
+  std::unique_ptr<ObuProcessor> obu_processor_;
+
+  // Per-substream codec decoders + per-AE demixer, owned directly (as opposed
+  // to being owned inside `ObuProcessor::rendering_models_`, which this build
+  // does not use).
+  AudioFrameDecoder audio_frame_decoder_;
+  std::unique_ptr<DemixingManager> demixing_manager_;
+
+  // Latest error message from a non-ok mutating call. Empty when the most
+  // recent mutating call was ok. Returned by `GetLastError`.
+  std::string last_error_;
+
+  // Temporal-unit scan state machine.
+  //   - `scan_state_` is the single source of truth, atomic so the
+  //     `IsScanComplete` / `IsTotalSamplesReady` getters and
+  //     `GetTotalSamples` (which reads `total_samples_` only after seeing
+  //     `kComplete`) can be lock-free.
+  //   - `mu_` + `cv_` synchronise the worker's "finished" publication with
+  //     `WaitForScanComplete`. The worker sets `scan_state_` (release) and
+  //     notifies `cv_` while holding `mu_`; waiters re-check `scan_state_`
+  //     under `mu_` after each wakeup.
+  //   - `scan_error_message_` is only meaningful after `scan_state_`
+  //     reaches `kFailed`; populated by the worker before the
+  //     release-store and read by waiters / `Seek` after they observe
+  //     `kFailed`. Stored as a string (not an `IamfStatus`) because
+  //     `IamfStatus` has const-qualified members and is non-assignable.
+  //   - `scan_worker_` is only joinable in lazy mode; the dtor joins it
+  //     unconditionally (waiting for the scan to finish — no cancel
+  //     mechanism in this phase).
+  std::atomic<ScanState> scan_state_{ScanState::kPending};
+  mutable std::mutex mu_;
+  mutable std::condition_variable cv_;
+  std::string scan_error_message_;
+  std::thread scan_worker_;
+};
+
+}  // namespace api
+}  // namespace iamf_tools
+
+#endif  // API_STREAM_IAMF_STREAM_H_
