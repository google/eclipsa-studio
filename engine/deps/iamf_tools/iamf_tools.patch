diff --git a/iamf/cli/iamf_extract_main.cc b/iamf/cli/iamf_extract_main.cc
new file mode 100644
index 00000000..53c446ee
--- /dev/null
+++ b/iamf/cli/iamf_extract_main.cc
@@ -0,0 +1,360 @@
+/*
+ * Copyright (c) 2025, Alliance for Open Media. All rights reserved
+ *
+ * This source code is subject to the terms of the BSD 3-Clause Clear License
+ * and the Alliance for Open Media Patent License 1.0. If the BSD 3-Clause Clear
+ * License was not distributed with this source code in the LICENSE file, you
+ * can obtain it at www.aomedia.org/license/software-license/bsd-3-c-c. If the
+ * Alliance for Open Media Patent License 1.0 was not distributed with this
+ * source code in the PATENTS file, you can obtain it at
+ * www.aomedia.org/license/patent.
+ */
+
+// Fork-only CLI (Phase A.A6) that opens an IAMF file via the streaming API
+// and writes one WAV file per supported audio element. Unsupported AEs are
+// reported on stdout and skipped. Any error tears down the partially-
+// written WAVs and exits non-zero with the stream's `GetLastError()` on
+// stderr.
+
+#include <cerrno>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <ios>
+#include <iostream>
+#include <limits>
+#include <memory>
+#include <string>
+#include <system_error>
+#include <vector>
+
+#include "absl/flags/flag.h"
+#include "absl/flags/parse.h"
+#include "absl/flags/usage.h"
+#include "absl/log/globals.h"
+#include "absl/log/initialize.h"
+#include "absl/log/log.h"
+#include "absl/status/status.h"
+#include "absl/strings/str_cat.h"
+#include "absl/strings/str_format.h"
+#include "absl/types/span.h"
+#include "iamf/cli/wav_writer.h"
+#include "iamf/include/iamf_tools/iamf_stream_factory.h"
+#include "iamf/include/iamf_tools/iamf_stream_interface.h"
+#include "iamf/include/iamf_tools/iamf_tools_api_types.h"
+
+ABSL_FLAG(std::string, input, "", "Path to the input .iamf file. Required.");
+ABSL_FLAG(std::string, output_dir, "",
+          "Directory to write per-AE WAV files into. Required. Created if "
+          "missing.");
+ABSL_FLAG(int, bit_depth, 24, "Output WAV bit depth (16, 24, or 32).");
+
+namespace {
+
+using ::iamf_tools::api::AudioElementDescriptor;
+using ::iamf_tools::api::AudioElementKind;
+using ::iamf_tools::api::IamfStatus;
+using ::iamf_tools::api::IamfStreamFactory;
+using ::iamf_tools::api::IamfStreamInterface;
+using ::iamf_tools::api::TemporalUnitOutput;
+
+std::string KindLabel(AudioElementKind kind) {
+  switch (kind) {
+    case AudioElementKind::kChannel:
+      return "channel";
+    case AudioElementKind::kScene:
+      return "scene";
+    case AudioElementKind::kObject:
+      return "object";
+  }
+  return "unknown";
+}
+
+std::string OutputWavPath(const std::string& output_dir,
+                          const AudioElementDescriptor& ae) {
+  return absl::StrCat(output_dir, "/ae_", ae.audio_element_id, "_",
+                      KindLabel(ae.kind), "_layout", ae.layout_info, ".wav");
+}
+
+// Creates `dir` and any missing parents. Succeeds if it is already a
+// directory.
+bool EnsureOutputDirectory(const std::string& dir) {
+  std::error_code error_code;
+  if (std::filesystem::is_directory(dir, error_code)) return true;
+
+  // Also reports the case where `dir` exists as a non-directory, since
+  // `create_directories` fails with an "exists" error.
+  std::filesystem::create_directories(dir, error_code);
+  if (error_code) {
+    std::fprintf(stderr, "iamf_extract: failed to create --output_dir %s: %s\n",
+                 dir.c_str(), error_code.message().c_str());
+    return false;
+  }
+  return true;
+}
+
+bool ReadFile(const std::string& path, std::vector<uint8_t>& out) {
+  std::ifstream f(path, std::ios::binary);
+  if (!f.good()) {
+    std::fprintf(stderr, "iamf_extract: failed to open input %s\n",
+                 path.c_str());
+    return false;
+  }
+  out.assign((std::istreambuf_iterator<char>(f)),
+             std::istreambuf_iterator<char>());
+  // `bad()` flags a real IO failure mid-stream; without this check a
+  // truncated read would surface to the decoder as a malformed-bitstream
+  // error and hide the underlying disk problem.
+  if (f.bad()) {
+    std::fprintf(stderr, "iamf_extract: IO error reading %s\n", path.c_str());
+    return false;
+  }
+  if (out.empty()) {
+    std::fprintf(stderr, "iamf_extract: input %s is empty\n", path.c_str());
+    return false;
+  }
+  return true;
+}
+
+// Drops the per-AE output files created before an abort. Best-effort —
+// failures to remove are not themselves fatal.
+void CleanupWavs(const std::vector<std::string>& paths) {
+  for (const auto& p : paths) {
+    if (std::remove(p.c_str()) != 0 && errno != ENOENT) {
+      std::fprintf(stderr, "iamf_extract: warning: failed to remove %s: %s\n",
+                   p.c_str(), std::strerror(errno));
+    }
+  }
+}
+
+struct PerAeSummary {
+  uint64_t frames_written = 0;
+  float mix_gain_db_first = 0.0f;
+  float mix_gain_db_last = 0.0f;
+  bool seen_any = false;
+};
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  absl::SetProgramUsageMessage(
+      "iamf_extract_main: dump per-audio-element PCM from an IAMF file.");
+  absl::ParseCommandLine(argc, argv);
+  absl::InitializeLog();
+  absl::SetStderrThreshold(absl::LogSeverityAtLeast::kWarning);
+
+  const std::string input_path = absl::GetFlag(FLAGS_input);
+  const std::string output_dir = absl::GetFlag(FLAGS_output_dir);
+  const int bit_depth = absl::GetFlag(FLAGS_bit_depth);
+  if (input_path.empty() || output_dir.empty()) {
+    std::fprintf(stderr,
+                 "iamf_extract: --input and --output_dir are required\n");
+    return 2;
+  }
+  if (bit_depth != 16 && bit_depth != 24 && bit_depth != 32) {
+    std::fprintf(stderr,
+                 "iamf_extract: --bit_depth must be 16, 24, or 32 (got %d)\n",
+                 bit_depth);
+    return 2;
+  }
+  std::vector<uint8_t> bytes;
+  if (!ReadFile(input_path, bytes)) return 2;
+
+  // After reading the input, so a bad `--input` does not leave an empty
+  // output directory behind.
+  if (!EnsureOutputDirectory(output_dir)) return 2;
+
+  std::unique_ptr<IamfStreamInterface> stream;
+  IamfStreamFactory::Settings settings;
+  IamfStatus open_status = IamfStreamFactory::OpenFromBytes(
+      bytes.data(), bytes.size(), settings, stream);
+  if (!open_status.ok()) {
+    std::fprintf(stderr, "iamf_extract: open failed: %s\n",
+                 open_status.error_message.c_str());
+    return 1;
+  }
+
+  const uint32_t num_aes = stream->GetNumAudioElements();
+  const uint32_t sample_rate = stream->GetSampleRate();
+  const uint32_t frame_size = stream->GetFrameSize();
+  if (num_aes == 0 || sample_rate == 0 || frame_size == 0) {
+    std::fprintf(stderr,
+                 "iamf_extract: stream reported zero audio elements, sample "
+                 "rate, or frame size\n");
+    return 1;
+  }
+
+  std::vector<AudioElementDescriptor> descriptors;
+  descriptors.reserve(num_aes);
+  for (uint32_t i = 0; i < num_aes; ++i) {
+    descriptors.push_back(stream->GetAudioElement(i));
+  }
+
+  // Fast path: if any AE is unsupported, `NextTemporalUnit` will return an
+  // `unsupported:` error on the first call. Log which AEs are skipped so
+  // the user has visibility, then exit — no WAVs are written.
+  bool any_unsupported = false;
+  for (const auto& ae : descriptors) {
+    if (!ae.supported) {
+      any_unsupported = true;
+      std::fprintf(stderr,
+                   "iamf_extract: audio element id=%u kind=%s unsupported "
+                   "in this build — skipping\n",
+                   ae.audio_element_id, KindLabel(ae.kind).c_str());
+    }
+  }
+  if (any_unsupported) {
+    std::fprintf(stderr,
+                 "iamf_extract: stream has unsupported audio elements; no "
+                 "WAVs written\n");
+    return 1;
+  }
+
+  std::vector<std::unique_ptr<iamf_tools::WavWriter>> writers(num_aes);
+  std::vector<std::string> wav_paths(num_aes);
+  std::vector<PerAeSummary> summaries(num_aes);
+
+  for (uint32_t i = 0; i < num_aes; ++i) {
+    wav_paths[i] = OutputWavPath(output_dir, descriptors[i]);
+    auto writer = iamf_tools::WavWriter::Create(
+        wav_paths[i], static_cast<int>(descriptors[i].num_channels),
+        static_cast<int>(sample_rate), bit_depth,
+        static_cast<size_t>(frame_size), /*write_header=*/true);
+    if (writer == nullptr) {
+      std::fprintf(stderr, "iamf_extract: failed to create WAV writer at %s\n",
+                   wav_paths[i].c_str());
+      CleanupWavs(wav_paths);
+      return 1;
+    }
+    writers[i] = std::move(writer);
+  }
+
+  // Per-channel scratch buffers, one `std::vector<double>` per channel per
+  // AE. Reused across TUs — PushFrame's spans borrow from here.
+  std::vector<std::vector<std::vector<double>>> channel_scratch(num_aes);
+  for (uint32_t i = 0; i < num_aes; ++i) {
+    channel_scratch[i].assign(descriptors[i].num_channels, {});
+  }
+
+  TemporalUnitOutput tu;
+  constexpr int kMaxTemporalUnits = 1'000'000;
+  int guard = 0;
+  for (; guard < kMaxTemporalUnits; ++guard) {
+    IamfStatus status = stream->NextTemporalUnit(tu);
+    if (!status.ok()) {
+      std::fprintf(stderr, "iamf_extract: pump failed: %s\n",
+                   status.error_message.c_str());
+      for (auto& w : writers) {
+        if (w != nullptr) w->Abort();
+      }
+      CleanupWavs(wav_paths);
+      return 1;
+    }
+    if (tu.frames_produced == 0) break;  // EOF.
+
+    for (uint32_t i = 0; i < num_aes; ++i) {
+      const uint32_t num_channels = descriptors[i].num_channels;
+      const std::vector<float>& interleaved = tu.samples_per_ae[i];
+      if (interleaved.size() !=
+          static_cast<size_t>(tu.frames_produced) * num_channels) {
+        std::fprintf(stderr,
+                     "iamf_extract: AE %u delivered %zu samples for %u "
+                     "frames * %u channels — expected %zu\n",
+                     descriptors[i].audio_element_id, interleaved.size(),
+                     tu.frames_produced, num_channels,
+                     static_cast<size_t>(tu.frames_produced) * num_channels);
+        for (auto& w : writers) {
+          if (w != nullptr) w->Abort();
+        }
+        CleanupWavs(wav_paths);
+        return 1;
+      }
+
+      // De-interleave and convert to double for `WavWriter::PushFrame`.
+      auto& channels = channel_scratch[i];
+      for (uint32_t c = 0; c < num_channels; ++c) {
+        channels[c].resize(tu.frames_produced);
+      }
+      for (uint32_t f = 0; f < tu.frames_produced; ++f) {
+        for (uint32_t c = 0; c < num_channels; ++c) {
+          channels[c][f] =
+              static_cast<double>(interleaved[f * num_channels + c]);
+        }
+      }
+
+      std::vector<absl::Span<const double>> channel_spans;
+      channel_spans.reserve(num_channels);
+      for (uint32_t c = 0; c < num_channels; ++c) {
+        channel_spans.emplace_back(channels[c].data(), channels[c].size());
+      }
+      absl::Status push_status =
+          writers[i]->PushFrame(absl::MakeConstSpan(channel_spans));
+      if (!push_status.ok()) {
+        std::fprintf(stderr, "iamf_extract: WAV write failed for AE %u: %s\n",
+                     descriptors[i].audio_element_id,
+                     push_status.ToString().c_str());
+        for (auto& w : writers) {
+          if (w != nullptr) w->Abort();
+        }
+        CleanupWavs(wav_paths);
+        return 1;
+      }
+
+      auto& summary = summaries[i];
+      const float gain_db = tu.mix_gain_db_per_ae[i];
+      if (!summary.seen_any) {
+        summary.mix_gain_db_first = gain_db;
+        summary.seen_any = true;
+      }
+      summary.mix_gain_db_last = gain_db;
+      summary.frames_written += tu.frames_produced;
+    }
+  }
+
+  // Flush each writer so the trailing WAV tail is on disk before we close.
+  for (uint32_t i = 0; i < num_aes; ++i) {
+    absl::Status flush_status = writers[i]->Flush();
+    if (!flush_status.ok()) {
+      std::fprintf(stderr, "iamf_extract: WAV flush failed for AE %u: %s\n",
+                   descriptors[i].audio_element_id,
+                   flush_status.ToString().c_str());
+      for (auto& w : writers) {
+        if (w != nullptr) w->Abort();
+      }
+      CleanupWavs(wav_paths);
+      return 1;
+    }
+  }
+  // ~WavWriter writes the header length into the file on destruction; move
+  // the vector out of scope explicitly so the summary below prints only
+  // after the files are finalised.
+  writers.clear();
+
+  if (guard == kMaxTemporalUnits) {
+    std::fprintf(stderr,
+                 "iamf_extract: pump aborted after %d temporal units without "
+                 "EOF — refusing to claim success on a stream that may be "
+                 "stuck producing TUs forever\n",
+                 kMaxTemporalUnits);
+    CleanupWavs(wav_paths);
+    return 1;
+  }
+
+  for (uint32_t i = 0; i < num_aes; ++i) {
+    const auto& ae = descriptors[i];
+    const auto& summary = summaries[i];
+    std::printf(
+        "ae=%u kind=%s channels=%u written=%llu mix_gain_db_first=%g "
+        "mix_gain_db_last=%g path=%s\n",
+        ae.audio_element_id, KindLabel(ae.kind).c_str(), ae.num_channels,
+        static_cast<unsigned long long>(summary.frames_written),
+        summary.mix_gain_db_first, summary.mix_gain_db_last,
+        wav_paths[i].c_str());
+  }
+
+  return 0;
+}
