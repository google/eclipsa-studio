+#include <memory>
+
+#include "iamf/api/stream/iamf_stream.h"
+#include "iamf/include/iamf_tools/iamf_stream_interface.h"
+#include "iamf/include/iamf_tools/iamf_tools_api_types.h"
+
+namespace iamf_tools {
+namespace api {
+
+IamfStatus IamfStreamFactory::OpenFromBytes(
+    const uint8_t* bytes, size_t len, const Settings& settings,
+    std::unique_ptr<IamfStreamInterface>& out_stream) {
+  std::unique_ptr<IamfStream> impl;
+  IamfStatus status =
+      IamfStream::OpenFromBytes(bytes, len, settings, impl);
+  if (!status.ok()) {
+    out_stream.reset();
+    return status;
+  }
+  out_stream = std::move(impl);
+  return IamfStatus::OkStatus();
+}
+
+}  // namespace api
+}  // namespace iamf_tools
