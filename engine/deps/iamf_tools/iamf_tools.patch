+  return pb::CODEC_ID_INVALID;
+}
+
+void PopulateCodecConfigs(const iamf_tools::ProbeReport& r,
+                          pb::UserMetadata& um) {
+  for (const auto& c : r.codec_configs) {
+    auto* meta = um.add_codec_config_metadata();
+    meta->set_codec_config_id(c.id);
+    auto* cfg = meta->mutable_codec_config();
+    cfg->set_codec_id(ToCodecId(c.codec_id));
+    cfg->set_num_samples_per_frame(c.num_samples_per_frame);
+    cfg->set_audio_roll_distance(c.audio_roll_distance);
+    cfg->set_automatically_override_codec_delay(false);
+    cfg->set_automatically_override_audio_roll_distance(false);
+    if (c.opus.has_value()) {
+      auto* o = cfg->mutable_decoder_config_opus();
+      o->set_version(c.opus->version);
+      o->set_output_channel_count(c.opus->output_channel_count);
+      o->set_pre_skip(c.opus->pre_skip);
+      o->set_input_sample_rate(c.opus->input_sample_rate);
+      o->set_output_gain(c.opus->output_gain_q7_8);
+      o->set_mapping_family(c.opus->mapping_family);
+    } else if (c.lpcm.has_value()) {
+      auto* l = cfg->mutable_decoder_config_lpcm();
+      if (c.lpcm->sample_format == "little_endian") {
+        l->set_sample_format_flags(pb::LPCM_LITTLE_ENDIAN);
+      } else if (c.lpcm->sample_format == "big_endian") {
+        l->set_sample_format_flags(pb::LPCM_BIG_ENDIAN);
+      }
+      l->set_sample_size(c.lpcm->sample_size);
+      l->set_sample_rate(c.lpcm->sample_rate);
+    } else if (c.aac.has_value()) {
+      auto* a = cfg->mutable_decoder_config_aac();
+      a->set_object_type_indication(c.aac->object_type_indication);
+      a->set_stream_type(c.aac->stream_type);
+      a->set_upstream(c.aac->upstream);
+      a->set_reserved(c.aac->reserved);
+      a->set_buffer_size_db(c.aac->buffer_size_db);
+      a->set_max_bitrate(c.aac->max_bitrate);
+      a->set_average_bit_rate(c.aac->average_bit_rate);
+      auto* dsi = a->mutable_decoder_specific_info();
+      dsi->set_audio_object_type(c.aac->audio_object_type);
+      dsi->set_channel_configuration(c.aac->channel_configuration);
+    } else if (c.flac.has_value()) {
+      auto* f = cfg->mutable_decoder_config_flac();
+      for (const auto& b : c.flac->metadata_blocks) {
+        auto* mb = f->add_metadata_blocks();
+        if (b.is_stream_info) {
+          auto* info = mb->mutable_stream_info();
+          info->set_minimum_block_size(b.minimum_block_size);
+          info->set_maximum_block_size(b.maximum_block_size);
+          info->set_minimum_frame_size(b.minimum_frame_size);
+          info->set_maximum_frame_size(b.maximum_frame_size);
+          info->set_sample_rate(b.sample_rate);
+          info->set_number_of_channels(b.number_of_channels);
+          info->set_bits_per_sample(b.bits_per_sample);
+          info->set_total_samples_in_stream(b.total_samples_in_stream);
+        }
+      }
+    }
+  }
+}
+
+pb::LayoutType ToLayoutType(const std::string& s) {
+  if (s == "loudspeakers_ss_convention") {
+    return pb::LAYOUT_TYPE_LOUDSPEAKERS_SS_CONVENTION;
+  }
+  if (s == "binaural") return pb::LAYOUT_TYPE_BINAURAL;
+  return pb::LAYOUT_TYPE_INVALID;
+}
+
+void SetLoudnessInfoTypeBitmask(pb::LoudnessInfo* li, uint8_t mask) {
+  if (mask & 0x01)
+    li->add_info_type_bit_masks(pb::LOUDNESS_INFO_TYPE_TRUE_PEAK);
+  if (mask & 0x02)
+    li->add_info_type_bit_masks(pb::LOUDNESS_INFO_TYPE_ANCHORED_LOUDNESS);
+  if (mask & 0x04) li->add_info_type_bit_masks(pb::LOUDNESS_INFO_TYPE_LIVE);
+  if (mask & 0x08)
+    li->add_info_type_bit_masks(pb::LOUDNESS_INFO_TYPE_RESERVED_8);
+  if (mask & 0x10)
+    li->add_info_type_bit_masks(pb::LOUDNESS_INFO_TYPE_RESERVED_16);
+  if (mask & 0x20)
+    li->add_info_type_bit_masks(pb::LOUDNESS_INFO_TYPE_RESERVED_32);
+  if (mask & 0x40)
+    li->add_info_type_bit_masks(pb::LOUDNESS_INFO_TYPE_RESERVED_64);
+  if (mask & 0x80)
+    li->add_info_type_bit_masks(pb::LOUDNESS_INFO_TYPE_RESERVED_128);
+}
+
+void PopulateMixPresentations(const iamf_tools::ProbeReport& r,
+                              pb::UserMetadata& um) {
+  for (const auto& m : r.mix_presentations) {
+    auto* meta = um.add_mix_presentation_metadata();
+    meta->set_mix_presentation_id(m.id);
+    for (const auto& [lang, _] : m.annotations) {
+      meta->add_annotations_language(lang);
+    }
+    for (const auto& [_, label] : m.annotations) {
+      meta->add_localized_presentation_annotations(label);
+    }
+    for (const auto& sm : m.sub_mixes) {
+      auto* pbsm = meta->add_sub_mixes();
+      for (const auto& ae : sm.audio_elements) {
+        auto* pae = pbsm->add_audio_elements();
+        pae->set_audio_element_id(ae.audio_element_id);
+        for (const auto& la : ae.localized_element_annotations) {
+          pae->add_localized_element_annotations(la);
+        }
+      }
+      for (const auto& l : sm.layouts) {
+        auto* pl = pbsm->add_layouts();
+        pl->mutable_loudness_layout()->set_layout_type(
+            ToLayoutType(l.loudness_layout.layout_type));
+        SetLoudnessInfoTypeBitmask(pl->mutable_loudness(),
+                                   l.loudness.info_type);
+        // Q7.8 round-trip. Clamp to int16_t range before the cast; the source
+        // spec field is int16_t, and float-to-int conversion is undefined when
+        // the value does not fit in the destination integer type.
+        const auto to_q7_8 = [](float v) -> int32_t {
+          constexpr float kMax = 32767.0f;
+          constexpr float kMin = -32768.0f;
+          if (!std::isfinite(v)) return 0;
+          const float scaled = v * 256.0f;
+          if (scaled >= kMax) return 32767;
+          if (scaled <= kMin) return -32768;
+          return static_cast<int32_t>(scaled);
+        };
+        pl->mutable_loudness()->set_integrated_loudness(
+            to_q7_8(l.loudness.integrated_loudness));
+        pl->mutable_loudness()->set_digital_peak(
+            to_q7_8(l.loudness.digital_peak));
+        if (l.loudness.true_peak.has_value()) {
+          pl->mutable_loudness()->set_true_peak(to_q7_8(*l.loudness.true_peak));
+        }
+      }
+    }
+  }
+}
+
+pb::UserMetadata BuildUserMetadata(const iamf_tools::ProbeReport& r) {
+  pb::UserMetadata um;
+  auto* ia = um.add_ia_sequence_header_metadata();
+  ia->set_primary_profile(ToProfileVersion(r.primary_profile));
+  ia->set_additional_profile(ToProfileVersion(r.additional_profile));
+  PopulateCodecConfigs(r, um);
+  // Audio elements: we leave partial fields (IDs + types + substreams) so
+  // textproto output is useful but we do not attempt a perfect 1:1.
+  for (const auto& a : r.audio_elements) {
+    auto* meta = um.add_audio_element_metadata();
+    meta->set_audio_element_id(a.id);
+    meta->set_codec_config_id(a.codec_config_id);
+    for (auto id : a.substream_ids) meta->add_audio_substream_ids(id);
+  }
+  PopulateMixPresentations(r, um);
+  return um;
+}
+
+std::string FormatTextproto(const iamf_tools::ProbeReport& r) {
+  auto um = BuildUserMetadata(r);
+  std::string out;
+  google::protobuf::TextFormat::Printer printer;
+  printer.SetUseFieldNumber(false);
+  printer.SetExpandAny(false);
+  printer.PrintToString(um, &out);
+  return out;
+}
+
+// ---------- Verify mode ----------
+
+struct Mismatch {
+  std::string field;
+  std::string expected;
+  std::string actual;
+};
+
+template <typename T>
+void Check(const std::string& field, const T& expected, const T& actual,
+           std::vector<Mismatch>* out) {
+  if (!(expected == actual)) {
+    out->push_back({field, absl::StrCat(expected), absl::StrCat(actual)});
+  }
+}
+
+void CompareCodecConfigs(const pb::UserMetadata& ref,
+                         const iamf_tools::ProbeReport& got,
+                         std::vector<Mismatch>* m) {
+  if (ref.codec_config_metadata_size() !=
+      static_cast<int>(got.codec_configs.size())) {
+    m->push_back({"codec_configs.size",
+                  absl::StrCat(ref.codec_config_metadata_size()),
+                  absl::StrCat(got.codec_configs.size())});
+    return;
+  }
+  for (int i = 0; i < ref.codec_config_metadata_size(); ++i) {
+    const auto& r = ref.codec_config_metadata(i);
+    // Match by id.
+    const iamf_tools::CodecConfigReport* actual = nullptr;
+    for (const auto& c : got.codec_configs) {
+      if (c.id == r.codec_config_id()) {
+        actual = &c;
+        break;
+      }
+    }
+    if (actual == nullptr) {
+      m->push_back({absl::StrCat("codec_config[", r.codec_config_id(), "]"),
+                    "<present>", "<missing>"});
+      continue;
+    }
+    const std::string prefix =
+        absl::StrCat("codec_config[", r.codec_config_id(), "].");
+    Check<uint32_t>(prefix + "num_samples_per_frame",
+                    r.codec_config().num_samples_per_frame(),
+                    actual->num_samples_per_frame, m);
+    if (r.codec_config().has_audio_roll_distance()) {
+      Check<int32_t>(prefix + "audio_roll_distance",
+                     r.codec_config().audio_roll_distance(),
+                     actual->audio_roll_distance, m);
+    }
+  }
+}
+
+void CompareAudioElements(const pb::UserMetadata& ref,
+                          const iamf_tools::ProbeReport& got,
+                          std::vector<Mismatch>* m) {
+  if (ref.audio_element_metadata_size() !=
+      static_cast<int>(got.audio_elements.size())) {
+    m->push_back({"audio_elements.size",
+                  absl::StrCat(ref.audio_element_metadata_size()),
+                  absl::StrCat(got.audio_elements.size())});
+    return;
+  }
+  for (int i = 0; i < ref.audio_element_metadata_size(); ++i) {
+    const auto& r = ref.audio_element_metadata(i);
+    const iamf_tools::AudioElementReport* actual = nullptr;
+    for (const auto& a : got.audio_elements) {
+      if (a.id == r.audio_element_id()) {
+        actual = &a;
+        break;
+      }
+    }
+    if (actual == nullptr) {
+      m->push_back({absl::StrCat("audio_element[", r.audio_element_id(), "]"),
+                    "<present>", "<missing>"});
+      continue;
+    }
+    const std::string prefix =
+        absl::StrCat("audio_element[", r.audio_element_id(), "].");
+    Check<uint32_t>(prefix + "codec_config_id", r.codec_config_id(),
+                    actual->codec_config_id, m);
+    Check<int>(prefix + "audio_substream_ids.size",
+               r.audio_substream_ids_size(),
+               static_cast<int>(actual->substream_ids.size()), m);
+  }
+}
