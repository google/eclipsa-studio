+
+namespace iamf_tools {
+namespace api {
+
+namespace {
+
+// Maps the raw coded `loudspeaker_layout` (and, for Expanded, the raw
+// `expanded_loudspeaker_layout`) of a channel-based Audio Element's final
+// scalable layer to its canonical `OutputLayout` enum value. Keyed on the
+// spec enums rather than probe display strings so an upstream label
+// rewording cannot silently change the mapping. Returns `std::nullopt`
+// when the layout has no canonical `OutputLayout` (every `Expanded`
+// sub-layout other than 9.1.6).
+std::optional<OutputLayout> OutputLayoutFromRawLayout(
+    int32_t loudspeaker_layout_raw, int32_t expanded_loudspeaker_layout_raw) {
+  switch (loudspeaker_layout_raw) {
+    case ChannelAudioLayerConfig::kLayoutMono:
+      return OutputLayout::kIAMF_SoundSystemExtension_0_1_0;
+    case ChannelAudioLayerConfig::kLayoutStereo:
+      return OutputLayout::kItu2051_SoundSystemA_0_2_0;
+    case ChannelAudioLayerConfig::kLayout5_1_ch:
+      return OutputLayout::kItu2051_SoundSystemB_0_5_0;
+    case ChannelAudioLayerConfig::kLayout5_1_2_ch:
+      return OutputLayout::kItu2051_SoundSystemC_2_5_0;
+    case ChannelAudioLayerConfig::kLayout5_1_4_ch:
+      return OutputLayout::kItu2051_SoundSystemD_4_5_0;
+    case ChannelAudioLayerConfig::kLayout7_1_ch:
+      return OutputLayout::kItu2051_SoundSystemI_0_7_0;
+    case ChannelAudioLayerConfig::kLayout7_1_2_ch:
+      return OutputLayout::kIAMF_SoundSystemExtension_2_7_0;
+    case ChannelAudioLayerConfig::kLayout7_1_4_ch:
+      return OutputLayout::kItu2051_SoundSystemJ_4_7_0;
+    case ChannelAudioLayerConfig::kLayout3_1_2_ch:
+      return OutputLayout::kIAMF_SoundSystemExtension_2_3_0;
+    case ChannelAudioLayerConfig::kLayoutBinaural:
+      return OutputLayout::kIAMF_Binaural;
+    case ChannelAudioLayerConfig::kLayoutExpanded:
+      if (expanded_loudspeaker_layout_raw ==
+          ChannelAudioLayerConfig::kExpandedLayout9_1_6_ch) {
+        return OutputLayout::kIAMF_SoundSystemExtension_6_9_0;
+      }
+      return std::nullopt;
+    default:
+      return std::nullopt;
+  }
+}
+
+// Translates a probe-reported Audio Element `type` string into our public
+// enum. Returns false if the string is not one of the three known kinds.
+bool ParseKind(const std::string& type, AudioElementKind& kind) {
+  if (type == "channel_based") {
+    kind = AudioElementKind::kChannel;
+    return true;
+  }
+  if (type == "scene_based") {
+    kind = AudioElementKind::kScene;
+    return true;
+  }
+  if (type == "object_based") {
+    kind = AudioElementKind::kObject;
+    return true;
+  }
+  return false;
+}
+
+}  // namespace
+
+// See the header doc: this is the single owner of the decode-capability
+// judgement (`supported`). Keyed on the raw coded layout values so the
+// judgement cannot drift with display-label rewording; keep it in sync
+// with what the channel-label / demixing machinery actually enumerates.
+AudioElementDescriptor DescriptorFromProbeReport(const AudioElementReport& ae) {
+  // Raw coded bounds from the authoritative spec enums in
+  // `audio_element.h`, expressed via the first-reserved markers so an
+  // upstream enum extension (e.g. assigning expanded layout 20) breaks
+  // this compile instead of leaving the gate silently stale.
+  constexpr int32_t kLayoutExpanded = ChannelAudioLayerConfig::kLayoutExpanded;
+  constexpr int32_t kFirstReservedLayout =
+      ChannelAudioLayerConfig::kLayoutReserved10;
+  constexpr int32_t kFirstReservedExpandedLayout =
+      ChannelAudioLayerConfig::kExpandedLayoutReserved20;
+
+  AudioElementDescriptor out = {};
+  out.audio_element_id = ae.id;
+  out.codec_config_id = ae.codec_config_id;
+  out.num_channels = ae.num_channels.value_or(0);
+  out.layout_info = -1;
+  out.loudspeaker_layout_raw = -1;
+  out.expanded_loudspeaker_layout_raw = -1;
+  out.supported = false;
+
+  if (!ParseKind(ae.type, out.kind)) {
+    return out;
+  }
+
+  switch (out.kind) {
+    case AudioElementKind::kChannel: {
+      if (ae.scalable_layers.empty()) break;
+      // Everything below keys on the final layer's raw coded values — not
+      // the AE-level `channel_layout_raw` convenience duplicates and not
+      // the display strings — so the gate and `layout_info` can never
+      // describe different layers or drift with a label rewording, and a
+      // hand-built report can't trip the gate by omitting the optional
+      // AE-level copies (the per-layer field is non-optional).
+      const auto& final_layer = ae.scalable_layers.back();
+      out.loudspeaker_layout_raw =
+          static_cast<int32_t>(final_layer.loudspeaker_layout_raw);
+      if (final_layer.expanded_loudspeaker_layout_raw.has_value()) {
+        out.expanded_loudspeaker_layout_raw =
+            static_cast<int32_t>(*final_layer.expanded_loudspeaker_layout_raw);
+      }
+      if (auto output_layout =
+              OutputLayoutFromRawLayout(out.loudspeaker_layout_raw,
+                                        out.expanded_loudspeaker_layout_raw)) {
+        out.layout_info = static_cast<int32_t>(*output_layout);
+      }  // else `layout_info` stays at the initial -1 sentinel.
+      bool any_recon_gain = false;
+      for (const auto& layer : ae.scalable_layers) {
+        if (layer.recon_gain_is_present_flag) {
+          any_recon_gain = true;
+          break;
+        }
+      }
+      const bool layout_ok =
+          out.loudspeaker_layout_raw == kLayoutExpanded
+              ? (out.expanded_loudspeaker_layout_raw >= 0 &&
+                 out.expanded_loudspeaker_layout_raw <
+                     kFirstReservedExpandedLayout)
+              : (out.loudspeaker_layout_raw >= 0 &&
+                 out.loudspeaker_layout_raw < kFirstReservedLayout);
+      out.supported = layout_ok && !any_recon_gain;
+      break;
+    }
+    case AudioElementKind::kScene: {
+      if (!ae.ambisonics.has_value() || !ae.ambisonics->order.has_value()) {
+        break;
+      }
+      const int order = *ae.ambisonics->order;
+      out.layout_info = order;
+      // Mono mode only: the decode pipeline never applies a projection
+      // demixing matrix (that lives in the CLI renderers, which this
+      // build does not use), so the packed output would be raw substream
+      // coefficients mislabeled as ACN channels. Orders 0-4 are the full
+      // range expressible in v1.x profiles (5OA needs 36 channels;
+      // Base-Enhanced caps an element at 28) and the full range the
+      // channel-label machinery enumerates (A0-A24).
+      out.supported =
+          (order >= 0 && order <= 4) && ae.ambisonics->mono.has_value();
+      break;
+    }
+    case AudioElementKind::kObject: {
+      out.layout_info = static_cast<int32_t>(ae.num_substreams);
+      out.num_channels = ae.num_substreams;
+      break;
+    }
+  }
+  return out;
+}
+
+}  // namespace api
+}  // namespace iamf_tools
