new file mode 100644
index 00000000..4e91e25d
--- /dev/null
+++ b/iamf/include/iamf_tools/iamf_stream_interface.h
@@ -0,0 +1,329 @@
+/*
+ * Copyright (c) 2025, Alliance for Open Media. All rights reserved
+ *
+ * This source code is subject to the terms of the BSD 3-Clause Clear License
+ * and the Alliance for Open Media Patent License 1.0. If the BSD 3-Clause Clear
+ * License was not distributed with this source code in the LICENSE file, you
+ * can obtain it at www.aomedia.org/license/software-license/bsd-3-c-c. If the
+ * Alliance for Open Media Patent License 1.0 was not distributed with this
+ * source code in the PATENTS file, you can obtain it at
+ * www.aomedia.org/license/patent.
+ */
+
+#ifndef INCLUDE_IAMF_TOOLS_IAMF_STREAM_INTERFACE_H_
+#define INCLUDE_IAMF_TOOLS_IAMF_STREAM_INTERFACE_H_
+
+#include <cstdint>
+#include <vector>
+
+#include "absl/time/time.h"
+#include "iamf_tools_api_types.h"
+
+namespace iamf_tools {
+
+struct AudioElementReport;  // iamf/cli/probe.h
+
+namespace api {
+
+/*!\brief Kind of an Audio Element in an IAMF bitstream.
+ *
+ * Matches the IAMF spec's audio_element_type. Returned as part of
+ * `AudioElementDescriptor`.
+ */
+enum class AudioElementKind : int {
+  kChannel = 0,  // Scalable channel-based audio (see IAMF spec).
+  kScene = 1,    // Scene-based audio (ambisonics).
+  kObject = 2,   // Object-based audio.
+};
+
+/*!\brief Immutable description of a single Audio Element.
+ *
+ * Returned by `IamfStreamInterface::GetAudioElement`. Reflects state parsed
+ * at open time and does not change for the lifetime of the stream.
+ */
+struct AudioElementDescriptor {
+  // IAMF audio_element_id from the Audio Element OBU.
+  uint32_t audio_element_id;
+
+  // Audio Element kind. See `AudioElementKind`.
+  AudioElementKind kind;
+
+  // codec_config_id this Audio Element refers to.
+  uint32_t codec_config_id;
+
+  // Final per-AE channel count after demix (what `NextTemporalUnit` will
+  // deliver for this element).
+  uint32_t num_channels;
+
+  // Layout-dependent integer:
+  //   - `kChannel`: the `OutputLayout` enum value of the final layer's
+  //     loudspeaker layout, cast to `int32_t` (e.g.
+  //     `kItu2051_SoundSystemA_0_2_0` for stereo). Set to -1 when the
+  //     layout has no canonical `OutputLayout`.
+  //   - `kScene`:   ambisonics order N (1, 2, 3, ...).
+  //   - `kObject`:  number of objects in the Audio Element.
+  //
+  // CONTRACT for `kChannel`: -1 routinely co-occurs with
+  // `supported == true` — every `Expanded` sub-layout except 9.1.6 is
+  // decodable but has no `OutputLayout` value to report. `layout_info` is
+  // therefore a lossy convenience only; consumers that route or spatialize
+  // by layout must key on `loudspeaker_layout_raw` /
+  // `expanded_loudspeaker_layout_raw` below, which identify every coded
+  // layout. Do not treat `layout_info == -1` as "unsupported" — that is
+  // what `supported` is for.
+  int32_t layout_info;
+
+  // Raw coded layout of the final scalable layer for `kChannel` elements:
+  // the 4-bit `loudspeaker_layout` value from the Audio Element OBU
+  // (0=Mono ... 9=Binaural, 15=Expanded); -1 for non-channel elements.
+  // When it is 15 (Expanded), `expanded_loudspeaker_layout_raw` carries the
+  // raw `expanded_loudspeaker_layout` value; -1 otherwise. Unlike
+  // `layout_info` these identify every coded layout (including Expanded
+  // sub-layouts), so downstream capability mapping can key on them without
+  // a lossy detour through `OutputLayout`.
+  int32_t loudspeaker_layout_raw;
+  int32_t expanded_loudspeaker_layout_raw;
+
+  // True iff this Audio Element can be decoded by `NextTemporalUnit` in the
+  // current build. See `IamfStreamInterface` class comment for the supported
+  // set. When false, pumping the stream returns an error with an
+  // `unsupported:` prefix.
+  bool supported;
+};
+
+/*!\brief Derives an `AudioElementDescriptor` from one probe-report entry.
+ *
+ * The single owner of the decode-capability judgement (`supported`): the
+ * stream trusts it verbatim at open time, and out-of-stream consumers
+ * (e.g. a descriptors-only probe shim) call it so their judgement can
+ * never drift from what `NextTemporalUnit` will actually do. The
+ * definition lives in the codec-free
+ * `//iamf/api/stream:descriptor_from_probe_report` target, so calling it
+ * does not pull the decode pipeline into the linking consumer. Decodable
+ * today: channel-based elements with any non-reserved coded layout
+ * (including Binaural and every non-reserved Expanded layout) and no
+ * recon-gain layers; mono-mode ambisonics of order 0-4. Projection-mode
+ * ambisonics, object-based, and reserved types are not.
+ */
+AudioElementDescriptor DescriptorFromProbeReport(const AudioElementReport& ae);
+
+/*!\brief Output of a single call to `NextTemporalUnit`.
+ *
+ * Owned by the caller; `NextTemporalUnit` fills the two inner vectors by
+ * resize + copy. Buffers are sized as:
+ *   samples_per_ae[i].size()   == frames_produced * AE_i.num_channels
+ *   mix_gain_db_per_ae.size()  == GetNumAudioElements()
+ * when `frames_produced > 0`. On EOF `frames_produced == 0` and both
+ * vectors are emptied.
+ *
+ * Sample order inside `samples_per_ae[i]` is interleaved per AE, one block
+ * of `num_channels` floats per frame. Channel order within an AE follows
+ * the AE's own layout — not a fixed target layout — because this API pulls
+ * the pre-render demixed output.
+ */
+struct TemporalUnitOutput {
+  // Number of audio frames produced for this temporal unit, per AE. 0 at
+  // end-of-stream.
+  uint32_t frames_produced = 0;
+
+  // Per-AE interleaved float PCM. Outer index matches the order returned by
+  // `GetAudioElement(0..GetNumAudioElements()-1)`.
+  std::vector<std::vector<float>> samples_per_ae;
+
+  // Per-AE mix gain in dB, sampled at the TU start timestamp. Outer index
+  // aligns with `samples_per_ae`.
+  std::vector<float> mix_gain_db_per_ae;
+};
+
+/*!\brief Pulls per–audio-element PCM from an IAMF bitstream.
+ *
+ * Companion to `IamfDecoderInterface` for consumers that do their own
+ * rendering. Where `IamfDecoderInterface` parses, decodes, demixes, and
+ * renders into a single output layout, this interface stops one stage
+ * earlier and hands the caller the demixed per-AE PCM plus the per-TU mix
+ * gain in dB.
+ *
+ * Instantiate via `IamfStreamFactory::OpenFromBytes`. The backing byte
+ * buffer passed to the factory must remain valid (and unmodified) until
+ * the returned stream is destroyed; the implementation does not copy it.
+ * `mmap` is the intended usage.
+ *
+ * Worked example:
+ *
+ *   using iamf_tools::api::IamfStreamFactory;
+ *   using iamf_tools::api::IamfStreamInterface;
+ *   using iamf_tools::api::TemporalUnitOutput;
+ *
+ *   std::unique_ptr<IamfStreamInterface> stream;
+ *   IamfStatus status = IamfStreamFactory::OpenFromBytes(
+ *       mapped.data(), mapped.size(), /.settings=.{}, stream);
+ *   if (!status.ok()) {
+ *     // status.error_message carries a prefix: "malformed:", "io:",
+ *     // "unsupported:", or "invalid_argument:".
+ *     return;
+ *   }
+ *
+ *   const uint32_t num_aes = stream->GetNumAudioElements();
+ *   for (uint32_t i = 0; i < num_aes; ++i) {
+ *     auto ae = stream->GetAudioElement(i);
+ *     // ae.supported == false => NextTemporalUnit will refuse this file.
+ *   }
+ *
+ *   TemporalUnitOutput tu;
+ *   while (true) {
+ *     status = stream->NextTemporalUnit(tu);
+ *     if (!status.ok()) break;
+ *     if (tu.frames_produced == 0) break;  // EOF.
+ *     for (uint32_t i = 0; i < num_aes; ++i) {
+ *       Consume(tu.samples_per_ae[i], tu.mix_gain_db_per_ae[i]);
+ *     }
+ *   }
+ *
+ * Supported Audio Elements (see `DescriptorFromProbeReport`):
+ *   - Channel-based: every non-reserved coded layout, including Binaural
+ *     and the Expanded sub-layouts. Scalable-channel elements that
+ *     require recon_gain are not supported.
+ *   - Scene-based (ambisonics): mono mode, orders 0-4. Projection mode
+ *     is not supported.
+ *   - Object-based: not supported.
+ * Unsupported Audio Elements are exposed via `GetAudioElement` with
+ * `supported = false`. If any AE is unsupported, the first
+ * `NextTemporalUnit` call returns an error with an `unsupported:` prefix
+ * and the stream produces no samples.
+ *
+ * Threading contract:
+ *   - `NextTemporalUnit`, `Seek`, and destruction must not race any other
+ *     call on the same stream; the caller serialises these.
+ *   - `GetSampleRate`, `GetFrameSize`, `GetTotalSamples`,
+ *     `GetNumAudioElements`, `GetAudioElement`, `IsScanComplete`,
+ *     `IsTotalSamplesReady`, and `WaitForScanComplete` are safe from any
+ *     thread after open.
+ *   - `GetLastError` must be read on the same thread that made the most
+ *     recent mutating call — it is tied to that call's result and is
+ *     overwritten on the next mutating call.
+ *   - Different streams are fully independent.
+ *
+ * Lazy temporal-unit scan (opt-in via
+ * `IamfStreamFactory::Settings::lazy_temporal_unit_scan`):
+ *   - `OpenFromBytes` returns after descriptor parse + codec init only;
+ *     the temporal-unit scan runs on a worker thread.
+ *   - `IsScanComplete` / `IsTotalSamplesReady` poll completion;
+ *     `WaitForScanComplete` blocks with a deadline.
+ *   - `GetTotalSamples` returns 0 until the scan completes.
+ *   - `Seek` transparently waits for the scan to complete before the
+ *     binary-search; the first `Seek` may block.
+ *   - `NextTemporalUnit` is unaffected and can be pumped immediately
+ *     after open.
+ *   - When the flag is false (default) the scan runs synchronously inside
+ *     `OpenFromBytes` and `IsScanComplete` is true on return.
+ */
+class IamfStreamInterface {
+ public:
+  virtual ~IamfStreamInterface() = default;
+
+  // Sample rate of the output PCM, in Hz. Identical for all Audio Elements
+  // in a conformant IAMF stream.
+  virtual uint32_t GetSampleRate() const = 0;
+
+  // Number of samples per channel in one temporal unit (before pre-skip /
+  // end-trim adjustments; a single TU near the stream boundaries may
+  // deliver fewer than this).
+  virtual uint32_t GetFrameSize() const = 0;
+
+  // Total number of audio samples per channel deliverable across the
+  // stream, with Opus pre-skip and end-trim already accounted for.
+  // Returns 0 while the temporal-unit scan is still in flight (lazy mode);
+  // use `IsTotalSamplesReady` to disambiguate "0 samples" from "not yet
+  // known".
+  virtual uint64_t GetTotalSamples() const = 0;
+
+  // True iff `GetTotalSamples()` reflects a completed temporal-unit scan.
+  // Always true in eager mode (the default) and once the lazy worker
+  // finishes successfully; false while a lazy scan is in flight or after
+  // it failed.
+  virtual bool IsTotalSamplesReady() const = 0;
+
+  // True iff the temporal-unit scan has finished (successfully or with an
+  // error). After this returns true, `Seek` will not block on the scan.
+  virtual bool IsScanComplete() const = 0;
+
+  // Blocks up to `timeout` waiting for the temporal-unit scan to finish.
+  // Returns:
+  //   - `IamfStatus::OkStatus()` once the scan completed successfully (or
+  //     immediately when the scan ran eagerly at open).
+  //   - The scan's failure status if the worker reported an error
+  //     (message-prefixed `malformed:` / `io:` / `decode:` /
+  //     `unsupported:`).
+  //   - A `deadline_exceeded:` error if the scan was still running when
+  //     `timeout` elapsed.
+  // Pass `absl::InfiniteDuration()` to wait indefinitely. Safe to call
+  // from any thread; multiple concurrent waiters are allowed.
+  virtual IamfStatus WaitForScanComplete(absl::Duration timeout) const = 0;
+
+  // Number of Audio Elements present in the descriptor OBUs, including
+  // unsupported ones.
+  virtual uint32_t GetNumAudioElements() const = 0;
+
+  // Descriptor for the i-th Audio Element. Index order is ascending
+  // `audio_element_id`: stable across processes and independent of the
+  // order the Audio Element OBUs appear in the bitstream. The same order
+  // applies to `TemporalUnitOutput::samples_per_ae` and
+  // `mix_gain_db_per_ae`. Precondition: i < num AEs. An out-of-range index
+  // is a programming error — implementations abort or return a zero-filled
+  // descriptor; do not rely on the specific failure mode.
+  virtual AudioElementDescriptor GetAudioElement(uint32_t index) const = 0;
+
+  // Produces samples for the next temporal unit. On success:
+  //   - `out.frames_produced > 0` with buffers filled for a valid TU, or
+  //   - `out.frames_produced == 0` to indicate end of stream; no further
+  //     TUs will be produced by this stream without a `Seek`.
+  //
+  // On error returns a non-ok `IamfStatus` with one of these message
+  // prefixes:
+  //   - "unsupported:" — the stream contains an AE this build can't
+  //                      decode. Stream is poisoned; `Seek` does NOT
+  //                      clear it (a successful `Seek` on an
+  //                      unsupported-AE stream is impossible).
+  //   - "decode:"      — a codec or demix step failed mid-stream.
+  //                      Stream is poisoned; `Seek` clears it.
+  //   - "io:"          — backing bytes were truncated mid-TU. Stream is
+  //                      poisoned; `Seek` clears it.
+  // Once poisoned, subsequent calls re-emit the original failure's
+  // message (and prefix) verbatim until a successful `Seek` clears the
+  // state.
+  virtual IamfStatus NextTemporalUnit(TemporalUnitOutput& out) = 0;
+
+  // Repositions the read cursor. `sample_pos` is interpreted in the
+  // trim-adjusted timeline: 0 means the first post-pre-skip sample;
+  // `GetTotalSamples()` is the one-past-end boundary.
+  //
+  // The seek is TU-aligned: `sample_pos` rounds down to the start of the
+  // temporal unit containing it. The caller can drop any leading samples
+  // from the next `NextTemporalUnit` if sample-accurate cueing is needed.
+  //
+  // On success the stream is ready for a subsequent `NextTemporalUnit`
+  // starting at (or before) `sample_pos` and any poisoned state is
+  // cleared. `sample_pos >= GetTotalSamples()` returns an
+  // `invalid_argument:` error. Seeking on a stream with any unsupported
+  // AE returns an `unsupported:` error and does not mutate state.
+  //
+  // Caveat for time-varying element mix gain: a parameter block whose
+  // `[start, end)` range straddles the seek-entry TU is not re-emitted by
+  // the bitstream parser (its OBU bytes are behind the new cursor). For the
+  // first one or two TUs after a `Seek`, `mix_gain_db_per_ae` therefore
+  // falls back to the element's default gain until the next parameter
+  // block in the stream overrides it. Pure fresh-open / seek-to-0 paths
+  // are unaffected (parameter block zero covers timestamp zero by spec).
+  virtual IamfStatus Seek(uint64_t sample_pos) = 0;
+
+  // Returns the error message from the most recent non-ok mutating call
+  // on this stream, or an empty string if the most recent such call was
+  // ok. The returned pointer is valid until the next mutating call and
+  // must be read from the same thread.
+  virtual const char* GetLastError() const = 0;
+};
