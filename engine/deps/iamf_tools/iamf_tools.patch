+#ifndef INCLUDE_IAMF_TOOLS_IAMF_STREAM_SETTINGS_H_
+#define INCLUDE_IAMF_TOOLS_IAMF_STREAM_SETTINGS_H_
+
+namespace iamf_tools {
+namespace api {
+
+/*!\brief Open-time behaviour knobs for `IamfStreamFactory::OpenFromBytes`.
+ *
+ * Lives in its own header so both the factory (which forwards a `Settings`
+ * argument) and the `IamfStream` impl (which reads it inside
+ * `OpenFromBytes`) can include it without forming a cyclic dependency.
+ * Exposed publicly as `IamfStreamFactory::Settings` via a `using`-alias on
+ * the factory class.
+ */
+struct IamfStreamSettings {
+  // When true, `OpenFromBytes` returns as soon as descriptor parsing and
+  // codec-pipeline initialisation are done, and runs the temporal-unit
+  // scan on a background thread. The scan is the bulk of open cost on
+  // large files (≈80 s on a 543 MB Opus IAMF) and is only needed for
+  // `Seek` and an exact `GetTotalSamples`; `NextTemporalUnit` does not
+  // need it. Trade-offs while the scan is in flight:
+  //   - `GetTotalSamples()` returns 0 and `IsTotalSamplesReady()` returns
+  //     false until the scan completes (or fails).
+  //   - `Seek()` blocks via `WaitForScanComplete(infinite)` before
+  //     binary-searching the index.
+  //   - `NextTemporalUnit()` is unaffected — it never consults the index.
+  // Default false for backwards compatibility.
+  bool lazy_temporal_unit_scan = false;
+};
+
+}  // namespace api
+}  // namespace iamf_tools
+
+#endif  // INCLUDE_IAMF_TOOLS_IAMF_STREAM_SETTINGS_H_
