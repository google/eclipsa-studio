+namespace iamf_tools {
+namespace api {
+
+namespace {
+/*!\brief Canonical EAR-order pack slots for a channel-based AE.
+ *
+ * Returns the final layer's channels in the canonical EAR order — the
+ * order every downstream renderer (and WAV convention) expects, with
+ * `kOmitted` entries of Expanded sub-layouts compressed away so the
+ * packed width equals the decoded channel count. Returns an empty
+ * vector when the layout has no EAR order or the width disagrees with
+ * `num_channels`; callers then keep the historical substream order
+ * rather than refusing to decode.
+ */
+std::vector<std::optional<ChannelLabel::Label>> CanonicalChannelSlots(
+    const AudioElementReport& probe_ae, size_t num_channels) {
+  if (!probe_ae.channel_layout_raw.has_value()) return {};
+  const auto layout = static_cast<ChannelAudioLayerConfig::LoudspeakerLayout>(
+      *probe_ae.channel_layout_raw);
+  std::optional<ChannelAudioLayerConfig::ExpandedLoudspeakerLayout> expanded;
+  if (probe_ae.expanded_channel_layout_raw.has_value()) {
+    expanded = static_cast<ChannelAudioLayerConfig::ExpandedLoudspeakerLayout>(
+        *probe_ae.expanded_channel_layout_raw);
+  }
+  const absl::StatusOr<std::vector<ChannelLabel::Label>> order =
+      ChannelLabel::LookupEarChannelOrderFromScalableLoudspeakerLayout(
+          layout, expanded);
+  if (!order.ok()) return {};
+  std::vector<std::optional<ChannelLabel::Label>> slots;
+  slots.reserve(order->size());
+  for (const ChannelLabel::Label label : *order) {
+    if (label == ChannelLabel::kOmitted) continue;
+    slots.emplace_back(label);
+  }
+  if (slots.size() != num_channels) return {};
+  return slots;
+}
+
+}  // namespace
+
+// `DescriptorFromProbeReport` (declared in iamf_stream_interface.h) is
+// defined in descriptor_from_probe_report.cc — a codec-free library — so
+// descriptors-only consumers can link the decode-capability judgement
+// without this decode pipeline.
+
+IamfStatus IamfStream::OpenFromBytes(const uint8_t* bytes, size_t len,
+                                     const IamfStreamSettings& settings,
+                                     std::unique_ptr<IamfStream>& out_stream) {
+  out_stream.reset();
+  if (bytes == nullptr || len == 0) {
+    return IamfStatus::ErrorStatus("invalid_argument: bytes must be non-empty");
+  }
+
+  // In eager mode the open-time `Probe` walks every TU. In lazy mode we
+  // skip the scan here — descriptors only — and re-`Probe` on a worker
+  // thread to populate `temporal_unit_scan`. The descriptor portion is
+  // ~10 ms even on huge inputs, so the duplicated work is negligible
+  // against the multi-tens-of-seconds scan it unblocks.
+  ProbeOptions options;
+  options.scan_mode = settings.lazy_temporal_unit_scan
+                          ? ScanMode::kDescriptorsOnly
+                          : ScanMode::kScanFull;
+  absl::StatusOr<ProbeReport> probe =
+      Probe(absl::MakeConstSpan(bytes, len), options);
+  if (!probe.ok()) {
+    return IamfStatus::ErrorStatus(
+        absl::StrCat("malformed: ", probe.status().message()));
+  }
+  // The TU-boundary heuristic in `ScanTemporalUnits` advances on
+  // substream-id repetition; a frame that fails to parse skips its
+  // substream registration and can silently merge two TUs into one in
+  // the seek index. Refuse to open a stream whose scan saw any parse
+  // failures — better a loud open-time rejection than wrong `Seek`
+  // arithmetic later. (Lazy mode runs the scan on a worker; that path
+  // applies the same check in `RunBackgroundScan`.)
+  if (options.scan_mode != ScanMode::kDescriptorsOnly &&
+      probe->temporal_unit_scan.has_value()) {
+    const auto& scan = *probe->temporal_unit_scan;
+    if (scan.audio_frame_parse_errors > 0 ||
+        scan.parameter_block_parse_errors > 0) {
+      return IamfStatus::ErrorStatus(absl::StrCat(
+          "malformed: probe registered ", scan.audio_frame_parse_errors,
+          " audio frame and ", scan.parameter_block_parse_errors,
+          " parameter block parse errors during temporal-unit scan"));
+    }
+  }
+
+  auto stream = absl::WrapUnique(new IamfStream());
+  stream->bytes_ = bytes;
+  stream->len_ = len;
+  stream->probe_report_ = *std::move(probe);
+  {
+    IamfStatus init = stream->InitDescriptorView();
+    if (!init.ok()) return init;
+  }
+  {
+    IamfStatus init = stream->InitDecodePipeline();
+    if (!init.ok()) return init;
+  }
+
+  if (settings.lazy_temporal_unit_scan) {
+    // Mark `kRunning` BEFORE spawning so any racing `IsScanComplete` poll
+    // never observes the eager-mode-default `kPending` after the worker is
+    // already in flight. The worker captures `this`; the dtor joins.
+    stream->scan_state_.store(ScanState::kRunning, std::memory_order_release);
+    IamfStream* raw = stream.get();
+    stream->scan_worker_ = std::thread([raw] { raw->RunBackgroundScan(); });
+  } else {
+    IamfStatus init = stream->ApplyTemporalUnitScan();
+    if (!init.ok()) return init;
+    stream->scan_state_.store(ScanState::kComplete, std::memory_order_release);
+  }
+  out_stream = std::move(stream);
+  return IamfStatus::OkStatus();
+}
+
+IamfStream::~IamfStream() {
+  if (scan_worker_.joinable()) {
+    // No cancellation hook in this phase — `Probe` runs to completion. The
+    // dtor's contract (per the threading docs) requires no other call to be
+    // in flight, so blocking here is no worse than blocking on `Seek`.
+    scan_worker_.join();
+  }
+}
+
+IamfStatus IamfStream::BuildProcessorPipeline() {
+  // Tear down any previous pipeline up-front. The `DemixingManager`'s
+  // `ReconstructionConfig` holds raw `AudioElementObu*` pointers into the old
+  // `ObuProcessor`'s descriptors; destroying the module before the processor
+  // avoids use-after-free if a later step fails and we bail out.
+  demixing_manager_.reset();
+  audio_frame_decoder_ = AudioFrameDecoder{};
+  obu_processor_.reset();
+  read_bit_buffer_.reset();
+
+  // Seed a memory-backed bit-buffer from the whole source span and let
+  // ObuProcessor parse descriptors. `is_exhaustive_and_exact = false` so
+  // the processor stops at the end of descriptors and leaves the TU bytes
+  // in the buffer. A memory-backed buffer is the right abstraction here:
+  // `OpenFromBytes`'s contract says the caller keeps `bytes_` alive for the
+  // stream's lifetime, and the stream-backed variant caps its source at
+  // 4 MB, which real-world exports routinely exceed.
+  read_bit_buffer_ = MemoryBasedReadBitBuffer::CreateFromSpan(
+      absl::MakeConstSpan(bytes_, len_));
+  if (read_bit_buffer_ == nullptr) {
+    return Fail("internal: failed to create read bit buffer");
+  }
+
+  bool insufficient_data = false;
+  obu_processor_ = ObuProcessor::Create(
+      /*is_exhaustive_and_exact=*/false, read_bit_buffer_.get(),
+      insufficient_data);
+  if (obu_processor_ == nullptr) {
+    return Fail(insufficient_data
+                    ? "io: truncated descriptor OBUs"
+                    : "malformed: failed to parse descriptor OBUs");
+  }
+
+  // Initialize per-substream codec decoders for every AE. Unsupported AEs
+  // are still initialised — `NextTemporalUnit` refuses to pump them — but
+  // `ObuProcessor::ProcessTemporalUnit` still parses their audio frames
+  // regardless, and `AudioFrameDecoder::Decode` would fail if the decoder
+  // weren't created.
+  const auto& audio_elements = obu_processor_->GetAudioElementsView();
+  for (const auto& [ae_id, ae_with_data] : audio_elements) {
+    if (ae_with_data.codec_config == nullptr) {
+      return Fail(absl::StrCat("malformed: audio element ", ae_id,
+                               " has no codec config"));
+    }
+    absl::Status init_status = audio_frame_decoder_.InitDecodersForSubstreams(
+        ae_with_data.substream_id_to_labels, *ae_with_data.codec_config);
+    if (!init_status.ok()) {
+      return Fail(absl::StrCat("unsupported: ", init_status.message()));
+    }
+  }
+
+  // Build the reconstruction-only DemixingManager (no down-mixing; caller is
+  // decoding, not encoding).
+  auto id_to_config =
+      DemixingManager::CreateIdToReconstructionConfig(audio_elements);
+  auto demixing_manager = DemixingManager::Create(id_to_config);
+  if (!demixing_manager.ok()) {
+    return Fail(
+        absl::StrCat("malformed: ", demixing_manager.status().message()));
+  }
+  demixing_manager_ =
+      std::make_unique<DemixingManager>(*std::move(demixing_manager));
+  return IamfStatus::OkStatus();
+}
+
+IamfStatus IamfStream::InitDecodePipeline() {
+  {
+    IamfStatus s = BuildProcessorPipeline();
+    if (!s.ok()) return s;
+  }
+  const auto& audio_elements = obu_processor_->GetAudioElementsView();
+
+  // Freeze a deterministic per-AE channel order for sample packing.
+  //
+  // Ambisonics-mono scene AEs get the full ACN grid: slot i is label A{i},
+  // or nullopt (zero-filled at pack time) when `channel_mapping` marks the
+  // ACN inactive (mixed-order ambisonics). Indexing by ACN keeps the packed
+  // width equal to the descriptor's `num_channels` and each SH channel at
+  // the position renderers expect, regardless of substream-id numbering.
+  //
+  // Channel-based AEs pack in the canonical EAR order of the final layer's
+  // layout — the order renderers and WAV conventions expect. The historical
+  // order (substream-id ascending, intra-substream label order) put coupled
+  // pairs first and pushed C/LFE to the end, silently permuting every
+  // C/LFE-bearing layout on the way out (e.g. 7.1.4 decoded as
+  // [L R Lss Rss Lrs Rrs Ltf Rtf Ltb Rtb C LFE]). Layouts without an EAR
+  // order keep the historical order rather than refusing to decode.
+  ae_channel_order_.reserve(probe_report_.audio_elements.size());
+  for (const auto& probe_ae : probe_report_.audio_elements) {
+    auto it = audio_elements.find(probe_ae.id);
+    if (it == audio_elements.end()) {
+      return Fail(
+          absl::StrCat("malformed: audio element ", probe_ae.id,
+                       " reported by probe not present in parsed descriptors"));
+    }
+    if (probe_ae.ambisonics.has_value() &&
+        probe_ae.ambisonics->mono.has_value()) {
+      const AmbisonicsMonoReport& mono = *probe_ae.ambisonics->mono;
+      std::vector<std::optional<ChannelLabel::Label>> slots(
+          mono.channel_mapping.size());
+      for (size_t acn = 0; acn < mono.channel_mapping.size(); ++acn) {
+        if (mono.channel_mapping[acn] ==
+            AmbisonicsMonoConfig::kInactiveAmbisonicsChannelNumber) {
+          continue;
+        }
+        absl::StatusOr<ChannelLabel::Label> label =
+            ChannelLabel::AmbisonicsChannelNumberToLabel(acn);
+        if (!label.ok()) {
+          return Fail(absl::StrCat("malformed: audio element ", probe_ae.id,
+                                   " maps unrepresentable ACN ", acn, ": ",
+                                   label.status().message()));
+        }
+        slots[acn] = *label;
+      }
+      ae_channel_order_.push_back(std::move(slots));
+      continue;
+    }
+    std::vector<std::optional<ChannelLabel::Label>> labels =
+        CanonicalChannelSlots(probe_ae, probe_ae.num_channels.value_or(0));
+    if (labels.empty()) {
+      const SubstreamIdLabelsMap& substream_map =
+          it->second.substream_id_to_labels;
+      std::vector<DecodedUleb128> substream_ids;
+      substream_ids.reserve(substream_map.size());
+      for (const auto& [sid, _] : substream_map) {
+        substream_ids.push_back(sid);
+      }
+      std::sort(substream_ids.begin(), substream_ids.end());
+      for (DecodedUleb128 sid : substream_ids) {
+        const auto& substream_labels = substream_map.at(sid);
+        labels.insert(labels.end(), substream_labels.begin(),
+                      substream_labels.end());
+      }
+    }
+    ae_channel_order_.push_back(std::move(labels));
+  }
+
+  // Extract per-AE element_mix_gain from the first mix presentation's first
+  // sub-mix. If the stream has multiple mix presentations or sub-mixes, Phase
+  // A picks the first; a `mix_presentation_id` setting comes in a later
+  // phase. A zero parameter_id acts as the sentinel for "no match found",
+  // which falls back to `ae_default_mix_gain_db_` unconditionally in
+  // NextTemporalUnit.
+  ae_mix_gain_parameter_id_.assign(audio_elements_.size(), 0);
+  ae_default_mix_gain_db_.assign(audio_elements_.size(), 0.0f);
+  const auto& mix_presentations = obu_processor_->GetMixPresentationObusView();
+  if (!mix_presentations.empty() &&
+      !mix_presentations.front().sub_mixes_.empty()) {
+    const auto& sub_mix = mix_presentations.front().sub_mixes_.front();
+    for (const auto& sub_mix_ae : sub_mix.audio_elements) {
+      for (size_t i = 0; i < audio_elements_.size(); ++i) {
+        if (audio_elements_[i].audio_element_id !=
+            sub_mix_ae.audio_element_id) {
+          continue;
+        }
+        ae_mix_gain_parameter_id_[i] =
+            sub_mix_ae.element_mix_gain.GetParameterId();
+        ae_default_mix_gain_db_[i] =
+            sub_mix_ae.element_mix_gain.default_mix_gain_.GetFloatingPoint();
+        break;
+      }
+    }
+  }
+
+  all_aes_supported_ = true;
+  for (const auto& ae : audio_elements_) {
+    if (!ae.supported) {
+      all_aes_supported_ = false;
+      break;
+    }
+  }
+  return IamfStatus::OkStatus();
+}
+
+IamfStatus IamfStream::InitDescriptorView() {
+  if (probe_report_.codec_configs.empty()) {
+    return Fail("malformed: no codec configs in descriptor OBUs");
+  }
+  if (probe_report_.audio_elements.empty()) {
+    return Fail("malformed: no audio elements in descriptor OBUs");
+  }
+  // Public index order is ascending `audio_element_id` (see
+  // `iamf_stream_interface.h`). `Probe` already sorts both lists, but the
+  // guarantee belongs to this class, so it is imposed here as well:
+  // `audio_elements_` (built below) and `ae_channel_order_` (built in
+  // `InitDecodePipeline`) are both indexed by position in
+  // `probe_report_.audio_elements`, so the sort has to happen before either.
+  std::sort(probe_report_.codec_configs.begin(),
+            probe_report_.codec_configs.end(),
+            [](const CodecConfigReport& a, const CodecConfigReport& b) {
+              return a.id < b.id;
+            });
+  std::sort(probe_report_.audio_elements.begin(),
+            probe_report_.audio_elements.end(),
+            [](const AudioElementReport& a, const AudioElementReport& b) {
+              return a.id < b.id;
+            });
+  // Sample rate and frame size come from the lowest-ID codec config.
+  const auto& codec = probe_report_.codec_configs.front();
+  sample_rate_ = codec.output_sample_rate;
+  frame_size_ = codec.num_samples_per_frame;
+
+  audio_elements_.reserve(probe_report_.audio_elements.size());
+  for (const auto& ae : probe_report_.audio_elements) {
+    audio_elements_.push_back(DescriptorFromProbeReport(ae));
+  }
+  return IamfStatus::OkStatus();
+}
+
+IamfStatus IamfStream::ApplyTemporalUnitScan() {
+  // Build the trimmed-timeline TU index: per-TU start position in the
+  // post-trim output timeline. The running total is the trimmed stream
+  // length. Non-Opus codecs (FLAC/LPCM) carry zero trim, so the trimmed
+  // and raw timelines coincide. Reset both fields on entry so a re-run
+  // (worker after lazy open) starts clean.
+  total_samples_ = 0;
+  trimmed_start_timestamps_.clear();
+  if (!probe_report_.temporal_unit_scan.has_value()) {
+    return IamfStatus::OkStatus();
+  }
+  const auto& tus = probe_report_.temporal_unit_scan->temporal_units;
+  trimmed_start_timestamps_.reserve(tus.size());
+  for (const auto& tu : tus) {
+    trimmed_start_timestamps_.push_back(total_samples_);
+    const uint64_t trim_total = uint64_t{tu.samples_to_trim_at_start} +
+                                uint64_t{tu.samples_to_trim_at_end};
+    // Over-trim in a malformed TU would underflow; clamp to zero rather
+    // than poison the whole stream on the theoretical edge case.
+    total_samples_ +=
+        tu.num_samples > trim_total ? tu.num_samples - trim_total : 0;
+  }
+  return IamfStatus::OkStatus();
+}
+
+void IamfStream::RunBackgroundScan() {
+  // Re-run the probe with the scan enabled. Descriptors are re-parsed too
+  // (~10 ms even on huge inputs); cheap relative to the multi-second TU
+  // walk. The scan has no shared mutable state with the foreground decode
+  // pipeline — both only read `bytes_`, which is immutable for the
+  // lifetime of the stream.
+  ProbeOptions options;
+  options.scan_mode = ScanMode::kScanFull;
+  absl::StatusOr<ProbeReport> probe =
+      Probe(absl::MakeConstSpan(bytes_, len_), options);
+
+  std::lock_guard<std::mutex> lock(mu_);
+  if (!probe.ok()) {
+    scan_error_message_ = absl::StrCat("malformed: ", probe.status().message());
+    scan_state_.store(ScanState::kFailed, std::memory_order_release);
+    cv_.notify_all();
+    return;
+  }
+  // Mirror the eager-mode parse-error gate from `OpenFromBytes`: any TU
+  // boundary the scanner missed corrupts the seek index, so refuse to
+  // surface the scan to foreground readers.
+  if (probe->temporal_unit_scan.has_value()) {
+    const auto& scan = *probe->temporal_unit_scan;
+    if (scan.audio_frame_parse_errors > 0 ||
+        scan.parameter_block_parse_errors > 0) {
+      scan_error_message_ = absl::StrCat(
+          "malformed: probe registered ", scan.audio_frame_parse_errors,
+          " audio frame and ", scan.parameter_block_parse_errors,
+          " parameter block parse errors during temporal-unit scan");
+      scan_state_.store(ScanState::kFailed, std::memory_order_release);
+      cv_.notify_all();
+      return;
+    }
+  }
+  // Swap in the temporal-unit scan. We deliberately do NOT replace the rest
+  // of `probe_report_`: descriptor-derived state (`audio_elements_`,
+  // `sample_rate_`, codec configs) was finalised on the foreground at open
+  // time and is what `IsTotalSamplesReady`-unaware getters return; rewriting
+  // the whole report would race those getters under the immutable-after-open
+  // contract. The foreground's descriptor parse and the worker's parse are
+  // deterministic on the same bytes, so the two views agree.
+  probe_report_.temporal_unit_scan = std::move(probe->temporal_unit_scan);
+  IamfStatus apply = ApplyTemporalUnitScan();
+  if (!apply.ok()) {
+    scan_error_message_ = std::string(apply.error_message);
+    scan_state_.store(ScanState::kFailed, std::memory_order_release);
+  } else {
+    scan_state_.store(ScanState::kComplete, std::memory_order_release);
+  }
+  cv_.notify_all();
+}
+
+IamfStatus IamfStream::Fail(std::string msg) {
+  last_error_ = std::move(msg);
+  return IamfStatus::ErrorStatus(last_error_);
+}
+
+uint32_t IamfStream::GetSampleRate() const { return sample_rate_; }
+uint32_t IamfStream::GetFrameSize() const { return frame_size_; }
+uint64_t IamfStream::GetTotalSamples() const {
+  // Acquire-load pairs with the worker's release-store of `kComplete` so
+  // the subsequent read of `total_samples_` happens-after the worker's
+  // write. Lock-free in the common case (eager mode, or lazy after the
+  // scan finished).
+  if (scan_state_.load(std::memory_order_acquire) != ScanState::kComplete) {
+    return 0;
+  }
+  return total_samples_;
+}
+bool IamfStream::IsTotalSamplesReady() const {
+  return scan_state_.load(std::memory_order_acquire) == ScanState::kComplete;
+}
+bool IamfStream::IsScanComplete() const {
+  const ScanState s = scan_state_.load(std::memory_order_acquire);
+  return s == ScanState::kComplete || s == ScanState::kFailed;
+}
+IamfStatus IamfStream::WaitForScanComplete(absl::Duration timeout) const {
+  std::unique_lock<std::mutex> lock(mu_);
+  // Predicate-based wait so spurious wakeups don't return early; the worker
+  // sets `scan_state_` to `kComplete`/`kFailed` under `mu_` then notifies.
+  auto done = [this] {
+    const ScanState s = scan_state_.load(std::memory_order_acquire);
+    return s == ScanState::kComplete || s == ScanState::kFailed;
+  };
+  if (timeout >= absl::InfiniteDuration()) {
+    cv_.wait(lock, done);
+  } else {
+    // `absl::Duration` → `std::chrono::nanoseconds` for `wait_for`; clamp
+    // negatives to zero so a stale deadline doesn't underflow.
+    const int64_t ns =
+        timeout > absl::ZeroDuration() ? absl::ToInt64Nanoseconds(timeout) : 0;
+    if (!cv_.wait_for(lock, std::chrono::nanoseconds(ns), done)) {
+      return IamfStatus::ErrorStatus(
+          "deadline_exceeded: temporal-unit scan still in flight");
+    }
+  }
+  if (scan_state_.load(std::memory_order_acquire) == ScanState::kFailed) {
+    return IamfStatus::ErrorStatus(scan_error_message_);
+  }
+  return IamfStatus::OkStatus();
+}
+uint32_t IamfStream::GetNumAudioElements() const {
+  return static_cast<uint32_t>(audio_elements_.size());
+}
+
+AudioElementDescriptor IamfStream::GetAudioElement(uint32_t index) const {
+  if (index >= audio_elements_.size()) {
+    return AudioElementDescriptor{};
+  }
+  return audio_elements_[index];
+}
+
+IamfStatus IamfStream::NextTemporalUnit(TemporalUnitOutput& out) {
+  if (poisoned_) {
+    return IamfStatus::ErrorStatus(last_error_);
+  }
+  if (!all_aes_supported_) {
+    poisoned_ = true;
+    return Fail(
+        "unsupported: stream contains an audio element this build cannot "
+        "decode");
+  }
+
+  // Outer loop drives past fully-trimmed TUs (e.g. an all-pre-skip Opus TU
+  // when pre_skip exceeds one frame_size — rare but legal). Each iteration
+  // consumes one raw TU; we return to the caller only on EOF or when a
+  // post-trim non-empty TU is ready.
+  while (true) {
+    // Empty the output regardless of outcome so callers do not see stale
+    // data on EOF / continue-paths.
+    out.frames_produced = 0;
+    out.samples_per_ae.clear();
+    out.mix_gain_db_per_ae.clear();
+
+    std::optional<ObuProcessor::OutputTemporalUnit> tu;
+    bool continue_processing = true;
+    absl::Status status = obu_processor_->ProcessTemporalUnit(
+        /*eos_is_end_of_sequence=*/true, tu, continue_processing);
+    if (!status.ok()) {
+      poisoned_ = true;
+      // A read that hit end-of-buffer mid-TU surfaces as ResourceExhausted
+      // (the bit-buffer's way of saying "not enough bytes"). Distinguish
+      // that from structurally-valid-but-undecodable input so callers can
+      // tell a truncated file from a mangled one.
+      const char* prefix = status.code() == absl::StatusCode::kResourceExhausted
+                               ? "io: "
+                               : "decode: ";
+      return Fail(absl::StrCat(prefix, status.message()));
+    }
+    if (!tu.has_value()) {
+      // `ObuProcessor` treats "cannot read a full next OBU" as ok+empty,
+      // so on the boundary we distinguish clean EOF (buffer drained) from
+      // mid-TU truncation (bytes remain but couldn't form a complete
+      // OBU). The latter is a real io failure that should poison the
+      // stream; the former is normal end-of-stream.
+      if (read_bit_buffer_ != nullptr &&
+          read_bit_buffer_->NumBytesAvailable() > 0) {
+        poisoned_ = true;
+        return Fail(absl::StrCat("io: truncated temporal unit — ",
+                                 read_bit_buffer_->NumBytesAvailable(),
+                                 " dangling bytes after last decodable OBU"));
+      }
+      last_error_.clear();
+      return IamfStatus::OkStatus();
+    }
+
+    // Trim is a TU-level property — every audio frame in a conformant IAMF
+    // TU carries identical values. Read once from the first frame's header
+    // and apply uniformly to every AE below.
+    uint32_t trim_at_start = 0;
+    uint32_t trim_at_end = 0;
+    if (!tu->output_audio_frames.empty()) {
+      const auto& first = tu->output_audio_frames.front();
+      trim_at_start =
+          static_cast<uint32_t>(first.obu.header_.num_samples_to_trim_at_start);
+      trim_at_end =
+          static_cast<uint32_t>(first.obu.header_.num_samples_to_trim_at_end);
+    }
+
+    // Decode each audio frame in place.
+    for (auto& frame : tu->output_audio_frames) {
+      absl::Status decode_status = audio_frame_decoder_.Decode(frame);
+      if (!decode_status.ok()) {
+        poisoned_ = true;
+        return Fail(absl::StrCat("decode: ", decode_status.message()));
+      }
+    }
+
+    // Demix each audio element.
+    absl::StatusOr<IdLabeledFrameMap> demixed =
+        demixing_manager_->DemixDecodedAudioSamples(tu->output_audio_frames);
+    if (!demixed.ok()) {
+      poisoned_ = true;
+      return Fail(absl::StrCat("decode: ", demixed.status().message()));
+    }
+
+    // Pack per-AE samples in the pre-computed channel order.
+    const size_t num_aes = audio_elements_.size();
+    out.samples_per_ae.resize(num_aes);
+    out.mix_gain_db_per_ae.assign(ae_default_mix_gain_db_.begin(),
+                                  ae_default_mix_gain_db_.end());
+
+    // Resolve per-AE element mix gain at the TU start timestamp. Walk the
+    // TU's parameter blocks; for each match on parameter_id, find the
+    // subblock containing `tu_start` and interpolate. Gain is sampled at
+    // the raw TU start — trim does not shift the sampling point (the TU
+    // header's trim is a presentation concern, not a parameter-timing
+    // concern).
+    const InternalTimestamp tu_start = tu->output_timestamp;
+    for (size_t i = 0; i < num_aes; ++i) {
+      const uint32_t target_id = ae_mix_gain_parameter_id_[i];
+      if (target_id == 0) continue;
+      for (const auto& pb : tu->output_parameter_blocks) {
+        if (pb.obu == nullptr) continue;
+        if (pb.obu->parameter_id_ != target_id) continue;
+        if (tu_start < pb.start_timestamp || tu_start >= pb.end_timestamp) {
+          continue;
+        }
+        InternalTimestamp cursor = pb.start_timestamp;
+        for (size_t si = 0; si < pb.obu->subblocks_.size(); ++si) {
+          absl::StatusOr<DecodedUleb128> dur =
+              pb.obu->GetSubblockDuration(static_cast<int>(si));
+          if (!dur.ok()) {
+            // Subblock duration that failed validation means the descriptor
+            // parser accepted a block the inner parser now rejects — the
+            // stream is structurally broken, not just under-specified.
+            poisoned_ = true;
+            return Fail(absl::StrCat(
+                "decode: parameter block ", target_id,
+                " has malformed subblock duration: ", dur.status().message()));
+          }
+          const InternalTimestamp sub_end =
+              cursor + static_cast<InternalTimestamp>(*dur);
+          if (tu_start >= cursor && tu_start < sub_end) {
+            const auto* mix_data = dynamic_cast<const MixGainParameterData*>(
+                pb.obu->subblocks_[si].get());
+            if (mix_data != nullptr) {
+              float gain_db = ae_default_mix_gain_db_[i];
+              absl::Status s =
+                  ParameterBlockObu::InterpolateMixGainParameterData(
+                      mix_data, cursor, sub_end, tu_start, gain_db);
+              if (!s.ok()) {
+                poisoned_ = true;
+                return Fail(absl::StrCat(
+                    "decode: mix gain interpolation failed for parameter "
+                    "block ",
+                    target_id, ": ", s.message()));
+              }
+              out.mix_gain_db_per_ae[i] = gain_db;
+            }
+            break;
+          }
+          cursor = sub_end;
+        }
+        break;
+      }
+    }
+
+    uint32_t raw_frame_count = 0;
+    for (size_t i = 0; i < num_aes; ++i) {
+      const DecodedUleb128 ae_id = audio_elements_[i].audio_element_id;
+      auto it = demixed->find(ae_id);
+      if (it == demixed->end()) {
+        poisoned_ = true;
+        return Fail(absl::StrCat(
+            "decode: demixed output missing audio element ", ae_id));
+      }
+      const LabeledFrame& labeled = it->second;
+      const std::vector<std::optional<ChannelLabel::Label>>& labels =
+          ae_channel_order_[i];
+      if (labels.empty()) {
+        poisoned_ = true;
+        return Fail(absl::StrCat("decode: audio element ", ae_id,
+                                 " has no channel labels in the cached order"));
+      }
+
+      // Look up one sample span per channel; all present channels must
+      // exist and have the same length. A reconstructed higher-layer
+      // channel lives under its demixed twin (e.g. kL5 arrives as
+      // kDemixedL5 for a stereo-base 5.1), which
+      // `FindSamplesOrDemixedSamples` resolves. Inactive slots
+      // (mixed-order ambisonics ACNs with no substream) carry an empty
+      // span and are zero-filled below.
+      std::vector<absl::Span<const InternalSampleType>> per_channel;
+      per_channel.reserve(labels.size());
+      size_t frame_count = 0;
+      bool have_frame_count = false;
+      for (const std::optional<ChannelLabel::Label>& label : labels) {
+        if (!label.has_value()) {
+          per_channel.push_back({});
+          continue;
+        }
+        absl::Span<const InternalSampleType> samples;
+        if (!FindSamplesOrDemixedSamples(*label, labeled.label_to_samples,
+                                         samples)
+                 .ok()) {
+          poisoned_ = true;
+          return Fail(absl::StrCat(
+              "decode: demixed output missing channel label for audio "
+              "element ",
+              ae_id));
+        }
+        if (!have_frame_count) {
+          frame_count = samples.size();
+          have_frame_count = true;
+        } else if (samples.size() != frame_count) {
+          poisoned_ = true;
+          return Fail(
+              absl::StrCat("decode: demixed channels for audio element ", ae_id,
+                           " have mismatched sample counts"));
+        }
+        per_channel.push_back(samples);
+      }
+      if (!have_frame_count) {
+        poisoned_ = true;
+        return Fail(absl::StrCat("decode: audio element ", ae_id,
+                                 " has no active channels in the cached "
+                                 "order"));
+      }
+
+      if (raw_frame_count == 0) {
+        raw_frame_count = static_cast<uint32_t>(frame_count);
+      } else if (static_cast<uint32_t>(frame_count) != raw_frame_count) {
+        poisoned_ = true;
+        return Fail(
+            "decode: audio elements produced different frame counts "
+            "within one temporal unit");
+      }
+
+      // Clamp trim to the raw frame count so a misbehaving header can't
+      // drive the slice beyond the decoded buffer.
+      const uint32_t effective_trim_start =
+          std::min(trim_at_start, raw_frame_count);
+      const uint32_t effective_trim_end =
+          std::min(trim_at_end, raw_frame_count - effective_trim_start);
+      const uint32_t post_trim_count =
+          raw_frame_count - effective_trim_start - effective_trim_end;
+
+      std::vector<float>& interleaved = out.samples_per_ae[i];
+      interleaved.resize(static_cast<size_t>(post_trim_count) * labels.size());
+      for (size_t f = 0; f < post_trim_count; ++f) {
+        for (size_t c = 0; c < labels.size(); ++c) {
+          interleaved[f * labels.size() + c] =
+              per_channel[c].empty()
+                  ? 0.0f
+                  : static_cast<float>(
+                        per_channel[c][f + effective_trim_start]);
+        }
+      }
+    }
+
+    // Compute post-trim frame count after the per-AE loop. Safe against
+    // under-/over-trim: the per-AE loop already clamped and all AEs share
+    // the same raw_frame_count + trim values in a conformant stream.
+    const uint32_t effective_trim_start =
+        std::min(trim_at_start, raw_frame_count);
+    const uint32_t effective_trim_end =
+        std::min(trim_at_end, raw_frame_count - effective_trim_start);
+    const uint32_t post_trim_count =
+        raw_frame_count - effective_trim_start - effective_trim_end;
+
+    if (post_trim_count == 0) {
+      // This TU was fully trimmed (e.g. an Opus pre-skip region larger than
+      // one frame). Move to the next TU so the caller never sees an empty
+      // non-EOF output.
+      continue;
+    }
+
+    out.frames_produced = post_trim_count;
+    last_error_.clear();
+    return IamfStatus::OkStatus();
+  }
+}
+
+IamfStatus IamfStream::Seek(uint64_t sample_pos) {
+  // Early guards. Neither path mutates pipeline state, so a rejected seek
+  // leaves pumping behaviour unchanged.
+  if (!all_aes_supported_) {
+    return Fail(
+        "unsupported: Seek refused — stream contains an audio element this "
+        "build cannot decode");
+  }
+  // Lazy mode: the temporal-unit index is built on a worker thread. Block
+  // here until it's published. Eager mode is no-op-fast (state is already
+  // `kComplete` before `OpenFromBytes` returns). The wait surfaces the
+  // worker's own failure status if the scan failed.
+  {
+    IamfStatus wait = WaitForScanComplete(absl::InfiniteDuration());
+    if (!wait.ok()) return Fail(std::string(wait.error_message));
+  }
+  if (!probe_report_.temporal_unit_scan.has_value() ||
+      probe_report_.temporal_unit_scan->temporal_units.empty()) {
+    return Fail("internal: temporal-unit index missing from probe report");
+  }
+  const auto& tus = probe_report_.temporal_unit_scan->temporal_units;
+  if (trimmed_start_timestamps_.size() != tus.size()) {
+    return Fail("internal: trimmed-timeline cache out of sync with probe");
+  }
+  if (total_samples_ > 0 && sample_pos >= total_samples_) {
+    return Fail(absl::StrCat("invalid_argument: sample position ", sample_pos,
+                             " beyond end-of-stream (", total_samples_, ")"));
+  }
+
+  // Binary-search the trimmed-timeline index. `Seek` receives sample_pos in
+  // the same (post-pre-skip, pre-end-trim) timeline that `GetTotalSamples`
+  // and `NextTemporalUnit` expose, so `Seek(0)` lands at the first
+  // deliverable sample. `upper_bound` gives the first TU whose trimmed
+  // start is strictly greater than `sample_pos`; step back one to get the
+  // containing TU.
+  auto it = std::upper_bound(trimmed_start_timestamps_.begin(),
+                             trimmed_start_timestamps_.end(), sample_pos);
+  if (it == trimmed_start_timestamps_.begin()) {
+    return Fail(absl::StrCat(
+        "internal: temporal-unit index is missing a TU covering sample ",
+        sample_pos));
+  }
+  size_t entry_index =
+      static_cast<size_t>(std::prev(it) - trimmed_start_timestamps_.begin());
+  // Fully-trimmed TUs (an Opus pre-skip region spanning whole frames) have
+  // zero width on the trimmed timeline, so the containing TU may be preceded
+  // by empty TUs sharing its trimmed start. Land on the earliest of them:
+  // decoding through the trimmed region warms the codec exactly like a fresh
+  // open, keeping `Seek(0)` byte-identical to open-and-pump. (`Pump` already
+  // skips fully-trimmed TUs, so the caller sees no extra output.)
+  while (entry_index > 0 && trimmed_start_timestamps_[entry_index - 1] ==
+                                trimmed_start_timestamps_[entry_index]) {
+    --entry_index;
+  }
+  const TemporalUnitEntry& entry = tus[entry_index];
+
+  IamfStatus rebuild = BuildProcessorPipeline();
+  if (!rebuild.ok()) return rebuild;
+
+  const int64_t target_bits =
+      (static_cast<int64_t>(probe_report_.descriptor_bytes_consumed) +
+       static_cast<int64_t>(entry.byte_offset_from_scan_start)) *
+      8;
+  absl::Status seek_status = read_bit_buffer_->Seek(target_bits);
+  if (!seek_status.ok()) {
+    // The buffer holds the entire stream, so a seek failure here means the
+    // probe index disagrees with the bitstream — treat as corruption.
+    return Fail(absl::StrCat("malformed: seek to TU byte offset failed: ",
+                             seek_status.message()));
+  }
+
+  poisoned_ = false;
+  last_error_.clear();
+  return IamfStatus::OkStatus();
+}
+
+const char* IamfStream::GetLastError() const { return last_error_.c_str(); }
+
+}  // namespace api
+}  // namespace iamf_tools
