load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "meter_state",
    hdrs = ["meter_state.h"],
)

cc_library(
    name = "peak_meter",
    hdrs = ["peak_meter.h"],
    srcs = ["peak_meter.cc"],
    deps = [
        ":meter_state",
        "//graph:audio_buffer",
    ],
)

cc_library(
    name = "rms_meter",
    hdrs = ["rms_meter.h"],
    srcs = ["rms_meter.cc"],
    deps = [
        ":meter_state",
        "//graph:audio_buffer",
    ],
)

cc_library(
    name = "channel_stats",
    hdrs = ["channel_stats.h"],
    srcs = ["channel_stats.cc"],
    deps = [
        ":meter_state",
        "//graph:audio_buffer",
    ],
)

cc_library(
    name = "bs1770_weights",
    hdrs = ["bs1770_weights.h"],
    srcs = ["bs1770_weights.cc"],
)

cc_library(
    name = "loudness_meter",
    hdrs = ["loudness_meter.h"],
    srcs = ["loudness_meter.cc"],
    deps = [
        ":bs1770_weights",
        ":meter_state",
        "//:engine_log",
        "//graph:audio_buffer",
        "@loudness_ebur128//:ebur128_analyzer",
    ],
)

cc_library(
    name = "live_loudness_meter",
    hdrs = ["live_loudness_meter.h"],
    srcs = ["live_loudness_meter.cc"],
    deps = [
        ":loudness_meter",
        ":meter_state",
        "//:engine_log",
        "//graph:audio_buffer",
    ],
)

cc_library(
    name = "meters",
    deps = [
        ":bs1770_weights",
        ":meter_state",
        ":peak_meter",
        ":rms_meter",
        ":loudness_meter",
        ":live_loudness_meter",
        ":channel_stats",
    ],
)
