load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

# Subcommand implementations, separated from main() for unit testing
# (//test:cli_commands_test).
cc_library(
    name = "cli_commands",
    srcs = ["cli_commands.cc"],
    hdrs = ["cli_commands.h"],
    deps = [
        "//bounce:element_bouncer",
        "//iamf:iamf_exporter",
        "//iamf:iamf_probe_ffi",
        "//io:wav_reader",
        "//mix_renderer:offline_mix_renderer",
    ],
)

# Headless render/export CLI (issue ES-39 proposal 1):
#   eclipsa_studio_cli bounce  <in.wav> <out.wav> [--gain-db G] [--routing ...]
#   eclipsa_studio_cli measure <mix.wav> --layout stereo
#   eclipsa_studio_cli encode  <config.textproto> --wav-dir D --out-dir O
#   eclipsa_studio_cli probe   <file.iamf> [--json]
cc_binary(
    name = "eclipsa_studio_cli",
    srcs = ["eclipsa_studio_cli.cc"],
    deps = [":cli_commands"],
)
