        "$value": "#AA83F6",
        "$description": "primary accent"
      },
      "pink": {
        "$type": "color",
        "$value": "#E06090",
        "$description": "secondary accent: the brand pink. The S on the cube, \"Studio\" in the wordmark, the playhead, the play triangle, the drop-zone music icon and the scrollbar thumb. 5.66:1 on bgBase, 4.55:1 on chromeBg"
