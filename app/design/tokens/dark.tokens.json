      "bgDeep": {
        "$type": "color",
        "$value": "#0D0D10",
        "$description": "deepest (timeline, 3D scene)"
      },
      "bgBase": {
        "$type": "color",
        "$value": "#101010",
        "$description": "panels, sidebars"
      },
      "landingGroundTop": {
        "$type": "color",
        "$value": "#101010",
        "$description": "landing screen ground, top edge"
      },
      "landingGroundBottom": {
        "$type": "color",
        "$value": "#101010",
        "$description": "landing screen ground, bottom edge"
      },
      "bgSurface": {
        "$type": "color",
        "$value": "#16181B",
        "$description": "cards, elevated panels"
      },
      "bgElevated": {
        "$type": "color",
        "$value": "#1B1A1C",
        "$description": "dialogs, popovers"
      },
      "bgHover": {
