        "$value": "#C4A0FF"
      },
      "pink": {
        "$type": "color",
        "$value": "#ED6C9C",
        "$description": "secondary accent: the brand pink, a step lighter for the high-contrast floor. The S on the cube and \"Studio\" in the wordmark. 7.23:1 on black"
      },
      "purpleLight": {
        "$type": "color",
        "$value": "#D9C2FF"
      },
      "purpleDim": {
        "$type": "color",
        "$value": "#C4A0FF33",
        "$description": "HC accents are light pastels — dark text keeps the label legible (white"
