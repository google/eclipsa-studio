    "background": {
      "bgDeep": {
        "$type": "color",
        "$value": "#000000"
      },
      "bgBase": {
        "$type": "color",
        "$value": "#000000"
      },
      "landingGroundTop": {
        "$type": "color",
        "$value": "#000000",
        "$description": "landing screen ground, top edge"
      },
      "landingGroundBottom": {
        "$type": "color",
        "$value": "#000000",
        "$description": "landing screen ground, bottom edge"
      },
      "bgSurface": {
        "$type": "color",
        "$value": "#0A0A0A"
      },
      "bgElevated": {
        "$type": "color",
        "$value": "#121212"
      },
      "bgHover": {
        "$type": "color",
        "$value": "#1F1F1F"
      },
      "bgControls": {
        "$type": "color",
        "$value": "#000000"
      }
    },
    "border": {
