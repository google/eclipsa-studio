        "$type": "color",
        "$value": "#4ADE80"
      },
      "typeChannel": {
        "$type": "color",
        "$value": "#FBBF24"
      },
      "typeScene": {
        "$type": "color",
        "$value": "#A5B4FC"
      }
    },
    "object3d": {
      "objCyan": {
        "$type": "color",
        "$value": "#67E8F9"
      },
      "objGreen": {
        "$type": "color",
        "$value": "#6EE7B7"
      },
      "objAmber": {
        "$type": "color",
        "$value": "#FDE68A"
