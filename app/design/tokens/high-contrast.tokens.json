      "$value": 2.0,
      "$description": "hairline width used by the decoration builders"
    },
    "knobStyle": {
      "$type": "knobStyle",
      "$value": "outlined",
      "$description": "which knob drawing this theme uses"
    },
    "chromeStyle": {
      "$type": "chromeStyle",
      "$value": "outlined",
      "$description": "which top chrome this theme draws"
    },
    "controlStyle": {
      "$type": "controlStyle",
      "$value": "outlined",
      "$description": "which dropdown control this theme draws"
    },
    "cardStyle": {
      "$type": "cardStyle",
